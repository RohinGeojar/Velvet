
<% if (showOtpModal) { %>
  <%- include('../partials/user/otpModal') %>
<% } %>
<!-- Main Section -->
<div class="grid grid-cols-1 ml-[180px] lg:grid-cols-2 min-h-[90vh]">

  <!-- Left Image -->
  <div class="hidden lg:flex items-center justify-center p-10">
    <img src="/images/Frame 26086866.png"
         class="w-full max-w-md object-cover rounded-lg shadow">
  </div>

  <!-- Form Section -->
  <div class="flex flex-col justify-center px-6 sm:px-12 lg:px-20 py-10">

    <h2 class="text-2xl sm:text-3xl font-semibold mb-8 text-center lg:text-left">
      Create Account
    </h2>
    <% if (error) { %>
      <p class="bg-red-100 text-md  mb-4  text-red-700 text-center space-y-4 max-w-md mx-auto lg:mx-0"><%-error %></p>
        <% } %>

    <form action="/register" method="POST" class="space-y-4 max-w-md mx-auto lg:mx-0">

      <input type="text" name="firstName" placeholder="First Name " required pattern="[A-Za-z\s]+" minlength="3"
        class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">

      <input type="text" name="lastName" placeholder="Last Name" pattern="[A-Za-z\s]+" 
        class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">

      <input type="email" name="email" placeholder="Email" required pattern="[^\s@]+@[^\s@]+\.[^\s@]+$"
        class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">

      <!-- Password -->
      <div class="relative">
        <input type="password" id="password" name="password" placeholder="Password" required minlength="6"
          class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
        <span onclick="togglePassword('password', this)"
              class="absolute right-3 top-3 cursor-pointer">👁</span>
      </div>

      <!-- Confirm Password -->
      <div class="relative">
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" required minlength="6"
          class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
        <span onclick="togglePassword('confirmPassword', this)"
              class="absolute right-3 top-3 cursor-pointer">👁</span>
      </div>

      <button type="submit"
        class="w-full bg-primary text-white py-3 rounded bg-[#4c5c49] transition">
        Register Now
      </button>

    </form>

    <!-- Login -->
    <p class="text-sm mt-4  text-start">
      Already Have An Account?
      <a href="/login" class="text-primary font-medium">Log In</a>
    </p>

       <div class="space-y-4 max-w-md mx-auto lg:mx-0 text-center my-4 text-gray-400">Or</div>


    <!-- Google -->
    <div class="flex justify-center space-y-4 max-w-md mx-auto lg:mx-0 ">
           <a href="/auth/google"> <button class="border p-3 rounded-full hover:bg-gray-100 transition ">
              <img src="/images/Google__G__logo.svg.webp" class="w-6 h-6  ">
            </button></a>
          </div>

    <!-- Terms -->
    <p class="text-xs text-gray-500 text-start mt-6 px-4">
      By Clicking Register Now you Agree To
      <span class="underline">Terms & Conditions</span>
      And
      <span class="underline">Privacy Policy</span>
    </p>

  </div>
</div>

<!-- Script -->
<script>
  function togglePassword(id, el) {
    const input = document.getElementById(id);
    if (input.type === "password") {
      input.type = "text";
      el.textContent = "🙈";
    } else {
      input.type = "password";
      el.textContent = "👁";
    }
  }
</script>