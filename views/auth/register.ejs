<%- include('../partials/user/otpModal') %>
  <!-- Main Section -->
  <div class="grid grid-cols-1 ml-[180px] lg:grid-cols-2 min-h-[90vh]">

    <!-- Left Image -->
    <div class="hidden lg:flex items-start justify-center p-10 sticky top-0 self-start">
      <img src="/images/Frame 26086866.png" class="w-full max-w-md object-cover rounded-lg shadow">
    </div>

    <!-- Form Section -->
    <div class="flex flex-col justify-center px-6 sm:px-12 lg:px-20 py-10">

      <h2 class="text-2xl sm:text-3xl font-semibold mb-8 text-center lg:text-left">
        Create Account
      </h2>


      <form id="signupForm" method="POST" class="space-y-4 max-w-md mx-auto lg:mx-0">

        <div>
          <input type="text" name="firstName" placeholder="First Name " minlength="3"
            class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
        </div>

        <div>
          <input type="text" name="lastName" placeholder="Last Name"
            class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
        </div>

        <div>
          <input type="email" name="email" placeholder="Email" pattern="[^\s@]+@[^\s@]+\.[^\s@]+$"
            class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
        </div>

        <!-- Password -->
        <div class="relative">
          <input type="password" id="password" name="password" placeholder="Password" minlength="6"
            class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
          <span onclick="togglePassword('password', this)" class="absolute right-3 top-3 cursor-pointer">👁</span>
        </div>

        <!-- Confirm Password -->
        <div class="relative">
          <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password"
            minlength="6" class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">
          <span onclick="togglePassword('confirmPassword', this)"
            class="absolute right-3 top-3 cursor-pointer">👁</span>
        </div>
        <div>


          <input type="text" id="referralCode" name="referralCode"
            value="<%= typeof referralCode !== 'undefined' ? referralCode : '' %>"
            placeholder="Enter referral code (optional)" class="w-full mt-2 px-4 py-3 border rounded-lg ">
        </div>

        <button type="submit" id="registerBtn"
          class="w-full bg-primary text-white py-3 rounded bg-[#4c5c49] transition">
          Register Now
        </button>

      </form>

      <!-- Login -->
      <p class="text-sm mt-4  text-start">
        Already Have An Account?
        <a href="/login" class="text-primary font-medium">Log In</a>
      </p>

      <div class="space-y-4 max-w-md mx-auto lg:mx-0 text-center my-4 text-gray-400">Or</div>


      <!-- Google -->
      <div class="flex justify-center space-y-4 max-w-md mx-auto lg:mx-0 ">
        <a href="/auth/google<%= referralCode ? '?ref=' + encodeURIComponent(referralCode) : '' %>">
          <button class="border p-3 rounded-full hover:bg-gray-100 transition ">
            <img src="/images/Google__G__logo.svg.webp" class="w-6 h-6  ">
          </button></a>
      </div>

      <!-- Terms -->
      <p class="text-xs text-gray-500 text-start mt-6 px-4">
        By Clicking Register Now you Agree To
        <span class="underline">Terms & Conditions</span>
        And
        <span class="underline">Privacy Policy</span>
      </p>

    </div>
  </div>

  <!-- Script -->
  <script>
    const form = document.getElementById("signupForm");

    // Inputs
    const firstNameInput = document.querySelector('input[name="firstName"]');
    const lastNameInput = document.querySelector('input[name="lastName"]');
    const emailInput = document.querySelector('input[name="email"]');
    const passwordInput = document.querySelector('input[name="password"]');
    const confirmPasswordInput = document.querySelector('input[name="confirmPassword"]');
    const referralCodeInput = document.querySelector('input[name="referralCode"]');
    const registerBtn = document.getElementById("registerBtn");

    // Regex
    const nameRegex = /^[A-Za-z]+(?:\s[A-Za-z]+)*$/;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    // ---------------- ERROR HANDLING ----------------

    function showFieldError(input, message) {

      let error = input.parentElement.querySelector(".field-error");

      if (!error) {
        error = document.createElement("p");
        error.className = "field-error text-red-500 text-sm mt-1";
        input.parentElement.appendChild(error);
      }

      error.textContent = message;
      input.classList.add("border-red-500");
    }

    function clearFieldError(input) {

      const error = input.parentElement.querySelector(".field-error");

      if (error) {
        error.remove();
      }

      input.classList.remove("border-red-500");
    }

    // ---------------- VALIDATION ----------------

    function validateFirstName() {

      const value = firstNameInput.value.trim();

      clearFieldError(firstNameInput);

      if (!value) {
        showFieldError(firstNameInput, "First name is required");
        return false;
      }

      if (value.length < 3) {
        showFieldError(firstNameInput, "Minimum 3 characters");
        return false;
      }

      if (!nameRegex.test(value)) {
        showFieldError(firstNameInput, "Only letters are allowed");
        return false;
      }

      return true;
    }

    function validateLastName() {

      const value = lastNameInput.value.trim();

      clearFieldError(lastNameInput);

      if (!value) {
        showFieldError(lastNameInput, "Last name is required");
        return false;
      }

      if (!nameRegex.test(value)) {
        showFieldError(lastNameInput, "Only letters are allowed");
        return false;
      }

      return true;
    }

    function validateEmail() {

      const value = emailInput.value.trim();

      clearFieldError(emailInput);

      if (!value) {
        showFieldError(emailInput, "Email is required");
        return false;
      }

      if (!emailRegex.test(value)) {
        showFieldError(emailInput, "Invalid email format");
        return false;
      }

      return true;
    }

    function validatePassword() {

      const value = passwordInput.value;

      clearFieldError(passwordInput);

      if (!value) {
        showFieldError(passwordInput, "Password is required");
        return false;
      }

      if (value.length < 6) {
        showFieldError(passwordInput, "Password must be at least 6 characters");
        return false;
      }

      return true;
    }

    function validateConfirmPassword() {

      const value = confirmPasswordInput.value;

      clearFieldError(confirmPasswordInput);

      if (!value) {
        showFieldError(confirmPasswordInput, "Confirm your password");
        return false;
      }

      if (value !== passwordInput.value) {
        showFieldError(confirmPasswordInput, "Passwords do not match");
        return false;
      }

      return true;
    }

    function validateForm() {

      const firstNameValid = validateFirstName();
      const lastNameValid = validateLastName();
      const emailValid = validateEmail();
      const passwordValid = validatePassword();
      const confirmPasswordValid = validateConfirmPassword();

      return (
        firstNameValid &&
        lastNameValid &&
        emailValid &&
        passwordValid &&
        confirmPasswordValid
      );
    }

    // ---------------- LIVE VALIDATION ----------------

    firstNameInput.addEventListener("input", validateFirstName);

    lastNameInput.addEventListener("input", validateLastName);

    emailInput.addEventListener("input", validateEmail);

    passwordInput.addEventListener("input", () => {
      validatePassword();
      validateConfirmPassword();
    });

    confirmPasswordInput.addEventListener("input", validateConfirmPassword);

    // ---------------- SUBMIT ----------------

    form.addEventListener("submit", async (e) => {

      e.preventDefault();

      if (!validateForm()) return;

      const data = {
        firstName: firstNameInput.value.trim(),
        lastName: lastNameInput.value.trim(),
        email: emailInput.value.trim(),
        password: passwordInput.value,
        confirmPassword: confirmPasswordInput.value,
        referralCode: referralCodeInput.value.trim().toUpperCase()
      };

      try {

        document.getElementById("otpModal").classList.remove("hidden");
        document.getElementById("otpEmail").textContent = data.email;

        showToast("Sending OTP...", "success");

        openOtpModal(data.email, "/verifyOtp", "signup");


        const res = await fetch("/register", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (!res.ok) {

          document.getElementById("otpModal").classList.add("hidden");

          showToast(result.message || "Signup failed", "error");

          if (result.message?.toLowerCase().includes("email")) {
            showFieldError(emailInput, result.message);
          }

          return;
        }

        showToast(`OTP has been sent to ${result.email}`, "success");

      } catch (err) {

        console.error(err);

        showToast("Something went wrong", "error");
      }
    });

    // ---------------- TOAST ----------------

    function showToast(message, type = "success") {

      const toast = document.createElement("div");

      toast.className = `
        fixed top-5 left-1/2 -translate-x-1/2
        px-4 py-2 rounded text-white z-50 shadow-lg
        ${type === "error" ? "bg-red-500" : "bg-green-600"}
    `;

      toast.innerText = message;

      document.body.appendChild(toast);

      setTimeout(() => {
        toast.remove();
      }, 3000);
    }

    // ---------------- PASSWORD TOGGLE ----------------

    function togglePassword(id, el) {

      const input = document.getElementById(id);

      if (input.type === "password") {
        input.type = "text";
        el.textContent = "🙈";
      } else {
        input.type = "password";
        el.textContent = "👁";
      }
    }
  </script>