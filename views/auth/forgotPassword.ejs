<%- include('../partials/user/otpModal') %>
  <!-- Main Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 min-h-[90vh]">

    <!-- Left Image -->
    <div class="hidden lg:flex items-center justify-center p-10">
      <img src="/images/Frame 26086866.png" class="w-full max-w-md object-cover rounded-lg shadow">
    </div>

    <!-- Form Section -->
    <div class="flex flex-col justify-center px-6 sm:px-12 lg:px-20 py-10">

      <h2 class="text-2xl sm:text-3xl font-semibold mb-8 text-center lg:text-left">
        Forgot Password
      </h2>
      <% if (typeof error !=="undefined" && error) { %>
        <p class="bg-red-100 text-red-700 text-center">
          <%= error %>
        </p>
        <% } %>
          <form  id="forgotForm" action="/forgotPassword" method="POST" class="space-y-4 max-w-md mx-auto lg:mx-0">

            <p class="text-primary font-medium">Enter your registerd Email</p>

            <input type="email" name="email" placeholder="Email" required
              class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">

            <!-- Password -->




            <button type="submit" class="w-full bg-primary text-white py-3 rounded bg-[#4c5c49] transition">
              Request OTP
            </button>

          </form>
          <div id="toast" class="fixed top-6 right-6 opacity-0 transition-all"></div>
          <!-- Login -->




    </div>
  </div>
  <script>
    document.addEventListener("DOMContentLoaded", () => {

  const form = document.getElementById("forgotForm");

  if (!form) {
    console.log("Form not found ");
    return;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault(); 

    console.log("AJAX WORKING ✅");
     showToast("Sending OTP...", "success")
    const formData = new FormData(form);
    const body = Object.fromEntries(formData.entries());

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });

      const data = await res.json();

  
      if (!res.ok) {
        showToast(data.message || "Something went wrong");
        return;
      }


      if (data.requireOtp) {
        showToast("OTP sent successfully", "success");

        openOtpModal(body.email, "/verifyForgotOtp", "forgot");
        return;
      }

    } catch (err) {
      console.log("FETCH ERROR:", err);
      showToast("Server error");
    }
  });

});
    function showToast(message, type = "error") {
      const toast = document.getElementById("toast");

      toast.innerText = message;

      toast.className =
        "fixed top-6 right-6 px-4 py-3 rounded shadow z-50 transition " +
        (type === "error" ? "bg-red-500 text-white" : "bg-green-500 text-white");

      toast.classList.remove("opacity-0");
      toast.classList.add("opacity-100");

      setTimeout(() => {
        toast.classList.remove("opacity-100");
        toast.classList.add("opacity-0");
      }, 3000);
    }

  </script>