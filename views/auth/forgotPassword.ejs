<% if (showOtpModal) { %>
  <%- include('../partials/user/otpModal') %>
<% } %>
<!-- Main Section -->
<div class="grid grid-cols-1 lg:grid-cols-2 min-h-[90vh]">

  <!-- Left Image -->
  <div class="hidden lg:flex items-center justify-center p-10">
    <img src="/images/Frame 26086866.png" class="w-full max-w-md object-cover rounded-lg shadow">
  </div>

  <!-- Form Section -->
  <div class="flex flex-col justify-center px-6 sm:px-12 lg:px-20 py-10">

    <h2 class="text-2xl sm:text-3xl font-semibold mb-8 text-center lg:text-left">
      Forgot Password
    </h2>
    <% if (error) { %>
      <p class="bg-red-100 text-md  mb-4  text-red-700 text-center space-y-4 max-w-md mx-auto lg:mx-0"><%-error %></p>
        <% } %>
          <form action="/forgotPassword" method="POST" class="space-y-4 max-w-md mx-auto lg:mx-0">

            <p class="text-primary font-medium">Enter your registerd Email</p>

            <input type="email" name="email" placeholder="Email" required
              class="w-full border p-3 rounded focus:outline-none focus:ring-2 focus:ring-primary">

            <!-- Password -->
          

            

            <button type="submit" class="w-full bg-primary text-white py-3 rounded bg-[#4c5c49] transition">
              Request OTP
            </button>

          </form>

          <!-- Login -->


          

  </div>
</div>

<!-- Script -->
<script>
  function togglePassword(id, el) {
    const input = document.getElementById(id);
    if (input.type === "password") {
      input.type = "text";
      el.textContent = "🙈";
    } else {
      input.type = "password";
      el.textContent = "👁";
    }
  }
</script>