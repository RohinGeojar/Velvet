<!DOCTYPE html>
<html>
<head>
  <title><%= typeof title !== "undefined" ? title : "Velvet Vogue" %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class=" overflow-hidden">
  
 
 <% if (typeof showNavbar !== "undefined" && showNavbar) { %>
    <%- include("navbar") %>
<% } %>
  <main class="flex  h-[calc(100vh-100px)] overflow-hidden  pb -10">
      <% if (typeof showSidebar !== "undefined" && showSidebar) { %>
    <%- include("sidebar") %>
<% } %>
   

    <div class=" pb-10">
      <%- body %>
    </div>

  </main>

</body>
</html>