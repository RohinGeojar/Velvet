<!-- Overlay -->
<div id="otpModal" class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center z-50">

  <!-- Modal Box -->
  <div class="bg-white rounded-2xl shadow-xl w-[400px] p-8 text-center">

    <!-- Icon -->
    <div class="flex justify-center mb-4">
      <div class="bg-gray-100 p-4 rounded-xl">
        🛡️
      </div>
    </div>

    <!-- Title -->
    <h2 class="text-2xl font-semibold">
      Verify <span class="text-[#6b7f6a]">Email</span>
    </h2>

    <!-- Subtitle -->
    <p class="text-gray-500 text-sm mt-2 mb-6">
      We've sent a 4-digit code to your email<% if (email) { %>
      <p class="bg-primary-100 text-md    text-primary-700 text-center  max-w-md mx-auto lg:mx-0"><%-email %></p>
        <% } %>. <br>
      Please enter it below to verify your account.
    </p>

    <!-- OTP Inputs -->
    <form action="<%= otpAction %>" method="POST">

      <div class="flex justify-center gap-3 mb-6">
        <input type="text" name="otp1" maxlength="1" autocomplete="off"
          class="w-12 h-12 text-center text-lg bg-[#e7eee6] rounded-lg outline-none">
        <input type="text" name="otp2" maxlength="1" autocomplete="off"
          class="w-12 h-12 text-center text-lg bg-[#e7eee6] rounded-lg outline-none">
        <input type="text" name="otp3" maxlength="1" autocomplete="off"
          class="w-12 h-12 text-center text-lg bg-[#e7eee6] rounded-lg outline-none">
        <input type="text" name="otp4" maxlength="1" autocomplete="off"
          class="w-12 h-12 text-center text-lg bg-[#e7eee6] rounded-lg outline-none">
      </div>

      <!-- Button -->
      <button
        class="w-full bg-[#6b7f6a] text-white py-3 rounded-lg hover:opacity-90 transition">
        Verify & Activate
      </button>

    </form>

    <!-- Resend -->
    <p class="text-sm text-gray-500 mt-5">
      Didn't receive the code?
      Resend in
      <span id="timer" class="text-red-500 font-medium">00:30</span>
      <br>
      <button id="resendBtn" disabled
        class="text-gray-400 cursor-not-allowed">
        Resend New Code
      </button>
    </p>

  </div>
</div>
<script>
  
const inputs = document.querySelectorAll("input[name^='otp']");

inputs.forEach((input, index) => {

  // Move forward
  input.addEventListener("input", () => {
    if (input.value.length === 1 && index < inputs.length - 1) {
      inputs[index + 1].focus();
    }
  });

  // Handle backspace
  input.addEventListener("keydown", (e) => {
    if (e.key === "Backspace") {
      
      // If current box is empty → go back
      if (input.value === "" && index > 0) {
        inputs[index - 1].focus();
      }

      // Optional: clear current value
      input.value = "";
    }
  });

});

let time = 60;
const timerEl = document.getElementById("timer");
const resendBtn = document.getElementById("resendBtn");

const interval = setInterval(() => {
  time--;

  let seconds = time < 10 ? "0" + time : time;
  timerEl.innerText = "00:" + seconds;

  if (time <= 0) {
    clearInterval(interval);
    resendBtn.disabled = false;
    resendBtn.classList.remove("text-gray-400", "cursor-not-allowed");
    resendBtn.classList.add("text-[#6b7f6a]");
  }
}, 1000);
</script>