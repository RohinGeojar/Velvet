  <style>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }

    body {
      font-family: 'Manrope', sans-serif;
    }

    .font-serif {
      font-family: 'Noto Serif', serif;
    }
  </style>
</head>

<body
  class="bg-surface w-full text-on-surface selection:bg-secondary-container selection:text-on-secondary-container overflow-x-hidden">

  <main>
    <!-- Hero Section -->
    <section class="relative w-full h-[870px] overflow-hidden">
      <img alt="" class="w-full h-full object-cover"
        data-alt="Cinematic wide shot of a woman in a flowing silk olive dress standing in a sun-drenched minimalist stone courtyard with soft architectural shadows"
        src="/images/banner.png" />
      <div class="absolute inset-0 bg-black/5"></div>
      <div class="absolute inset-0 flex items-center px-20">
        <div class="max-w-xl">
          <span class="block text-secondary font-label uppercase tracking-[0.5em] text-s mb-4">Earth’s Harmony</span>
          <h2 class="text-6xl text-primary md:text-7xl font-serif text-on-surface mb-8 leading-tight">Elegance In
            Simplicity</h2>
          <a href="/shop"><button
              class="bg-primary text-on-primary px-10 py-4 font-label uppercase tracking-widest text-xs hover:bg-primary/90 transition-all active:scale-95">
              New In
            </button></a>
        </div>
      </div>
    </section>
    <!-- Best Sellers -->
  <section class="py-24 px-6 md:px-12 lg:px-20 bg-surface">

    <div class="flex justify-between items-end mb-16">
        <div>
            <h3 class="text-4xl font-serif text-primary">Best Sellers</h3>
        </div>

        <a class="text-sm font-label uppercase tracking-widest text-secondary border-b border-secondary pb-1 hover:opacity-70 transition-opacity" href="/shop">View All</a>
    </div>

    <% if (bestSellers && bestSellers.length > 0) { %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

            <% bestSellers.slice(0, 3).forEach(product => { %>

                <%
                    const variant = product.variants?.[0]
                    const image = variant?.images?.[0]?.url || "/images/placeholder.png"
                    const originalPrice = variant?.salePrice || 0
                    const finalPrice = product.finalPrice || originalPrice
                    const hasOffer = product.hasOffer || false
                    const discountPercentage = product.discountPercentage || 0
                %>

                <div class="group cursor-pointer" onclick="window.location.href='/shop/product/<%= product.slug %>'">

                    <div class="relative overflow-hidden aspect-[3/4] mb-6 bg-surface-container-low">

                        <img src="<%= image %>" alt="<%= product.productName %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700">

                        <% if (hasOffer) { %>
                            <div class="absolute top-4 left-4 bg-primary text-white px-3 py-1 text-xs uppercase tracking-wider"><%= discountPercentage %>% OFF</div>
                        <% } %>
                        

                        <button type="button" onclick="event.stopPropagation(); toggleWishlist('<%= product._id %>', this)" class="wishlist-btn absolute top-4 right-4 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center text-primary opacity-0 group-hover:opacity-100 transition-all duration-300 hover:scale-110">
                            <span class="material-symbols-outlined">favorite</span>
                        </button>

                    </div>

                    <div class="flex justify-between items-start gap-4">

                        <div class="min-w-0">

                            <h4 class="font-serif text-xl text-on-surface truncate"><%= product.productName %></h4>

                            <p class="text-sm text-secondary font-light mt-1"><%= variant?.color || "Premium Collection" %></p>

                            <% if (product.variants?.length > 0) { %>

                                <div class="flex gap-2 mt-4">

                                    <% product.variants.slice(0, 4).forEach(item => { %>

                                        <span class="w-3 h-3 rounded-full border border-gray-300" style="background-color: <%= item.color %>" title="<%= item.color %>"></span>

                                    <% }) %>

                                </div>

                            <% } %>

                        </div>

                        <div class="flex flex-col items-end whitespace-nowrap">

                            <span class="text-lg font-semibold text-primary">₹<%= finalPrice.toLocaleString("en-IN") %></span>

                            <% if (hasOffer) { %>
                                <span class="text-sm text-gray-400 line-through mt-1">₹<%= originalPrice.toLocaleString("en-IN") %></span>
                            <% } %>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } else { %>

        <div class="text-center py-10">
            <p class="text-gray-500">No best selling products available</p>
        </div>

    <% } %>

</section>
    <!-- Collection Section (Asymmetrical Grid) -->
