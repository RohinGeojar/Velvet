<!DOCTYPE html>

<html class="light" lang="en">

<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&amp;family=Manrope:wght@300;400;500;600;700&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <link
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
    rel="stylesheet" />
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "secondary-container": "#f1ddc6",
            "on-tertiary-fixed-variant": "#474836",
            "tertiary": "#535542",
            "on-error-container": "#93000a",
            "surface-container-highest": "#e2e2e2",
            "on-tertiary": "#ffffff",
            "error-container": "#ffdad6",
            "on-primary-container": "#e0f3da",
            "inverse-surface": "#2f3131",
            "surface-container-lowest": "#ffffff",
            "surface-container-high": "#e8e8e8",
            "surface-container": "#eeeeee",
            "error": "#ba1a1a",
            "outline": "#747871",
            "tertiary-fixed": "#e4e4cc",
            "on-secondary-container": "#6f604e",
            "secondary": "#6a5c4a",
            "on-tertiary-fixed": "#1b1d0e",
            "on-secondary": "#ffffff",
            "secondary-fixed-dim": "#d7c3ae",
            "surface-dim": "#dadada",
            "on-error": "#ffffff",
            "on-background": "#1a1c1c",
            "primary-container": "#5f705c",
            "surface-container-low": "#f3f3f3",
            "tertiary-fixed-dim": "#c8c8b0",
            "primary-fixed": "#d5e8cf",
            "surface-bright": "#f9f9f9",
            "on-primary-fixed": "#101f10",
            "inverse-primary": "#b9ccb4",
            "secondary-fixed": "#f4dfc9",
            "primary": "#475845",
            "on-secondary-fixed": "#241a0c",
            "primary-fixed-dim": "#b9ccb4",
            "on-tertiary-container": "#efefd7",
            "on-surface-variant": "#444842",
            "on-surface": "#1a1c1c",
            "background": "#f9f9f9",
            "surface-tint": "#52634f",
            "on-secondary-fixed-variant": "#524534",
            "on-primary": "#ffffff",
            "inverse-on-surface": "#f1f1f1",
            "on-primary-fixed-variant": "#3b4b39",
            "surface": "#f9f9f9",
            "tertiary-container": "#6c6d59",
            "surface-variant": "#e2e2e2",
            "outline-variant": "#c4c8bf"
          },
          fontFamily: {
            "headline": ["Noto Serif"],
            "body": ["Manrope"],
            "label": ["Manrope"]
          },
          borderRadius: { "DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem" },
