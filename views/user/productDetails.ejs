<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue - Luxury Product Detail</title>
    <!-- Google Fonts: Playfair Display (Serif) & DM Sans (Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
        rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#7a9575',// #7a9575,#475845  #7a9575,#475845 00674F ,#2e6f40
                            dark: '#627a5e',
                        },
                        bgLightGray: '#F4F5F4',
                        text: {
                            dark: '#1A1A1A',
                            muted: '#555555',
                            footer: '#FFFFFF'
                        },
                        border: {
                            light: '#E5E5E5'
                        }
                    },
                    fontFamily: {
                        serif: ['"Playfair Display"', 'Georgia', 'serif'],
                        sans: ['"DM Sans"', 'Helvetica', 'Arial', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- EJS Browser Compiler Library -->
    <script src="https://cdn.jsdelivr.net/npm/ejs@3.1.9/ejs.min.js"></script>
    <style>
        /* Smooth transitions for interactive elements */
        .transition-all-300 {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>

<body class="bg-white font-sans text-text-dark min-h-screen flex flex-col antialiased">


    <!-- Breadcrumb line -->
    <div class="bg-white border-b border-border-light py-3.5">
        <div
            class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-[11px] font-sans tracking-wider text-text-muted uppercase flex items-center gap-2">
            <a href="/">Home</a>

            <span>/</span>

            <a href="/shop?category=<%= product.category._id %>">
                <%= product.category.name %>
            </a>

            <span>/</span>

            <span>
                <%= product.productName %>
            </span>
        </div>
    </div>

    <!-- Main Workspace: Two-column split -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

            <!-- LEFT GALLERY COLUMN (1 lg:col-span-7) -->
            <div class="lg:col-span-7 flex flex-col-reverse sm:flex-row gap-4 sm:gap-6">

                <!-- Vertical Slider/Thumbnail Column on the left -->
                <div id="thumbnailContainer" class="flex flex-row sm:flex-col gap-3 sm:w-24">

                    <% if(product.variants[selectedVariantIndex] ?.images?.length){ %>

                        <% product.variants[selectedVariantIndex] .images.forEach((image)=> { %>

                            <img src="<%= image.url %>" onclick="changeImage(this)"
                                class="w-20 h-24 object-cover rounded cursor-pointer border hover:border-black transition">

                            <% }) %>

                                <% } %>

                </div>

                <!-- MAIN IMAGE -->
                <div id="zoomContainer"
                    class="flex-1 aspect-[3/4] bg-gray-100 rounded-lg overflow-hidden relative cursor-zoom-in">

                    <img id="mainImage" src="<%= product.variants[selectedVariantIndex] ?.images?.[0]?.url %>"
                        class="w-full h-full object-cover transition duration-200">

                </div>



            </div>

            <!-- RIGHT DETAILS & PURCHASE COLUMN (lg:col-span-5) -->
            <div class="lg:col-span-5 space-y-8 sm:py-2">

                <div>
                    <h2 class="font-semibold text-3xl sm:text-[40px] tracking-wide text-text-dark leading-tight">
                        <%= product.productName %>
                    </h2>
                    <p class="text-xs sm:text-sm text-text-muted mt-4 font-sans leading-relaxed tracking-wide">
                        <%= product.description %>
                    </p>
                </div>
                <% const currentVariant=product.variants[selectedVariantIndex]; const offer=currentVariant.offer; %>

                    <div id="priceContainer" class="pb-6 border-b border-border-light">

                        <% if (offer?.hasOffer) { %>

                            <div class="flex items-center gap-3">

                                <span id="originalPrice" class="text-lg text-gray-400 line-through">

                                    ₹<%= offer.originalPrice.toLocaleString() %>

                                </span>

                                <span id="offerBadge"
                                    class="px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold">

                                    <%= offer.discountPercentage %>% OFF

                                </span>

                            </div>

                            <div class="mt-2">

                                <span id="salePriceDisplay" class="text-3xl font-semibold text-brand-dark">

                                    ₹<%= offer.finalPrice.toLocaleString() %>

                                </span>

                            </div>

                            <p id="offerName" class="text-sm text-green-600 mt-1">

                                <%= offer.offerName %>

                            </p>

                            <% } else { %>

                                <span id="salePriceDisplay" class="text-3xl font-semibold text-brand-dark">

                                    ₹<%= currentVariant.salePrice.toLocaleString() %>

                                </span>

                                <% } %>

                    </div>

                    <!-- COLOR SELECTOR -->
                    <div class="space-y-4">

                        <h3 class="text-[11px] font-sans font-bold uppercase tracking-[0.2em] text-text-dark">

                            Colors

                        </h3>


                        <div class="flex items-center gap-3">

                            <% product.variants.forEach((variant,index)=> { %>

                                <button type="button" onclick="selectVariant(<%= index %>)" title="<%= variant.color %>"
                                    data-images='<%- JSON.stringify(variant.images) %>'
                                    data-original-price="<%= variant.offer?.originalPrice || variant.salePrice %>"
                                    data-final-price="<%= variant.offer?.finalPrice || variant.salePrice %>"
                                    data-discount="<%= variant.offer?.discountPercentage || 0 %>"
                                    data-offer-name="<%= variant.offer?.offerName || '' %>"
                                    data-has-offer="<%= variant.offer?.hasOffer || false %>"
                                    data-regular="<%= variant.regularPrice %>"
                                    data-sizes='<%- JSON.stringify(variant.sizes) %>'
                                    class="color-btn w-8 h-8 rounded-full border-2 border-gray-200 hover:scale-110 transition-all duration-200 <%= index === selectedVariantIndex? 'ring-2 ring-black ring-offset-2' : '' %>"
                                    style="background-color:<%= variant.colorCode %>;"></button>

                                <% }) %>

                        </div>
                        <div id="stockStatus"
                            class="text-sm font-medium tracking-wide <%= product.isActive ? 'text-gray-500'  : 'text-red-500' %>">

                            <%= product.isActive ? 'Select Size For Stock Verification' : 'Currently Unavailable' %>

                        </div>

                    </div>

                    <!-- Interactive Size Selector with Size Guide Trigger -->

                    <!-- QUANTITY SELECTOR -->
                    <div class="space-y-3">

                        <label class="text-[11px] font-sans font-bold uppercase tracking-[0.2em] text-text-dark">

                            Quantity

                        </label>



                        <div class="flex items-center border border-border-light rounded-md w-fit">

                            <button type="button" onclick="updateQuantity(-1)"
                                class="px-4 py-3 text-lg hover:bg-gray-100 transition">

                                -

                            </button>

                            <input id="quantityInput" type="number" name="quantity" value="1" min="1" max="5" readonly
                                class="w-14 text-center outline-none border-x border-border-light py-3">

                            <button type="button" onclick="updateQuantity(1)"
                                class="px-4 py-3 text-lg hover:bg-gray-100 transition">

                                +

                            </button>



                        </div>
                        <div id="stockError" class=" text-xs text-red-500 mt-2 hidden stock-error">
                        </div>

                        <p id="quantityLimitText" class="text-xs text-text-muted">
                            Maximum 5 quantities allowed
                        </p>

                    </div>


                    <!-- Actions Panel: Add to Cart & Secondary Interactions -->
                    <div class="space-y-4 pt-4 border-t border-border-light">
                        <form id="addToCartForm" action="/shop/cart/add" method="POST" class="space-y-4"
                            onsubmit="return validateCartForm()" class="space-y-4">

                            <div class="space-y-3.5">
                                <div
                                    class="flex justify-between items-center text-[11px] font-sans font-bold uppercase tracking-[0.2em]">
                                    <span class="text-text-dark">Size</span>

                                </div>


                            </div>
                            <div id="sizeWrapper" class="relative">
                                
                                <select id="sizeSelect" name="size" class="w-full border px-4 py-3 rounded-md">

                                    <option value="" selected disabled>

                                        Select Size

                                    </option>


                                    <% product.variants[selectedVariantIndex].sizes.forEach((item)=> { %>
                                        
                                        <option value="<%= item.size %>" data-stock="<%= item.stock %>">

                                            <%= item.size %>

                                        </option>

                                        <% }) %>

                                </select>
                                <div
                                    class="absolute inset-y-0 right-4 flex items-center pointer-events-none text-text-muted">
                                    <i data-lucide="chevron-down" class="w-4 h-4"></i>
                                </div>
                                <p id="sizeError" class="text-sm text-red-500 mt-2 hidden">

                                    Please select a size

                                </p>
                            </div>

                            <input type="hidden" name="productId" value="<%= product._id %>">
                            <input type="hidden" id="cartQuantity" name="quantity" value="1">
                            <input type="hidden" id="selectedVariantIndex" name="variantIndex"
                                value="<%= selectedVariantIndex %>">

                            <button id="addToCartBtn" type="submit" <%=!product.variants[selectedVariantIndex]
                                .sizes.some(size=> size.stock > 0)

                                ? 'disabled'
                                : ''
                                %>

                                class="w-full text-white py-4 rounded-md transition

                                <%= !product.isActive || !product.variants[selectedVariantIndex] .sizes.some(size=>
                                    size.stock > 0)

                                    ? 'bg-gray-400 cursor-not-allowed hover:bg-gray-400'

                                    : 'bg-brand hover:bg-brand-dark'
                                    %>"
                                    >

                                    Add To Cart 

                            </button>

                        </form>

                        <div
                            class="grid grid-cols-2 gap-4 text-[11px] font-sans font-bold uppercase tracking-[0.15em] pt-2">
                            <button onclick="showDemoToast('30 Days Return eligibility guaranteed!', 'truck')"
                                class="flex items-center justify-center gap-2 text-text-muted hover:text-brand py-3 border border-border-light rounded-md transition">
                                <i data-lucide="truck" class="w-4 h-4"></i>
                                <span>Easy Return</span>
                            </button>
                            <button type="button" id="wishlistBtn" class="flex items-center justify-center gap-2 py-3 border rounded-md transition
                            <%= isWishlisted ? 'text-red-500 border-red-300' : 'text-text-muted border-border-light hover:text-brand hover:border-brand' %>">

                                <i id="wishlistIcon" data-lucide="heart" class="w-4 h-4">
                                </i>

                                <span id="wishlistText">
                                    <%= isWishlisted ? "Remove From Wish List" : "Add To Wish List" %>
                                </span>

                            </button>
                        </div>
                    </div>

            </div>

        </div>
    </section>

    <!-- Product info split: Left dynamic accordions, Right material callout card -->
    <!-- Product Details Accordion -->
    <!-- DETAILS + MATERIAL SECTION -->
    <section class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-14">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">

            <!-- LEFT ACCORDIONS -->
            <div class="space-y-4">

                <!-- Material Care -->
                <div class="border border-[#d7d7d2] bg-[#f7f7f4]">

                    <button onclick="toggleAccordion(1)" class="w-full flex items-center justify-between px-8 py-6">

                        <span class="text-2xl font-semibold">
                            Fabric & Care
                        </span>

                        <i id="icon-1" class="ri-subtract-line text-2xl"></i>

                    </button>

                    <div id="accordion-1" class="px-8 pb-8 text-[15px] leading-8 text-gray-700">

                        <p class="mb-4">
                            <strong>Fabric Details :</strong>
                        </p>

                        <p>
                            <%= product.materialDetails %>
                        </p>

                        <br>

                        <p class="mb-4">
                            <strong> Fabric Care :</strong>
                        </p>

                        <p>
                            <%= product.materialCare %>
                        </p>

                    </div>

                </div>

                <!-- Product Detail -->


                <!-- Shipping -->

            </div>

            <!-- RIGHT MATERIAL CARD -->
            <div class="border border-[#d7d7d2] bg-[#f7f7f4]">

                <button onclick="toggleAccordion(3)" class="w-full flex items-center justify-between px-8 py-6">

                    <span class="text-2xl font-semibold">
                        Shipping And Return
                    </span>

                    <i id="icon-3" class="ri-subtract-line text-2xl"></i>

                </button>

                <div id="accordion-3" class="px-8 pb-8 text-[15px] leading-8 text-gray-700">

                    <%= product.shippingDetails %>

                </div>

            </div>


        </div>

    </section>
    <!-- Recommendations Section: "You May Also Like" Grid (Matches Prouduct order.jpg) -->
    <section class="m-20">

        <h2 class="text-3xl font-semibold mb-10">
            You may also like
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

            <% relatedProducts.forEach(item=> { %>

                <a href="/shop/product/<%= item.slug %>" class="group">

                    <div class="aspect-[3/4] overflow-hidden rounded-xl bg-gray-100">

                        <img src="<%= item.variants[0]?.images?.[0]?.url %>"
                            class="w-full h-full object-cover group-hover:scale-105 transition duration-300">

                    </div>

                    <h3 class="mt-4 font-medium">
                        <%= item.productName %>
                    </h3>

                    <p class="text-gray-500">
                        ₹<%= item.variants[0].salePrice %>
                    </p>

                </a>

                <% }) %>

        </div>

    </section>

    <div id="toast" class="fixed top-50 right-5 z-50 hidden"></div>



    <!-- ---------------------------------------------------- -->
    <!-- JAVASCRIPT CONTROLLER LAYER -->
    <!-- ---------------------------------------------------- -->
    <script>

        lucide.createIcons()
        const wishlistBtn = document.getElementById("wishlistBtn");
const wishlistIcon = document.getElementById("wishlistIcon");
const wishlistText = document.getElementById("wishlistText");

const initialWishlistState = <%= isWishlisted ? "true" : "false" %>;

function setWishlistButton(active) {

    if (active) {

        wishlistIcon.setAttribute("fill", "#ef4444");
        wishlistIcon.setAttribute("stroke", "#ef4444");

        wishlistText.textContent =
            "Remove From Wish List";

        wishlistBtn.classList.remove(
            "text-text-muted",
            "border-border-light"
        );

        wishlistBtn.classList.add(
            "text-red-500",
            "border-red-300"
        );

    } else {

        wishlistIcon.setAttribute( "fill",   "none" );

        wishlistIcon.setAttribute( "stroke",     "currentColor"  );

        wishlistText.textContent =   "Add To Wish List";

        wishlistBtn.classList.remove("text-red-500",  "border-red-300" );

        wishlistBtn.classList.add(
            "text-text-muted",
            "border-border-light"
        );
    }
}

setWishlistButton(initialWishlistState);

wishlistBtn.addEventListener("click", async () => {

    const variantIndex = Number(
        document.getElementById("selectedVariantIndex").value
    );

    const variants = <%- JSON.stringify(product.variants) %>;

    const selectedVariant = variants[variantIndex];

    if (!selectedVariant) {
        showToast("Please select a valid variant");
        return;
    }

    try {

        const response = await fetch(
            "/shop/wishlist/toggle",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    productId: "<%= product._id %>",
                    variantId: selectedVariant._id
                })
            }
        );

        if (response.status === 401) {
            window.location.href = "/login";
            return;
        }

        const data = await response.json();

        if (!data.success) {
            showToast(
                data.message || "Unable to update wishlist"
            );
            return;
        }

        setWishlistButton(data.added);

        if ( typeof updateWishlistBadge === "function" && data.wishlistCount !== undefined ) {
            updateWishlistBadge(data.wishlistCount)
        }

        showToast(data.message, "success");

    } catch (error) {

        console.error(
            "Wishlist toggle error:",
            error
        );

        showToast(
            "Unable to update wishlist"
        );
    }
});

        function changeImage(element) {

            document.getElementById("mainImage").src =
                element.src;

        }

        function toggleAccordion(index) {

            const content =
                document.getElementById(`accordion-${index}`);

            const icon =
                document.getElementById(`icon-${index}`);

            content.classList.toggle("hidden");

            if (icon.classList.contains("ri-add-line")) {

                icon.classList.remove("ri-add-line");

                icon.classList.add("ri-subtract-line");

            } else {

                icon.classList.remove("ri-subtract-line");

                icon.classList.add("ri-add-line");

            }

        }
        
        function selectVariant(index) {

    const url = new URL(window.location.href)

    url.searchParams.set("variant", index)

    window.history.replaceState({}, "", url)

    window.location.reload()
            
    document.getElementById("selectedVariantIndex").value = index;

    const buttons = document.querySelectorAll(".color-btn");
    const button = buttons[index];

    if (!button) return;

    buttons.forEach(btn => {
        btn.classList.remove(
            "ring-2",
            "ring-black",
            "ring-offset-2"
        );
    });

    button.classList.add(
        "ring-2",
        "ring-black",
        "ring-offset-2"
    );

    const images = JSON.parse(button.dataset.images || "[]");
    const sizes = JSON.parse(button.dataset.sizes || "[]");

    const hasOffer = button.dataset.hasOffer === "true";

    const originalPriceValue = Number(button.dataset.originalPrice || 0);

    const finalPriceValue = Number(button.dataset.finalPrice || 0);

    const discount =
        Number(button.dataset.discount || 0);

    const offerName =
        button.dataset.offerName || "";

    let originalPrice = document.getElementById("originalPrice");
    let badge = document.getElementById("offerBadge");
    let offerNameElement = document.getElementById("offerName");
    let finalPrice = document.getElementById("salePriceDisplay");

    // Create offer elements if they don't exist
    if (!originalPrice) {
        const priceContainer =
            document.getElementById("priceContainer");

        const priceTop = document.createElement("div");
        priceTop.className = "flex items-center gap-3";

        originalPrice = document.createElement("span");
        originalPrice.id = "originalPrice";
        originalPrice.className =
            "text-lg text-gray-400 line-through";

        badge = document.createElement("span");
        badge.id = "offerBadge";
        badge.className =
            "px-2 py-1 rounded-full bg-green-100 text-green-700 text-xs font-semibold";

        priceTop.appendChild(originalPrice);
        priceTop.appendChild(badge);

        priceContainer.insertBefore(
            priceTop,
            priceContainer.querySelector(".mt-2")
        );
    }

    if (!offerNameElement) {
        offerNameElement = document.createElement("p");
        offerNameElement.id = "offerName";
        offerNameElement.className =
            "text-sm text-green-600 mt-1";

        document.getElementById("priceContainer")
            .appendChild(offerNameElement);
    }

    // Update price
    finalPrice.textContent =
        `₹${finalPriceValue.toLocaleString()}`;

    // Update offer
    if (hasOffer) {

        originalPrice.textContent =
            `₹${originalPriceValue.toLocaleString()}`;

        badge.textContent =
            `${discount}% OFF`;

        offerNameElement.textContent =
            offerName;

        originalPrice.classList.remove("hidden");
        badge.classList.remove("hidden");
        offerNameElement.classList.remove("hidden");

    } else {

        originalPrice.classList.add("hidden");
        badge.classList.add("hidden");
        offerNameElement.classList.add("hidden");
    }

    // Update main image
    if (images.length > 0) {
        document.getElementById("mainImage").src =
            images[0].url;
    }

    // Update thumbnails
    const thumbnailContainer =
        document.getElementById("thumbnailContainer");

    thumbnailContainer.innerHTML = "";

    images.forEach(image => {

        thumbnailContainer.innerHTML += `
            <img
                src="${image.url}"
                onclick="changeImage(this)"
                class="w-20 h-24 object-cover rounded cursor-pointer border hover:border-black transition"
            >
        `;
    });

    // Update sizes
    const sizeSelect =
        document.getElementById("sizeSelect");

    sizeSelect.innerHTML = `
        <option value="" selected disabled>
            Select Size
        </option>
    `;

    sizes.forEach(size => {

        sizeSelect.innerHTML += `
            <option
                value="${size.size}"
                data-stock="${size.stock}"
            >
                ${size.size}
            </option>
        `;
    });

    // Reset quantity
    document.getElementById("quantityInput").value = 1;
    document.getElementById("cartQuantity").value = 1;

    document.getElementById("stockError")
        .classList.add("hidden");

    document.getElementById("sizeError")
        .classList.add("hidden");

    document.getElementById("sizeSelect")
        .classList.remove("border-red-500");
}


        document.addEventListener("change", function (e) {

            if (e.target.id !== "sizeSelect") return;

            const selectedOption =
                e.target.options[e.target.selectedIndex];

            const stock =
                Number(
                    selectedOption.dataset.stock
                );

            const stockStatus =
                document.getElementById(
                    "stockStatus"
                );

            const addToCartBtn =
                document.getElementById(
                    "addToCartBtn"
                );
            const productActive = <%= product.isActive %>;

            if (stock > 0 && productActive) {

                stockStatus.textContent =
                    "In Stock";

                stockStatus.className =
                    "text-sm font-medium text-green-600";

                addToCartBtn.disabled = false;

                addToCartBtn.classList.remove(
                    "bg-gray-400",
                    "cursor-not-allowed",
                );

                addToCartBtn.classList.add(
                    "bg-brand"
                );

            } else {

                stockStatus.textContent =
                    productActive
                        ? "Out Of Stock"
                        : "Currently Unavailable";

                stockStatus.className =
                    "text-sm font-medium text-red-500";

                addToCartBtn.disabled = true;

                addToCartBtn.classList.remove(
                    "bg-brand", "hover:bg-brand-dark"
                );

                addToCartBtn.classList.add(
                    "bg-gray-400",
                    "cursor-not-allowed"
                );


            }

        });

        const zoomContainer = document.getElementById("zoomContainer");

        const mainImage = document.getElementById("mainImage");

        zoomContainer.addEventListener("mousemove", (e) => {

            const rect = zoomContainer.getBoundingClientRect();

            const x = ((e.clientX - rect.left) / rect.width) * 100;

            const y = ((e.clientY - rect.top) / rect.height) * 100;

            mainImage.style.transformOrigin = `${x}% ${y}%`;

            mainImage.style.transform = "scale(2)";
        });

        zoomContainer.addEventListener(
            "mouseleave",
            () => {

                mainImage.style.transform =
                    "scale(1)";
            }
        );
        function updateQuantity(change) {

            const quantityInput =
                document.getElementById("quantityInput");

            const cartQuantity =
                document.getElementById("cartQuantity");

            const stockError =
                document.getElementById("stockError");

            const sizeSelect =
                document.getElementById("sizeSelect");

            const selectedOption =
                sizeSelect.options[sizeSelect.selectedIndex];

            const availableStock = Number(selectedOption?.dataset.stock || 0);
            if (!sizeSelect.value) {

                const sizeError =
                    document.getElementById("sizeError");

                sizeError.classList.remove("hidden");

                sizeSelect.classList.add(
                    "border-red-500"
                );

                return;
            }

            let currentQuantity =
                Number(quantityInput.value);

            stockError.classList.add("hidden");

            currentQuantity += change;

            if (currentQuantity < 1) {

                currentQuantity = 1;
            }

            if (currentQuantity > availableStock) {
                console.log("sizeSelect", selectedOption)

                stockError.textContent =
                    `Insufficient stock. Only ${availableStock} left`;

                stockError.classList.remove("hidden");

                setTimeout(() => {

                    stockError.classList.add("hidden");

                }, 3000);

                return;
            }

            if (currentQuantity > 5) {

                const limitText =
                    document.getElementById(
                        "quantityLimitText"
                    );

                limitText.classList.remove(
                    "text-text-muted"
                );

                limitText.classList.add(
                    "text-red-500",
                    "font-medium"
                );

                setTimeout(() => {

                    limitText.classList.remove(
                        "text-red-500",
                        "font-medium"
                    );

                    limitText.classList.add(
                        "text-text-muted"
                    );

                }, 1000);

                return;
            }

            quantityInput.value =
                currentQuantity;

            cartQuantity.value =
                currentQuantity;
        }


        function validateCartForm() {

            const productActive =
        <%= product.isActive %>;

            if (!productActive) {

                showToast("Product currently unavailable");

                return false;
            }

            const sizeSelect = document.getElementById("sizeSelect");

            const sizeError = document.getElementById("sizeError");

            if (!sizeSelect.value) {

                sizeError.classList.remove("hidden");

                sizeSelect.classList.add("border-red-500");

                return false;
            }

            sizeError.classList.add("hidden");

            sizeSelect.classList.remove("border-red-500");

            return true;
        }

        function showToast(message, type = "error") {

            const toast =
                document.getElementById(
                    "toast"
                );

            toast.className = `

            fixed top-5 right-5 z-50
            px-5 py-3 rounded-lg text-white
            shadow-lg transition-all duration-300

            ${type === "success"

                    ? "bg-green-600"

                    : "bg-red-500"
                }

        `;

            toast.textContent = message;

            toast.classList.remove("hidden");

            setTimeout(() => {

                toast.classList.add("hidden");

            }, 3000);
        }

        document.getElementById("addToCartForm").addEventListener("submit", async function (e) {
            console.log("Submit intercepted");
            e.preventDefault();
            if (!validateCartForm()) {
                return;
            }

            const formData = new FormData(this);

            const data = Object.fromEntries(formData.entries());

            try {

                const response = await fetch(
                    "/shop/cart/add",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type":
                                "application/json"
                        },
                        body: JSON.stringify(data)
                    }
                );
                if (response.status === 401) {

                    window.location.href = "/login";

                    return;
                }



                const result = await response.json();


                const stockError = document.getElementById("stockError");

                if (!result.success) {

                    stockError.textContent = result.message;

                    stockError.classList.remove("hidden");

                    clearTimeout(stockError.timeout);

                    stockError.timeout = setTimeout(() => {
                        stockError.classList.add("hidden");
                    }, 3000);

                    return;
                }

                // Success
                stockError.classList.add("hidden");

                showToast(result.message, "success");
                if (result.cartCount !== undefined) {
    const cartCount = document.getElementById("cart-count");

    if (cartCount) {
        cartCount.textContent = result.cartCount;
        cartCount.classList.remove("hidden");
    }
}
                

                // setTimeout(() => {
                //     window.location.href = result.redirect;
                // }, 1000);

                showToast(
                    result.message,
                    "success"
                );

                // setTimeout(() => {

                //     window.location.href =
                //         result.redirect;

                // }, 1000);

            } catch (error) {
                console.log("ERROR [ ] :", error)
                showToast(
                    "please signup or login to continue"
                );
            }
        }
        );
        document.getElementById("sizeSelect")
            .addEventListener("change", function () {

                this.classList.remove(
                    "border-red-500"
                );

                document.getElementById("sizeError")
                    .classList.add("hidden");

                document.getElementById("quantityInput")
                    .value = 1;

                document.getElementById("cartQuantity")
                    .value = 1;

                document.getElementById("stockError")
                    .classList.add("hidden");
            });



    </script>
</body>

</html>