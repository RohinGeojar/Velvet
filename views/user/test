<script>
   
function togglePassword(id, el) {
  const input = document.getElementById(id);

  if (input.type === "password") {
    input.type = "text";
    el.textContent = "visibility_off";
  } else {
    input.type = "password";
    el.textContent = "visibility";
  }
}

