<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Referral Program | Velvet Vogue</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: "#72846D"
                    }
                }
            }
        }
    </script>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: #ffffff;
            color: #1A1A1A;
        }

        .content-scroll {
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #d1d5db transparent;
        }

        .content-scroll::-webkit-scrollbar {
            width: 5px;
        }

        .content-scroll::-webkit-scrollbar-track {
            background: transparent;
        }

        .content-scroll::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

        .referral-code {
            letter-spacing: 4px;
        }
    </style>
</head>

<body>

    <div class="main-container flex-grow">

        <div class="mx-auto h-full flex flex-col md:flex-row w-full">

            <!-- ================================================= -->
            <!-- MAIN CONTENT -->
            <!-- ================================================= -->

            <div class="flex-1 content-scroll bg-white w-full">

                <div class="px-4 sm:px-6 lg:px-10 py-8 sm:py-12 space-y-8 w-full max-w-none">

                    <!-- ================================================= -->
                    <!-- BREADCRUMB -->
                    <!-- ================================================= -->

                    <nav
                        class="flex items-center pl-4 sm:pl-10 gap-2 text-[11px] uppercase tracking-[0.05em] text-gray-400 mb-4">

                        <a href="/" class="hover:text-gray-600">
                            HOME
                        </a>

                        <i data-lucide="chevron-right" class="w-3 h-3"></i>

                        <span class="text-gray-500 font-semibold">
                            REFERRAL
                        </span>

                    </nav>


                    <!-- ================================================= -->
                    <!-- PAGE HEADING -->
                    <!-- ================================================= -->

                    <div class="pl-4 sm:pl-10">

                        <h1 class="text-3xl sm:text-4xl font-bold text-[#1A1A1A] mb-2 tracking-tight">
                            REFERRAL PROGRAM
                        </h1>

                        <p class="text-gray-500 text-[15px]">
                            Invite your friends and earn rewards
                        </p>

                    </div>


                    <!-- ================================================= -->
                    <!-- REFERRAL CODE -->
                    <!-- ================================================= -->

                    <div class="px-4 sm:px-10">
                        <div class="border border-gray-100 rounded-xl shadow-sm max-w-4xl bg-white overflow-hidden">
                            <div
                                class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-6 py-4 border-b border-gray-100 bg-gray-50/80">
                                <div>
                                    <h3 class="text-xs font-bold text-gray-500 tracking-widest uppercase">
                                        Your Referral
                                    </h3>
                                    <p class="text-xs text-gray-400 mt-1">
                                        Invite your friends and earn rewards
                                    </p>
                                </div>
                                <div id="referralStatus" class="hidden text-xs font-medium text-green-600">
                                    Copied!
                                </div>
                            </div>

                            <div class="p-6 sm:p-8 space-y-6">
                                <div>
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
                                        Referral Code
                                    </p>

                                    <div class="flex flex-col sm:flex-row gap-3 max-w-xl">
                                        <div
                                            class="flex-1 h-12 border border-gray-200 rounded-lg bg-gray-50 flex items-center px-5">
                                            <span id="referralCode"
                                                class="referral-code font-semibold text-[#1A1A1A] text-sm">
                                                <%= referralData?.referralCode || '-' %>
                                            </span>
                                        </div>

                                        <button type="button" id="copyCode"
                                            class="h-12 px-7 bg-brand text-white rounded-lg text-sm font-medium hover:opacity-90 active:scale-95 transition">
                                            Copy Code
                                        </button>
                                    </div>
                                </div>

                                <div>
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">
                                        Referral Link
                                    </p>

                                    <div class="flex flex-col sm:flex-row gap-3 max-w-xl">
                                        <div
                                            class="flex-1 min-w-0 h-12 border border-gray-200 rounded-lg bg-gray-50 flex items-center px-5">
                                            <span id="referralLink" class="text-sm text-gray-600 truncate">
                                                <%= referralLink || '-' %>
                                            </span>
                                        </div>

                                        <button type="button" id="copyLink"
                                            class="h-12 px-7 bg-brand text-white rounded-lg text-sm font-medium hover:opacity-90 active:scale-95 transition">
                                            Copy Link
                                        </button>
                                    </div>

                                    <p class="text-xs text-gray-400 mt-3">
                                        Share this link with your friends. The referral code will be automatically
                                        applied during signup.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- ================================================= -->
                    <!-- REWARD CARDS -->
                    <!-- ================================================= -->

                    <div class="px-4 sm:px-10">

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-4xl">


                            <!-- REWARD -->

                            <div class="border border-gray-100 rounded-xl p-6 bg-white shadow-sm">

                                <div class="w-11 h-11 rounded-lg bg-[#F3F4F6] flex items-center justify-center mb-5">

                                    <i data-lucide="gift" class="w-5 h-5 text-[#72846D]"></i>

                                </div>

                                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Referral Reward
                                </p>

                                <p class="text-2xl font-bold text-[#1A1A1A] mt-2">

                                    ₹<%= referralData?.reward || 0 %>

                                </p>

                                <p class="text-xs text-gray-400 mt-2 leading-5">

                                    Reward credited after your referral completes their qualifying order.

                                </p>

                            </div>


                            <!-- TOTAL REFERRALS -->

                            <div class="border border-gray-100 rounded-xl p-6 bg-white shadow-sm">

                                <div class="w-11 h-11 rounded-lg bg-[#F3F4F6] flex items-center justify-center mb-5">

                                    <i data-lucide="users" class="w-5 h-5 text-[#72846D]"></i>

                                </div>

                                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Total Referrals
                                </p>

                                <p class="text-2xl font-bold text-[#1A1A1A] mt-2">

                                    <%= referralData?.totalReferrals || 0 %>

                                </p>

                                <p class="text-xs text-gray-400 mt-2 leading-5">

                                    Total users who joined using your referral code.

                                </p>

                            </div>


                            <!-- REWARDS EARNED -->

                            <div class="border border-gray-100 rounded-xl p-6 bg-white shadow-sm">

                                <div class="w-11 h-11 rounded-lg bg-[#F3F4F6] flex items-center justify-center mb-5">

                                    <i data-lucide="wallet" class="w-5 h-5 text-[#72846D]"></i>

                                </div>

                                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Rewards Earned
                                </p>

                                <p class="text-2xl font-bold text-[#72846D] mt-2">

                                    ₹<%= (referralData?.rewardsEarned || 0).toLocaleString("en-IN") %>

                                </p>

                                <p class="text-xs text-gray-400 mt-2 leading-5">

                                    Total referral rewards earned so far.

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- HOW IT WORKS -->
                    <!-- ================================================= -->

                    <div class="px-4 sm:px-10">

                        <div class="border border-gray-100 rounded-xl shadow-sm max-w-4xl bg-white">

                            <!-- Header -->

                            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/80">

                                <h3 class="text-xs font-bold text-gray-500 tracking-widest uppercase">
                                    How It Works
                                </h3>

                            </div>


                            <!-- Steps -->

                            <div class="p-6 sm:p-8">

                                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">


                                    <!-- STEP 1 -->

                                    <div class="flex gap-4">

                                        <div
                                            class="flex-shrink-0 w-10 h-10 rounded-full bg-[#F3F4F6] flex items-center justify-center text-sm font-semibold text-[#72846D]">
                                            1
                                        </div>

                                        <div>

                                            <h4 class="text-sm font-semibold text-[#1A1A1A]">
                                                Share Your Code
                                            </h4>

                                            <p class="text-xs text-gray-400 mt-2 leading-5">
                                                Share your unique referral code with your friends and family.
                                            </p>

                                        </div>

                                    </div>


                                    <!-- STEP 2 -->

                                    <div class="flex gap-4">

                                        <div
                                            class="flex-shrink-0 w-10 h-10 rounded-full bg-[#F3F4F6] flex items-center justify-center text-sm font-semibold text-[#72846D]">
                                            2
                                        </div>

                                        <div>

                                            <h4 class="text-sm font-semibold text-[#1A1A1A]">
                                                Friend Joins
                                            </h4>

                                            <p class="text-xs text-gray-400 mt-2 leading-5">
                                                Your friend signs up using your referral code.
                                            </p>

                                        </div>

                                    </div>


                                    <!-- STEP 3 -->

                                    <div class="flex gap-4">

                                        <div
                                            class="flex-shrink-0 w-10 h-10 rounded-full bg-[#F3F4F6] flex items-center justify-center text-sm font-semibold text-[#72846D]">
                                            3
                                        </div>

                                        <div>

                                            <h4 class="text-sm font-semibold text-[#1A1A1A]">
                                                Earn Rewards
                                            </h4>

                                            <p class="text-xs text-gray-400 mt-2 leading-5">
                                                Once their qualifying order is completed, your reward is credited.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- REFERRAL HISTORY -->
                    <!-- ================================================= -->

                    <div class="px-4 sm:px-10 pb-10">
                        <div class="border border-gray-100 rounded-xl shadow-sm max-w-4xl bg-white">

                            <!-- Header -->
                            <div
                                class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 px-6 py-4 border-b border-gray-100 bg-gray-50/80">
                                <div>
                                    <h3 class="text-xs font-bold text-gray-500 tracking-widest uppercase">
                                        Referral History
                                    </h3>

                                    <p class="text-xs text-gray-400 mt-1">
                                        Track your referrals and rewards
                                    </p>
                                </div>

                                <span class="text-xs text-gray-400">
                                    <%= referralData?.totalReferrals || 0 %> referrals
                                </span>
                            </div>

                            <!-- History -->
                            <div class="p-6">

                                <% if (referralData?.referrals && referralData.referrals.length> 0) { %>

                                    <div class="space-y-3">

                                        <% referralData.referrals.forEach(referral=> { %>

                                            <div
                                                class="border border-gray-100 rounded-lg p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">

                                                <!-- USER -->
                                                <div class="flex items-center gap-4">

                                                    <div
                                                        class="w-10 h-10 rounded-full bg-[#F3F4F6] flex items-center justify-center">
                                                        <i data-lucide="user" class="w-4 h-4 text-[#72846D]"></i>
                                                    </div>

                                                    <div>
                                                        <p class="text-sm font-semibold text-[#1A1A1A]">
                                                            <%= referral.referredUserId ?
                                                                `${referral.referredUserId.firstName || "" }
                                                                ${referral.referredUserId.lastName || "" }`.trim()
                                                                : "User" %>
                                                        </p>

                                                        <p class="text-xs text-gray-400 mt-1">
                                                            <%= referral.createdAt ? new
                                                                Date(referral.createdAt).toLocaleDateString("en-IN")
                                                                : "-" %>
                                                        </p>
                                                    </div>

                                                </div>

                                                <!-- STATUS -->
                                                <div class="flex items-center gap-4">

                                                    <span class="text-sm font-semibold">
                                                        ₹<%= referral.status==="rewarded" ? (referral.referrerReward ||
                                                            0) : 0 %>
                                                    </span>

                                                    <% if (referral.status==="rewarded" ) { %>

                                                        <span
                                                            class="px-3 py-1 rounded-full bg-green-50 text-green-600 text-[10px] font-semibold uppercase tracking-wide">
                                                            Rewarded
                                                        </span>

                                                        <% } else { %>

                                                            <span
                                                                class="px-3 py-1 rounded-full bg-yellow-50 text-yellow-600 text-[10px] font-semibold uppercase tracking-wide">
                                                                Pending
                                                            </span>

                                                            <% } %>

                                                </div>

                                            </div>

                                            <% }) %>

                                    </div>

                                    <% } else { %>

                                        <!-- EMPTY STATE -->
                                        <div class="py-12 text-center">

                                            <div
                                                class="w-14 h-14 mx-auto rounded-full bg-[#F3F4F6] flex items-center justify-center">
                                                <i data-lucide="users" class="w-6 h-6 text-[#72846D]"></i>
                                            </div>

                                            <h4 class="text-sm font-semibold text-[#1A1A1A] mt-4">
                                                No Referrals Yet
                                            </h4>

                                            <p class="text-xs text-gray-400 mt-2">
                                                Share your referral link to start earning rewards.
                                            </p>

                                        </div>

                                        <% } %>

                            </div>

                        </div>
                    </div>

                    <!-- ========================================================= -->
                    <!-- COPY REFERRAL CODE -->
                    <!-- ========================================================= -->

                    <script>
                        lucide.createIcons();

                        const copyCodeButton = document.getElementById("copyCode");
                        const copyLinkButton = document.getElementById("copyLink");
                        const referralCodeElement = document.getElementById("referralCode");
                        const referralLinkElement = document.getElementById("referralLink");
                        const referralStatus = document.getElementById("referralStatus");

                        function showCopied(button, message) {
                            const originalText = button.textContent;
                            button.textContent = message;
                            referralStatus.classList.remove("hidden");

                            setTimeout(() => {
                                button.textContent = originalText;
                                referralStatus.classList.add("hidden");
                            }, 1500);
                        }

                        if (copyCodeButton) {
                            copyCodeButton.addEventListener("click", async () => {
                                const code = referralCodeElement?.textContent.trim();

                                if (!code || code === "-") {
                                    return;
                                }

                                try {
                                    await navigator.clipboard.writeText(code);
                                    showCopied(copyCodeButton, "COPIED");
                                } catch (error) {
                                    console.error("Unable to copy referral code:", error);
                                }
                            });
                        }

                        if (copyLinkButton) {
                            copyLinkButton.addEventListener("click", async () => {
                                const link = referralLinkElement?.textContent.trim();

                                if (!link || link === "-") {
                                    return;
                                }

                                try {
                                    await navigator.clipboard.writeText(link);
                                    showCopied(copyLinkButton, "COPIED");
                                } catch (error) {
                                    console.error("Unable to copy referral link:", error);
                                }
                            });
                        }
                    </script>