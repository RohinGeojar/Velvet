<div class="main-container flex-grow">
    <div class="mx-auto h-full flex flex-col md:flex-row w-full">

        <!-- 🔹 Sidebar (IMPORTANT) -->


        <!-- 🔹 Main Content -->
        <div class="flex-1 content-scroll bg-white w-full">
            <div class="px-4 sm:px-6 lg:px-10 py-8 sm:py-12 space-y-8 w-full max-w-none">

                <!-- ✅ YOUR OVERVIEW CONTENT HERE -->

                <!-- Profile Card -->
                <div class="flex-1 p-6">

                   
                    <div class="border border-gray-100 rounded-xl shadow-sm max-w-4xl mx-11 bg-white">

                        <div class=" flex justify-between px-6 py-4 border-b border-gray-100 bg-gray-50/80">
                            <h3 class="text-xs font-bold text-gray-500 tracking-widest uppercase">
                                Profile 
                            </h3>
                            <a href="/profile">
                                        <button type="button"
                                            class="px-6 py-2 bg-brand text-white rounded-lg text-sm active:scale-95">
                                            Make changes
                                        </button>
                                    </a>
                        </div>

                        <div class="p-6 sm:p-8 flex flex-col lg:flex-row gap-10">

                            <!-- Profile Image -->
                            <div class="flex flex-col items-center w-full lg:w-1/3">
                                <img src="<%= user?.profileImage || 'images/default.png' %>"
                                    class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover shadow-inner">
                            </div>

                            <!-- User Details -->
                            <div class="w-full lg:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">

                                <div>
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">First
                                        Name</p>
                                    <p class="text-gray-800 mt-1">
                                        <%= user?.firstName || '-' %>
                                    </p>
                                </div>

                                <div>
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Last
                                        Name</p>
                                    <p class="text-gray-800 mt-1">
                                        <%= user?.lastName || '-' %>
                                    </p>
                                </div>

                                <div>
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Phone
                                    </p>
                                    <p class="text-gray-800 mt-1">
                                        <%= user?.phone || '-' %>
                                    </p>
                                </div>

                                <div>
                                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Email
                                    </p>
                                    <p class="text-gray-800 mt-1">
                                        <%= user?.email || '-' %>
                                    </p>
                                </div>

                            </div>

                        </div>
                    </div>
                    <!-- Default Address -->

                </div>
                <div class="flex-1 p-10 ">
                    <% if (defaultAddress) { %>
                        <div
                            class="border-2 ml-6 border-[#72846D]  rounded-xl p-8 bg-white shadow-sm max-w-xl relative">

                            <!-- Label -->
                            <div class="absolute -top-[14px] left-4">
                                <span
                                    class="bg-[#72846D] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                                    Default Address
                                </span>
                            </div>

                            <!-- Header -->
                            <div class="flex justify-between items-start mb-4">
                                <div>
                                    <h3 class="text-xl font-bold text-[#1A1A1A]">
                                        <%= defaultAddress?.name %>
                                    </h3>

                                    <div class="flex items-center gap-2 text-sm text-[#1A1A1A] mt-1 font-medium">
                                        <i data-lucide="phone" class="w-4 h-4"></i>
                                        <%= defaultAddress?.phone %>
                                    </div>
                                </div>

                                <% if (defaultAddress && defaultAddress._id) { %>
                                    <a href="/address/<%= defaultAddress._id %>/edit">
                                        <button type="button"
                                            class="px-6 py-2 bg-brand text-white rounded-lg text-sm active:scale-95">
                                            Edit
                                        </button>
                                    </a>
                                    <% } %>
                            </div>

                            <!-- Address -->
                            <div class="text-[15px] text-gray-600 space-y-1 leading-relaxed">
                                <p>
                                    <%= defaultAddress?.addressLine1 %>
                                </p>

                                <% if(defaultAddress?.addressLine2){ %>
                                    <p>
                                        <%= defaultAddress?.addressLine2 %>
                                    </p>
                                    <% } %>

                                        <p>
                                            <%= defaultAddress?.city %>
                                        </p>
                                        <p>
                                            <%= defaultAddress?.postalCode %>
                                        </p>

                                        <p class="font-bold text-[#1A1A1A] mt-2 uppercase tracking-wide">
                                            <%= defaultAddress?.country %>
                                        </p>
                            </div>

                        </div>
                        <% } else { %>
                            <p class="text-gray-500">No default address found</p>
                            <% } %>
                </div>
            </div>
        </div>

    </div>
</div>