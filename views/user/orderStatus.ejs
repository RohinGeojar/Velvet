<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Montserrat', sans-serif;
    }
  </style>
  <title>Payment Successful - Velvet Vogue</title>
</head>
<body class="bg-white min-h-screen flex flex-col justify-between text-[#2D2D2D]">

  
  

  <main class="flex-grow flex flex-col items-center justify-center px-4 py-16 text-center max-w-3xl mx-auto">
    
    <div class="text-[#00A86B] mb-6">
      <svg class="w-16 h-16 mx-auto" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>

    <h1 class="text-3xl md:text-4xl font-extrabold text-[#00A86B] tracking-tight mb-8">
      Order Successful
    </h1>

    <div class="space-y-4 max-w-2xl text-gray-600 font-medium leading-relaxed mb-10">
      <p>Thank You For Choosing Velvet Vogue.</p>
      <p>The Receipt Has Been Sent To Your Email.</p>
    </div>

    <a href="/order" class="inline-flex items-center text-sm font-bold text-gray-800 hover:text-black transition gap-2 mb-14 border-b-2 border-transparent hover:border-gray-800 pb-0.5">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
      </svg>
      Back To My Orders
    </a>

    <div class="border-t border-gray-100 pt-8 w-full">
      <h2 class="text-sm font-semibold tracking-wide text-gray-500 uppercase mb-4">Please Contact Us For Any Query</h2>
      <div class="space-y-1 font-medium text-gray-700">
        <p class="hover:text-black transition"><a href="tel:+19294603208">+1(929)460-3208</a></p>
        <p class="text-xs font-bold text-gray-400 py-1">OR</p>
        <p class="hover:text-black transition"><a href="mailto:Hello@VelvetVogue.com">Hello @ Velvet Vogue .Com</a></p>
      </div>
    </div>

  </main>

 
  

</body>
</html>