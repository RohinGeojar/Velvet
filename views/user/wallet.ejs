            </div>
            <div class="border border-gray-200 rounded-lg p-6 space-y-3">
                <h3 class="font-medium text-gray-900">Recent Activity</h3>
                <p class="text-sm text-gray-600">Your last transaction of <span
                        class="font-semibold text-gray-900">₹6,000</span> was added to your wallet on Dec 30,
                    2023.</p>
            </div>
        </div>

        <!-- TAB CONTENT: ACCOUNT DETAILS -->
        <div id="tab-account" class="tab-content space-y-6">
            <h2 class="text-2xl brand-font font-medium text-gray-900 border-b pb-3">Account Details</h2>
            <form onsubmit="event.preventDefault(); showToast('Account details updated successfully!');"
                class="max-w-lg space-y-4 text-sm">
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Full Name</label>
                    <input type="text" value="Rohin Geojar"
                        class="w-full px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:border-sage-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Email
                        Address</label>
                    <input type="email" value="rohin@gmail.com"
                        class="w-full px-3 py-2 border border-gray-200 rounded-md focus:outline-none focus:border-sage-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase text-gray-600 mb-1">Phone Number</label>
                    <input type="text" value="+91 98765 43210"
