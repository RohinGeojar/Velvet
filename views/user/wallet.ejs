<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue - My Wallet</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Tailwind Custom Configuration -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sage: {
                            50: '#f4f6f3',
                            100: '#e5ebe3',
                            500: '#708268',
                            600: '#5c6c55',
                            700: '#485643',
                            800: '#435240',
                            900: '#3f4d3a',
                        }
                    },
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'serif'],
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #1f2937;
        }

        .brand-font {
            font-family: 'Cormorant Garamond', serif;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .modal-backdrop {
            background-color: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(2px);
        }

        /* Smooth tab transitions */
        .tab-content {
            display: none;
            opacity: 0;
            transition: opacity 0.2s ease-in-out;
        }

        .tab-content.active {
            display: block;
            opacity: 1;
        }
    </style>
</head>

<body class="bg-gray-50 antialiased selection:bg-sage-100 flex flex-col min-h-screen">

    <!-- Announcement Bar -->


    <!-- Header Navbar -->

    <%- include("../partials/user/otpModal") %>
        <!-- Main Workspace Area -->
        <div
            class="flex-1 flex flex-col lg:flex-row max-w-7xl w-full mx-auto bg-white border-x border-gray-100 shadow-sm">

            <!-- Sidebar Navigation -->


            <!-- Main Content Area -->
            <main class="flex-1 p-4 sm:p-8 lg:p-10 bg-white">

                <!-- TAB CONTENT: MY WALLET (Default Active Tab) -->
                <div id="tab-wallet" class="tab-content active space-y-8">
                    <!-- Wallet Summary Top Card -->
                    <div
                        class="flex flex-col sm:flex-row justify-between items-start sm:items-center border border-gray-200 rounded-lg p-6 bg-white shadow-sm gap-4">
                        <div class="flex items-center space-x-4">
                            <div
                                class="w-14 h-14 rounded-lg border-2 border-gray-300 flex items-center justify-center text-gray-600 bg-gray-50">
                                <i data-lucide="credit-card" class="w-7 h-7 stroke-[1.5]"></i>
                            </div>
                            <div>
                                <div
                                    class="text-2xl sm:text-3xl font-semibold text-gray-900 tracking-tight flex items-center gap-1">
                                    <span>₹</span><span id="wallet-balance-text">
                                        <%= wallet.balance.toLocaleString("en-IN") %>
                                    </span>
                                </div>
                                <p class="text-xs text-gray-500 font-medium tracking-wide mt-0.5">My Wallet Balance</p>
                            </div>
                        </div>

                        <button onclick="openAddMoneyModal()"
                            class="w-full sm:w-auto bg-sage-500 hover:bg-sage-600 text-white px-6 py-2.5 rounded-md text-sm font-medium transition-all shadow-sm hover:shadow flex items-center justify-center space-x-2">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                            <span>Add Money</span>
                        </button>
                    </div>

                    <!-- Transaction Section Container -->
                    <div class="space-y-4">
                        <div
                            class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-gray-100">
                            <h3 class="text-xs font-semibold tracking-wider text-gray-800 uppercase">Transaction Details
                            </h3>

                           
                        </div>

                        <!-- Table Wrapper -->
                        <div class="border border-gray-200 rounded-lg overflow-hidden bg-white shadow-xs">
                            <div class="overflow-x-auto">
                                <table class="w-full text-xs text-left">
                                    <thead
                                        class="bg-gray-50 border-b border-gray-200 text-gray-500 font-semibold uppercase tracking-wider">
                                        <tr>
                                            <th scope="col" class="px-6 py-3.5">Transaction ID</th>
                                            <th scope="col" class="px-6 py-3.5">Description</th>
                                            <th scope="col" class="px-6 py-3.5">Date</th>
                                            <th scope="col" class="px-6 py-3.5">Withdrawal</th>
                                            <th scope="col" class="px-6 py-3.5">Deposit</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-gray-200 text-gray-700">

                                        <% if(transactions.length){ %>

                                            <% transactions.forEach(transaction=> { %>

                                                <tr class="hover:bg-gray-50">

                                                    <td class="px-6 py-4 font-medium">
                                                        <%= transaction.transactionId %>
                                                    </td>

                                                    <td class="px-6 py-4">
                                                        <%= transaction.description %>
                                                    </td>

                                                    <td class="px-6 py-4">
                                                        <%= new Date(transaction.createdAt).toLocaleDateString("en-IN")
                                                            %>
                                                    </td>

                                                    <td class="px-6 py-4">

                                                        <% if(transaction.type==="debit" ){ %>

                                                            ₹ <%= transaction.amount.toLocaleString("en-IN") %>

                                                                <% } else { %>

                                                                    -

                                                                    <% } %>

                                                    </td>

                                                    <td class="px-6 py-4">

                                                        <% if(transaction.type==="credit" ){ %>

                                                            ₹ <%= transaction.amount.toLocaleString("en-IN") %>

                                                                <% } else { %>

                                                                    -

                                                                    <% } %>

                                                    </td>

                                                </tr>

                                                <% }) %>

                                                    <% } else { %>

                                                        <tr>

                                                            <td colspan="5" class="text-center py-10 text-gray-400">

                                                                No Transactions Found

                                                            </td>

                                                        </tr>

                                                        <% } %>

                                    </tbody>
                                </table>
                            </div>
                        </div>

  

                        <!-- Pagination Bar -->

                        <% if(totalTransactions> 0){ %>

                            <div class="flex flex-col sm:flex-row items-center justify-between pt-4 gap-4">

                                <!-- Transaction Count -->

                                <span class="text-xs text-gray-500">

                                    Showing
                                    <%= (currentpage - 1) * 10 + 1 %>

                                        -

                                        <%= Math.min(currentpage * 10, totalTransactions) %>

                                            of

                                            <%= totalTransactions %>

                                                Transactions

                                </span>


                                <!-- Pagination Buttons -->

                                <% if(totalPages> 1){ %>

                                    <div class="flex items-center gap-2">

                                        <!-- Previous -->

                                        <a href="/wallet?page=<%= currentpage - 1 %>" class=" px-3 py-2 text-xs border border-gray-200 rounded-md transition

                                    <%= currentpage === 1
                                        ? 'hidden'
                                        : 'hover:bg-gray-50'
                                    %>
                                    ">

                                            Previous

                                        </a>


                                        <!-- Page Numbers -->

                                        <% for(let i=1; i <=totalPages; i++){ %>

                                            <a href="/wallet?page=<%= i %>" class=" w-9 h-9 flex  items-center justify-center  text-xs rounded-md border transition

                                                    <%= currentpage === i
                                                        ? 'bg-sage-500 text-white border-sage-500'
                                                        : 'bg-white border-gray-200 hover:bg-gray-50'
                                                    %>
                                                    ">

                                                <%= i %>

                                            </a>

                                            <% } %>


                                                <!-- Next -->

                                                <a href="/wallet?page=<%= currentpage + 1 %>" class="px-3 py-2 text-xs border border-gray-200 rounded-md transition
                                                <%= currentpage === totalPages
                                                    ? 'hidden'
                                                    : 'hover:bg-gray-50'
                                                %>">

                                                    Next

                                                </a>
                                    </div>

                                    <% } %>

                            </div>

                            <% } %>


                    </div>
                </div>
        </div>

        <!-- TAB CONTENT: OVERVIEW -->
