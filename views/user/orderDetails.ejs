<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue - Order Details</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .serif-font {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>

<body class="bg-white text-gray-800 antialiased min-h-screen flex flex-col justify-between">





    <main class="flex-1 h-screen overflow-y-auto p-6 lg:p-8">


        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">

            <a href="/order"
                class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-brand transition">

                <i data-lucide="arrow-left" class="w-4 h-4"></i>

                Back to Orders

            </a>

            <div class="flex items-center justify-between gap-3">

                <% let statusClass="" ; if(order.orderStatus==="Pending" ){ statusClass="bg-yellow-100 text-yellow-700"
                    ; }else if(order.orderStatus==="Confirmed" ){ statusClass="bg-blue-100 text-blue-700" ; }else
                    if(order.orderStatus==="Shipped" ){ statusClass="bg-purple-100 text-purple-700" ; }else
                    if(order.orderStatus==="Delivered" ){ statusClass="bg-green-100 text-green-700" ; }else{
                    statusClass="bg-red-100 text-red-700" ; } %>

                    <span class="px-3 py-1 rounded-full text-xs font-semibold <%= statusClass %>">

                        <%= order.orderStatus %>

                    </span>
                    <%
                        const hasReturnedItem = order.items.some(item =>
                            item.status === "Returned" ||
                            item.status === "Return Requested"
                        );
                        %>
                    <% if (!hasReturnedItem) { %>
                    <a href="/order/<%= order._id %>/invoice"
                        class="bg-brand text-white px-4 py-2 rounded-lg text-sm hover:bg-brand-dark transition">

                        View Invoice

                    </a>
                    <% } %>
                    <% const canCancelOrder=order.items.some(item=>
                        ["Pending", "Confirmed"].includes(item.status)
                        );
                        %>
                        <% if (canCancelOrder) { %>

                            

                                <button type="button" onclick="openCancelOrderModal('<%= order._id %>')"
                                    class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg text-sm transition">

                                    Cancel Order

                                </button>

                            

                            <% } %>

            </div>


        </div>


        <!-- Order Summary Card -->

        <div
            class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm flex flex-col lg:flex-row lg:justify-between gap-8 mb-10">

            <!-- Left -->

            <div>

                <p class="text-xs uppercase tracking-widest text-brand font-semibold">

                    Order ID

                </p>

                <h2 class="text-2xl font-bold mt-1">

                    <%= order.orderId %>

                </h2>

                <p class="text-sm text-gray-500 mt-3">

                    Placed on

                    <%= new Date(order.placedAt).toLocaleDateString("en-IN",{ day:"2-digit", month:"long",
                        year:"numeric" }) %>

                </p>

                <p class="text-sm text-gray-500 mt-1">

                    <%= order.items.length %>

                        Item<%= order.items.length> 1 ? "s" : "" %>

                </p>

            </div>

            <!-- Right -->

            <div class="grid grid-cols-2 gap-x-10 gap-y-5">

                <div>

                    <p class="text-xs text-gray-500 uppercase">

                        Payment

                    </p>

                    <h4 class="font-semibold">

                        <%= order.paymentMethod %>

                    </h4>

                </div>

                <div>

                    <p class="text-xs text-gray-500 uppercase">

                        Payment Status

                    </p>

                    <h4 class="font-semibold">

                        <%= order.paymentStatus %>

                    </h4>

                </div>

                <div>

                    <p class="text-xs text-gray-500 uppercase">

                        Grand Total

                    </p>

                    <h3 class="text-3xl font-bold">

                        ₹<%= order.grandTotal.toLocaleString("en-IN") %>

                    </h3>

                </div>

                <div>

                    <p class="text-xs text-gray-500 uppercase">

                        Order Status

                    </p>

                    <h4 class="font-semibold">

                        <%= order.orderStatus %>

                    </h4>

                </div>

            </div>

        </div>
        <% const stepMap={ Pending: 1, Confirmed: 1, Processing: 2, Shipped: 3, Delivered: 4 }; const
            currentStep=stepMap[order.orderStatus] || 1; const progressWidth=((currentStep - 1) / 3) * 100; %>


            <div class="mb-10 px-4">
                <p class="text-xs text-gray-500 font-medium mb-6">Order expected arrival <span
                        class="font-bold text-gray-800">23 nov, 2025</span></p>

                <div class="relative flex items-center justify-between">
                    <!-- Background Line -->
                    <div class="absolute left-0 right-0 top-[14px] h-[3px] bg-gray-200 rounded-full -z-20"></div>

                    <!-- Progress Line -->
                    <div class="absolute left-0 top-[14px] h-[3px] bg-[#3CB3AF] rounded-full transition-all duration-500 -z-10"
                        style="width:<%= progressWidth %>%">
                    </div>


                    <div class="flex flex-col items-center text-center flex-1">

                        <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3 shadow-sm ring-4 ring-white
    <%= currentStep >= 1
        ? 'bg-[#3CB3AF] text-white'
        : 'bg-white border-2 border-[#3CB3AF] text-[#3CB3AF]' %>">

                            <% if(currentStep>= 1){ %>
                                <i class="fa-solid fa-check text-sm"></i>
                                <% } %>

                        </div>

                        <i class="fa-regular fa-rectangle-list text-xl
        <%= currentStep >= 1 ? 'text-[#3CB3AF]' : 'text-gray-300' %> mb-1"></i>

                        <span class="text-xs <%= currentStep >= 1 ? 'font-semibold text-gray-900' : 'text-gray-400' %>">
                            Order Placed
                        </span>

                    </div>

                    <div class="flex flex-col items-center text-center flex-1">

                        <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3 shadow-sm ring-4 ring-white
    <%= currentStep >= 2
        ? 'bg-[#3CB3AF] text-white'
        : 'bg-white border-2 border-[#3CB3AF] text-[#3CB3AF]' %>">

                            <% if(currentStep>= 2){ %>
                                <i class="fa-solid fa-check text-sm"></i>
                                <% } %>

                        </div>

                        <i class="fa-solid fa-box text-xl
        <%= currentStep >= 2 ? 'text-[#3CB3AF]' : 'text-gray-300' %> mb-1"></i>

                        <span class="text-xs <%= currentStep >= 2 ? 'font-semibold text-gray-900' : 'text-gray-400' %>">
                            Packaging
                        </span>

                    </div>

                    <div class="flex flex-col items-center text-center flex-1">

                        <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3 shadow-sm ring-4 ring-white
    <%= currentStep >= 3
        ? 'bg-[#3CB3AF] text-white'
        : 'bg-white border-2 border-[#3CB3AF] text-[#3CB3AF]' %>">

                            <% if(currentStep>= 3){ %>
                                <i class="fa-solid fa-check text-sm"></i>
                                <% } %>

                        </div>

                        <i class="fa-solid fa-truck text-xl
        <%= currentStep >= 3 ? 'text-[#3CB3AF]' : 'text-gray-300' %> mb-1"></i>

                        <span class="text-xs <%= currentStep >= 3 ? 'font-semibold text-gray-900' : 'text-gray-400' %>">
                            Shipped
                        </span>

                    </div>

                    <div class="flex flex-col items-center text-center flex-1">

                        <div class="w-8 h-8 rounded-full flex items-center justify-center mb-3 shadow-sm ring-4 ring-white
        <%= currentStep >= 4 ? 'bg-[#3CB3AF] text-white' : 'bg-white border-2 border-[#3CB3AF] text-[#3CB3AF]' %>">

                            <% if(currentStep>= 4){ %>
                                <i class="fa-solid fa-check"></i>
                                <% } %>

                        </div>

                        <i class="fa-solid fa-handshake text-xl
        <%= currentStep >= 4 ? 'text-[#3CB3AF]' : 'text-gray-300' %> mb-1"></i>

                        <span class="text-xs <%= currentStep >= 4 ? 'font-semibold text-gray-900' : 'text-gray-400' %>">
                            Delivered
                        </span>

                    </div>
                </div>
            </div>

            <div class="mb-10">

                <div class="flex items-center justify-between mb-5">

                    <h3 class="text-lg font-semibold">

                        Products

                        <span class="text-gray-400 font-normal">

                            (<%= order.items.length %>)

                        </span>

                    </h3>

                </div>

                <div class="space-y-5">

                    <% order.items.forEach(item=> { %>

                        <div class="bg-white border rounded-2xl p-2 shadow-sm">

                            <div class="flex flex-col lg:flex-row justify-between gap-6">

                                <!-- Left -->

                                <div class="flex gap-5">

                                    <img src="<%= item.image %>" class="w-24 h-32 rounded-xl object-cover border">

                                    <div>

                                        <p class="text-xs uppercase tracking-wider text-gray-400">

                                            <%= item.category || "Fashion" %>

                                        </p>

                                        <h2 class="text-lg font-semibold mt-1">

                                            <%= item.productName %>

                                        </h2>

                                        <div class="mt-3 space-y-1 text-sm text-gray-500">

                                            <p>

                                                Size :

                                                <span class="text-gray-700">

                                                    <%= item.size %>

                                                </span>

                                            </p>

                                            <p>

                                                Color :

                                                <span class="text-gray-700">

                                                    <%= item.color %>

                                                </span>

                                            </p>

                                            <p>

                                                Quantity :

                                                <span class="text-gray-700">

                                                    <%= item.quantity %>

                                                </span>

                                            </p>

                                        </div>

                                    </div>

                                </div>

                                <!-- Right -->
                                


                                <div class="flex flex-col justify-center items-end h-full gap-4">

                                    <!-- Price -->
                                    <span class="text-2xl font-bold">
                                        ₹<%= item.price.toLocaleString("en-IN") %>
                                    </span>

                                    <!-- Status Badge -->
                                    <span class="px-3 py-1 rounded-full text-xs font-medium
                                        <% if(item.status === 'Pending'){ %>
                                            bg-yellow-100 text-yellow-700
                                        <% } else if(item.status === 'Confirmed'){ %>
                                            bg-blue-100 text-blue-700
                                        <% } else if(item.status === 'Shipped'){ %>
                                            bg-purple-100 text-purple-700
                                        <% } else if(item.status === 'Delivered'){ %>
                                            bg-green-100 text-green-700
                                        <% } else { %>
                                            bg-red-100 text-red-700
                                        <% } %>">

                                        <%= item.status %>

                                    </span>

                                    <!-- Action -->
                                    <div class="flex gap-2">

                                        <% if (["Pending","Confirmed"].includes(item.status)) { %>

                                           

                                                <button   type="button" onclick="openCancelModal('<%= order._id %>','<%= item._id %>')"
                                                    class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg text-sm">

                                                    Cancel Product

                                                </button>

                                            

                                            <% } else if(item.status==="Delivered" && !item.returnRejected ) { %>

                                                <button  type="button" onclick="openReturnModal('<%= order._id %>','<%= item._id %>')" class="px-4 py-2 bg-brand text-white rounded-lg text-sm">

                                                    Return Product

                                                </button>
                                                

                                                <% }else if(item.returnRejected){ %>
                                                   

                                                <div>
                                                    <span class="text-red-400 text-sm ">
                                                    Return Rejected
                                                </span><br>

                                                <p class="text-xs text-gray-500">
                                                    Reason: <%= item.returnRejectReason %>
                                                </p>
                                                </div>

                                                <% } %>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <% }) %>

                </div>

            </div>


            <div class="grid lg:grid-cols-4 gap-6">

                <div class="lg:col-span-2">


                    <div class="border border-gray-200 rounded-2xl p-6 shadow-sm">

                        <h3 class="text-lg font-semibold mb-5">

                            Shipping Address

                        </h3>

                        <div class="space-y-2 text-sm text-gray-600">

                            <h4 class="text-base font-semibold text-gray-900">

                                <%= order.shippingAddress.name %>

                            </h4>

                            <p>

                                <%= order.shippingAddress.addressLine1 %>

                            </p>

                            <% if(order.shippingAddress.addressLine2){ %>

                                <p>

                                    <%= order.shippingAddress.addressLine2 %>

                                </p>

                                <% } %>

                                    <% if(order.shippingAddress.landmark){ %>

                                        <p>

                                            Landmark :
                                            <%= order.shippingAddress.landmark %>

                                        </p>

                                        <% } %>

                                            <p>

                                                <%= order.shippingAddress.city %>,
                                                    <%= order.shippingAddress.country %>

                                            </p>

                                            <p>

                                                PIN :
                                                <%= order.shippingAddress.postalCode %>

                                            </p>

                                            <div class="pt-3 border-t mt-4">

                                                <p>

                                                    <span class="font-medium text-gray-500">

                                                        Phone :

                                                    </span>

                                                    <%= order.shippingAddress.phone %>

                                                </p>

                                            </div>

                        </div>

                    </div>

                </div>

                <div class="lg:col-span-2">


                    <div class="border border-gray-200 rounded-2xl p-6 shadow-sm">

                        <h3 class="text-lg font-semibold mb-5">

                            Price Details

                        </h3>

                        <div class="space-y-4 text-sm">

                            <div class="flex justify-between">

                                <span class="text-gray-500">

                                    Subtotal

                                </span>

                                <span>

                                    ₹<%= order.subtotal.toLocaleString("en-IN") %>

                                </span>

                            </div>

                            <div class="flex justify-between">

                                <span class="text-gray-500">

                                    Product Discount

                                </span>

                                <span>

                                    - ₹<%= order.productDiscount.toLocaleString("en-IN") %>

                                </span>

                            </div>

                            <div class="flex justify-between">

                                <span class="text-gray-500">

                                    Coupon Discount

                                </span>

                                <span>

                                    - ₹<%= order.couponDiscount.toLocaleString("en-IN") %>

                                </span>

                            </div>

                            <div class="flex justify-between">

                                <span class="text-gray-500">

                                    Shipping Charge

                                </span>

                                <span>

                                    <% if(order.shippingCharge===0){ %>

                                        <span class="text-green-600 font-semibold">

                                            FREE

                                        </span>

                                        <% }else{ %>

                                            ₹<%= order.shippingCharge.toLocaleString("en-IN") %>

                                                <% } %>

                                </span>

                            </div>

                            <% if(order.couponCode){ %>

                                <div class="flex justify-between">

                                    <span class="text-gray-500"> Coupon</span>

                                    <span class="font-medium">
                                        <%= order.couponCode %>
                                    </span>

                                </div>

                                <% } %>

                                    <hr>

                                    <div class="flex justify-between text-lg font-bold">

                                        <span> Grand Total</span>

                                        <span> ₹<%= order.grandTotal.toLocaleString("en-IN") %></span>
                                    </div>
                        </div>
                    </div>

                </div>

            </div>

    </main>
    </div>
    
    <!-- Cancel Confirmation Modal -->
<div id="cancelModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">

    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-7">

        <div class="flex justify-center">

            <div id="modalIcon" class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center">

                <i  id="modalIconSvg" data-lucide="triangle-alert" class="w-8 h-8 text-red-600"></i>

            </div>

        </div>

        <h3 id="cancelTitle" class="text-xl font-bold text-center mt-5">

            Cancel Order

        </h3>

        <p id="cancelMessage" class="text-sm text-gray-500 text-center mt-3 leading-6">

            Are you sure you want to continue?

        </p>

        <div class="mt-6">

            <label  id="reasonLabel" class="block text-sm font-medium text-gray-700 mb-2">

                Cancellation Reason

            </label>

            <textarea
                id="cancelReason"
                rows="4"
                class="w-full border border-gray-200 rounded-xl p-3 text-sm focus:outline-none focus:ring-2 focus:ring-red-200 resize-none"
                placeholder="Please enter the reason for cancellation..."></textarea>

        </div>

        <div  id="modalNote" class="bg-red-50 border border-red-100 rounded-xl p-4 mt-5">

            <p class="text-xs text-red-600 leading-5">

                <strong>Note:</strong>

                This action cannot be undone. Stock will be restored automatically and the customer will be notified.

            </p>

        </div>

        <div class="flex gap-3 mt-7">

            <button
                id="btnCancelClose"
                type="button"
                class="flex-1 border border-gray-300 py-3 rounded-xl font-medium hover:bg-gray-50 transition">

                Keep Order

            </button>

            <button
                id="btnConfirmCancel"
                type="button"
                class="flex-1 bg-red-500 hover:bg-red-600 text-white py-3 rounded-xl font-semibold transition">

                Yes, Cancel

            </button>

        </div>

    </div>

</div>
    <script src="https://unpkg.com/lucide@latest"></script>

   <script>

    lucide.createIcons()

    const cancelModal = document.getElementById("cancelModal")

    const cancelTitle = document.getElementById("cancelTitle")

    const cancelMessage = document.getElementById("cancelMessage")

    const cancelReason = document.getElementById("cancelReason")
    const icon=document.getElementById("modalIcon")

const svg=document.getElementById("modalIconSvg")

    let orderId = null

    let itemId = null

    let cancelType = null
    let actionType = null
     const note = document.getElementById("modalNote")
     const btn = document.getElementById("btnConfirmCancel")

    function openCancelModal(order, item) {
         actionType = "cancelProduct"
        cancelType = "product"

        orderId = order

        itemId = item
document.getElementById("reasonLabel").textContent = "Cancellation Reason"
document.getElementById("btnConfirmCancel").textContent = "Yes, Cancel"
document.getElementById("btnCancelClose").textContent = "Keep Order"
note.className =
"bg-red-50 border border-red-100 rounded-xl p-4 mt-5"
btn.className =
"flex-1 bg-red-500 hover:bg-red-600 text-white py-3 rounded-xl font-semibold transition"
icon.className="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center"

svg.className="w-8 h-8 text-red-600"

        cancelTitle.textContent = "Cancel Product"

        cancelMessage.textContent = "Are you sure you want to cancel this product?"

        cancelReason.value = ""

        cancelModal.classList.remove("hidden")

        cancelModal.classList.add("flex")
        cancelReason.placeholder = "Please enter the cancellation reason..."

document.querySelector("#cancelModal strong").parentElement.innerHTML = `

    <strong>Note:</strong>

    This action cannot be undone. Stock will be restored automatically and the customer will be notified.

`

    }

    function closeCancelModal() {

        cancelModal.classList.add("hidden")

        cancelModal.classList.remove("flex")

    }

    document.getElementById("btnCancelClose").addEventListener("click", closeCancelModal)

    document.getElementById("btnConfirmCancel").addEventListener("click", async() => {
         if(actionType==="cancelProduct"){

        await cancelProduct()

    }

    else if(actionType==="cancelOrder"){

        await cancelOrder()

    }

    else if(actionType==="return"){

        await requestReturn()

    }
    })

    async function cancelProduct() {

        const reason = cancelReason.value.trim()

        if (reason === "") {

            Swal.fire({

                icon: "warning",

                title: "Reason Required",

                text: "Please enter the cancellation reason."

            })

            return

        }

        try {

            const response = await fetch(`/order/${orderId}/items/${itemId}/cancel`, {

                method: "PATCH",

                headers: {

                    "Content-Type": "application/json"

                },

                body: JSON.stringify({

                    reason

                })

            })

            const data = await response.json()

            if (data.success) {

                closeCancelModal()

                Swal.fire({

                    icon: "success",

                    title: "Cancelled",

                    text: data.message

                }).then(() => {

                    location.reload()

                })

            } else {

                Swal.fire({

                    icon: "error",

                    title: "Failed",

                    text: data.message

                })

            }

        } catch (error) {

            console.log(error)

            Swal.fire({

                icon: "error",

                title: "Error",

                text: "Something went wrong." 

            })

        }

    }
    function openCancelOrderModal(order){
     actionType = "cancelOrder"

    cancelType = "order"

    orderId = order

    itemId = null
document.getElementById("reasonLabel").textContent = "Cancellation Reason"
document.getElementById("btnConfirmCancel").textContent = "Yes, Cancel"
document.getElementById("btnCancelClose").textContent = "Keep Order"
    cancelTitle.textContent = "Cancel Entire Order"
    note.className =
"bg-red-50 border border-red-100 rounded-xl p-4 mt-5"
btn.className =
"flex-1 bg-red-500 hover:bg-red-600 text-white py-3 rounded-xl font-semibold transition"
icon.className="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center"

svg.className="w-8 h-8 text-red-600"



    cancelMessage.textContent = "Are you sure you want to cancel this entire order?"

    cancelReason.value = ""

    cancelModal.classList.remove("hidden")

    cancelModal.classList.add("flex")
    cancelReason.placeholder = "Please enter the cancellation reason..."

document.querySelector("#cancelModal strong").parentElement.innerHTML = `

    <strong>Note:</strong>

    This action cannot be undone. Stock will be restored automatically and the customer will be notified.

`

}
async function cancelOrder(){

    const reason = cancelReason.value.trim()

    if(reason === ""){

        Swal.fire({

            icon:"warning",

            title:"Reason Required",

            text:"Please enter the cancellation reason."

        })

        return

    }

    try{

        const response = await fetch(`/order/${orderId}/cancel`,{

            method:"PATCH",

            headers:{
                "Content-Type":"application/json"
            },

            body:JSON.stringify({

                reason

            })

        })

        const data = await response.json()

        if(data.success){

            closeCancelModal()

            Swal.fire({

                icon:"success",

                title:"Cancelled",

                text:data.message

            }).then(()=>{

                location.reload()

            })

        }else{

            Swal.fire({

                icon:"error",

                title:"Failed",

                text:data.message

            })

        }

    }catch(error){

        console.log(error)

    }

}

// =============================================


function openReturnModal(order,item){

    actionType = "return"

    orderId = order

    itemId = item
   

note.className =
"bg-blue-50 border border-blue-100 rounded-xl p-4 mt-5"
btn.className =
"flex-1 bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl font-semibold transition"
    document.getElementById("reasonLabel").textContent = "Return Reason"
    document.getElementById("btnConfirmCancel").textContent = "Request Return"
    document.getElementById("btnCancelClose").textContent = "Go Back"
    icon.className="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center"

svg.className="w-8 h-8 text-blue-600"

    cancelTitle.textContent = "Request Product Return"

    cancelMessage.textContent = "Are you sure you want to request a return for this product?"

    cancelReason.placeholder = "Please enter the return reason..."

    cancelReason.value = ""

    document.querySelector("#cancelModal strong").parentElement.innerHTML = `

        <strong>Note:</strong>

        Your request will be sent to the admin for approval before the return is processed.

    `

    cancelModal.classList.remove("hidden")

    cancelModal.classList.add("flex")

}

async function requestReturn(){

    const reason = cancelReason.value.trim()

    if(reason===""){

        Swal.fire({

            icon:"warning",

            title:"Reason Required",

            text:"Please enter the return reason."

        })

        return

    }

    try{

        const response = await fetch(`/order/${orderId}/items/${itemId}/return`,{

            method:"PATCH",

            headers:{
                "Content-Type":"application/json"
            },

            body:JSON.stringify({

                reason

            })

        })

        const data = await response.json()

        if(data.success){

            closeCancelModal()

            Swal.fire({

                icon:"success",

                title:"Return Requested",

                text:data.message

            }).then(()=>{

                location.reload()

            })

        }else{

            Swal.fire({

                icon:"error",

                title:"Failed",

                text:data.message

            })

        }

    }catch(error){

        console.log(error)

    }

}

</script>
</body>

</html>