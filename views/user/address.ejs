    <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-12">
        <div>
            <h1 class="text-4xl font-bold text-[#1A1A1A] mb-2 tracking-tight">My Addresses</h1>
            <p class="text-gray-500 text-[15px]">Manage your shipping and billing addresses for faster checkout.</p>
        </div>
       <a href="/address/addAddress">
         <button class="bg-[#72846D] text-white px-5 py-3 rounded-lg font-semibold text-[15px] flex items-center gap-2 hover:bg-[#5f6e5a] transition-all shadow-sm">
            <i data-lucide="plus-circle" class="w-5 h-5"></i>
            Add New Address
        </button>
       </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

  <% if (addresses.length === 0) { %>
    <p>No addresses found</p>
  <% } %>

  <% addresses.forEach(address => { %>

    <div class="address-card <%= address.isDefault ? 'default border-2 border-[#72846D]' : 'border border-gray-200' %> relative p-8 bg-white flex flex-col h-full rounded-xl">

      <% if (address.isDefault) { %>
        <div class="absolute -top-[14px] left-4">
          <span class="bg-[#72846D] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
            Default Address
          </span>
        </div>
      <% } %>

      <div class="flex justify-between items-start mb-4">
        <div>
          <h3 class="text-xl font-bold text-[#1A1A1A]">
            <%= address.name %>
          </h3>

          <div class="flex items-center gap-2 text-sm text-[#1A1A1A] mt-1 font-medium">
            <i data-lucide="phone" class="w-4 h-4"></i>
            <%= address.phone %>
          </div>
        </div>

        <div class="bg-[#F3F4F6] p-2 rounded-lg text-gray-500">
          <i data-lucide="<%= address.type === 'office' ? 'building' : 'home' %>" class="w-5 h-5"></i>
        </div>
      </div>

      <div class="text-[15px] text-gray-600 space-y-1 mb-8 flex-1 leading-relaxed">
        <p><%= address.addressLine1 %></p>
        <% if(address.addressLine2){ %>
          <p><%= address.addressLine2 %></p>
        <% } %>
        <p><%= address.city %></p>
        <p><%= address.postalCode %></p>
        <p class="font-bold text-[#1A1A1A] mt-2 tracking-wide uppercase">
          <%= address.country %>
        </p>
      </div>

      <% if (!address.isDefault) { %>
        <a href="/address/<%= address._id %>/default"
           class="text-[11px] font-bold uppercase tracking-[0.1em] text-[#72846D] mb-6 hover:underline transition-all">
          Set as default
        </a>
      <% } %>

      <div class="pt-6 border-t border-gray-100 flex items-center gap-4">
        <a href="/address/<%= address._id %>/edit"
           class="flex-1 flex items-center justify-center gap-2 py-2.5 bg-[#F9FAFB] rounded-lg text-sm font-bold text-[#1A1A1A] hover:bg-gray-100 transition-all">
          <i data-lucide="edit-3" class="w-4 h-4"></i> Edit
        </a>

        <a href="/address/<%= address._id %>/delete"
           onclick="return confirm('Delete this address?')"
           class="p-2 text-gray-400 hover:text-rose-500 transition-colors">
          <i data-lucide="trash-2" class="w-5 h-5"></i>
        </a>
      </div>

    </div>

  <% }) %>

  <!-- Keep your Add Card unchanged -->
  <a href="/address/addAddress">
    <div class="border-2 border-dashed border-gray-200 rounded-xl p-8 flex flex-col items-center justify-center text-center cursor-pointer min-h-[320px] group hover:border-[#72846D] transition-all">
      <div class="w-16 h-16 bg-[#F3F4F6] rounded-full flex items-center justify-center text-[#72846D] mb-6 group-hover:bg-[#72846D] group-hover:text-white transition-all">
