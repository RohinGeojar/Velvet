<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - Account Details</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Google Fonts (Inter for UI, Playfair Display for Logo) -->
    <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@1,600&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        kaushan: ['"Kaushan Script"', 'cursive']
                    },
                    colors: {
                        brand: {
                            DEFAULT: '#7a9575',
                            dark: '#627a5e',
                        },
                        footer: {
                            DEFAULT: '#4a4a4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for a cleaner look */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .sidebar-link.active {
            color: #7a9575;
            font-weight: 500;
        }

        .sidebar-link.active .icon-container {
            background-color: #7a9575;
            color: white;
        }

        .sidebar-link:not(.active) .icon-container {
            color: #9ca3af;
        }

        /* Fixed Heights and Independent Scrolling for Desktop */
        @media (min-width: 768px) {
            .main-container {
                height: calc(100vh - 120px);
                /* Adjust based on banner + header height */
                overflow: hidden;
            }

            .sidebar-scroll {
                height: 100%;
                overflow-y: auto;
            }

            .content-scroll {
                height: 100%;
                overflow-y: auto;
            }
        }

        /* Mobile Menu Transitions */
        #mobile-menu {
            transition: transform 0.3s ease-in-out;
        }

        .menu-open #mobile-menu {
            transform: translateX(0);
        }

        .menu-closed #mobile-menu {
            transform: translateX(-100%);
        }
    </style>
</head>

<body class="bg-white text-gray-800 font-sans antialiased  flex flex-col min-h-screen overflow-x-hidden">


    <!-- Mobile Navigation Overlay (Drawer) -->
    <div id="mobile-overlay" class="fixed inset-0 bg-black/50 z-[60] hidden transition-opacity duration-300"></div>
    <div id="mobile-menu"
        class="fixed inset-y-0 left-0 w-3/4 max-w-sm bg-white z-[70] transform -translate-x-full transition-transform duration-300 flex flex-col md:hidden">
        <div class="p-6 border-b flex justify-between items-center">
            <span class="font-kaushan text-2xl text-brand">Velvet Vogue</span>
            <button id="close-menu" class="p-2"><i class="ph ph-x text-2xl"></i></button>
        </div>
        <div class="flex-grow overflow-y-auto p-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Shop</h3>
            <nav class="flex flex-col space-y-4 mb-8">
                <a href="#" class="text-lg font-medium text-gray-800">Collection</a>
                <a href="#" class="text-lg font-medium text-gray-800">New In</a>
                <a href="#" class="text-lg font-medium text-gray-800">Wedding</a>
                <a href="#" class="text-lg font-medium text-gray-800">Plus Size</a>
                <a href="#" class="text-lg font-medium text-gray-800">Kids</a>
            </nav>
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Account</h3>
            <nav class="flex flex-col space-y-2">
                <a href="#" class="flex items-center gap-3 py-2 text-brand font-semibold"><i class="ph ph-user"></i>
                    Account Details</a>
                <a href="#" class="flex items-center gap-3 py-2 text-gray-600"><i class="ph ph-bag"></i> Order
                    History</a>
                <a href="#" class="flex items-center gap-3 py-2 text-gray-600"><i class="ph ph-wallet"></i> My
                    Wallet</a>
                <a href="/logout" class="flex items-center gap-3 py-2 text-red-500"><i class="ph ph-sign-out"></i>
                    Logout</a>
            </nav>
        </div>
    </div>

    <!-- Main Content Area with Independent Scrolling -->
    <div class="main-container flex-grow">
        <div class=" mx-auto h-full flex flex-col md:flex-row w-full">

            <!-- Sidebar (Left-placed, separate scroll on desktop) -->


            <!-- Main Scrollable Body Area -->
            <main class="max-w-7xl pt-6 px-4 lg:px-8  overflow-y-auto">
                <nav class="flex items-center gap-2 text-[11px] uppercase tracking-[0.05em] text-gray-400 mb-4">
                    <a href="/" class="hover:text-gray-600">HOME</a>
                    <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    <a href="#" class="hover:text-gray-600">ACCOUNT</a>
                    <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    <span class="text-gray-500 font-semibold">ADDRESSES</span>
                </nav>

                <div class="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-12">
                    <div>
                        <h1 class="text-4xl font-bold text-[#1A1A1A] mb-2 tracking-tight">MY ADDRESSES</h1>
                        <p class="text-gray-500 text-[15px]">Manage your shipping and billing addresses for faster
                            checkout.</p>
                    </div>
                    <a href="/address/addAddress">
                        <button
                            class="bg-[#72846D] text-white px-5 py-3 rounded-lg font-semibold text-[15px] flex items-center gap-2 hover:bg-[#5f6e5a] transition-all shadow-sm">
                            <i data-lucide="plus-circle" class="w-5 h-5"></i>
                            Add New Address
                        </button>
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

                    <% if (addresses.length===0) { %>
                        <p>No addresses found</p>
                        <% } %>

                            <% addresses.forEach(address=> { %>

                                <div
                                    class="address-card <%= address.isDefault ? 'default border-2 border-[#72846D]' : 'border border-gray-200' %> relative p-8 bg-white flex flex-col h-full rounded-xl">

                                    <% if (address.isDefault) { %>
                                        <div class="absolute -top-[14px] left-4">
                                            <span
                                                class="bg-[#72846D] text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                                                Default Address
                                            </span>
                                        </div>
                                        <% } %>

                                            <div class="flex justify-between items-start mb-4">
                                                <div>
                                                    <h3 class="text-xl font-bold text-[#1A1A1A]">
                                                        <%= address.name %>
                                                    </h3>

                                                    <div
                                                        class="flex items-center gap-2 text-sm text-[#1A1A1A] mt-1 font-medium">
                                                        <i data-lucide="phone" class="w-4 h-4"></i>
                                                        <%= address.phone %>
                                                    </div>
                                                </div>

                                                <div class="bg-[#F3F4F6] p-2 rounded-lg text-gray-500">
                                                    <i data-lucide="<%= address.type === 'office' ? 'building' : 'home' %>"
                                                        class="w-5 h-5"></i>
                                                </div>
                                            </div>

                                            <div
                                                class="text-[15px] text-gray-600 space-y-1 mb-8 flex-1 leading-relaxed">
                                                <p>
                                                    <%= address.addressLine1 %>
                                                </p>
                                                <% if(address.addressLine2){ %>
                                                    <p>
                                                        <%= address.addressLine2 %>
                                                    </p>
                                                    <% } %>
                                                        <p>
                                                            <%= address.city %>
                                                        </p>
                                                        <p>
                                                            <%= address.postalCode %>
                                                        </p>
                                                        <p
                                                            class="font-bold text-[#1A1A1A] mt-2 tracking-wide uppercase">
                                                            <%= address.country %>
                                                        </p>
                                            </div>

                                            <% if (!address.isDefault) { %>
                                                 <button type="button"
                                                    class="set-default-btn text-[11px] font-bold uppercase tracking-[0.1em] text-[#72846D] hover:underline"
                                                    data-id="<%= address._id %>">
                                                    Set as Default
                                                </button>
                                                <% } %>

                                                    <div class="pt-6 border-t border-gray-100 flex items-center gap-4">
                                                        <a href="/address/<%= address._id %>/edit"
                                                            class="flex-1 flex items-center justify-center gap-2 py-2.5 bg-[#F9FAFB] rounded-lg text-sm font-bold text-[#1A1A1A] hover:bg-gray-100 transition-all">
                                                            <i data-lucide="edit-3" class="w-4 h-4"></i> Edit
                                                        </a>

                                                        <button
                                                            class="delete-address-btn text-red-600 hover:text-red-700"
                                                            data-url="/address/<%= address._id %>/delete?redirect=/checkout"
                                                            data-id="<%= address._id %>">

                                                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                                                        </button>
                                                    </div>

                                </div>

                                <% }) %>
                                    <!-- Delete Confirmation Modal -->
                                    <div id="deleteAddressModal"
                                        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm">

                                        <div class="bg-white rounded-xl shadow-xl w-[90%] max-w-md p-6 animate-fadeIn">

                                            <div class="flex items-center gap-3 mb-4">
                                                <div
                                                    class="w-12 h-12 flex items-center justify-center rounded-full bg-red-100">
                                                    <i data-lucide="trash-2" class="w-6 h-6 text-red-600"></i>
                                                </div>

                                                <div>
                                                    <h2 class="text-xl font-semibold text-gray-800">
                                                        Delete Address
                                                    </h2>
                                                    <p class="text-sm text-gray-500">
                                                        This action cannot be undone.
                                                    </p>
                                                </div>
                                            </div>

                                            <p class="text-gray-600 mb-6">
                                                Are you sure you want to delete this address?
                                            </p>

                                            <div class="flex justify-end gap-3">

                                                <button id="cancelDeleteBtn"
                                                    class="px-5 py-2 rounded-lg border border-gray-300 hover:bg-gray-100 transition">
                                                    Cancel
                                                </button>

                                                <a id="confirmDeleteBtn" href="#"
                                                    class="px-5 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 transition">
                                                    Delete
                                                </a>

                                            </div>

                                        </div>
                                    </div>


                                    <!-- Keep your Add Card unchanged -->
                                    <a href="/address/addAddress">
                                        <div
                                            class="border-2 border-dashed border-gray-200 rounded-xl p-8 flex flex-col items-center justify-center text-center cursor-pointer min-h-[320px] group hover:border-[#72846D] transition-all">
                                            <div
                                                class="w-16 h-16 bg-[#F3F4F6] rounded-full flex items-center justify-center text-[#72846D] mb-6 group-hover:bg-[#72846D] group-hover:text-white transition-all">
                                                <i data-lucide="plus" class="w-8 h-8"></i>
                                            </div>
                                            <h4 class="text-lg font-bold text-[#1A1A1A]">Add New Address</h4>
                                            <p class="text-sm text-gray-400 mt-1">Add a secondary shipping destination
                                            </p>
                                        </div>
                                    </a>

                </div>
                <!-- Spacing for end of scroll -->
                <div class="h-10 md:hidden"></div>
        </div>

        
    </div>
    </div>
    </div>
     <div id="toast" class="fixed top-6 right-6 z-[9999] hidden translate-x-full transition-all duration-300">

        <div id="toastContent"
            class="flex items-center gap-3 min-w-[320px] max-w-md px-5 py-4 rounded-xl shadow-xl border bg-white">

            <div id="toastIcon" class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0">
            </div>

            <div class="flex-1">
                <h4 id="toastTitle" class="font-semibold text-gray-900">
                </h4>

                <p id="toastMessage" class="text-sm text-gray-500">
                </p>
            </div>

            <button id="toastClose" class="text-gray-400 hover:text-gray-700">

                <i data-lucide="x" class="w-4 h-4"></i>

            </button>

        </div>
    </div>

    <!-- Floating Chat Button -->
    <button
        class="fixed bottom-6 right-6 w-14 h-14 bg-white border border-gray-200 text-gray-800 rounded-full shadow-2xl flex items-center justify-center hover:bg-gray-50 transition-all active:scale-90 z-30">
        <i class="ph ph-chat-centered-text text-2xl"></i>
    </button>
    </div>
    </div>
    </div>

    <!-- Floating Chat Button -->
    <button
        class="fixed bottom-6 right-6 w-14 h-14 bg-white border border-gray-200 text-gray-800 rounded-full shadow-2xl flex items-center justify-center hover:bg-gray-50 transition-all active:scale-90 z-30">
        <i class="ph ph-chat-centered-text text-2xl"></i>
    </button>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            lucide.createIcons();
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Menu Toggle
            const hamburger = document.getElementById('hamburger');
            const closeMenu = document.getElementById('close-menu');
            const mobileMenu = document.getElementById('mobile-menu');
            const overlay = document.getElementById('mobile-overlay');

            function toggleMenu() {
                const isOpen = mobileMenu.classList.contains('translate-x-0');
                if (isOpen) {
                    mobileMenu.classList.remove('translate-x-0');
                    mobileMenu.classList.add('-translate-x-full');
                    overlay.classList.add('hidden');
                    overlay.classList.remove('opacity-100');
                } else {
                    mobileMenu.classList.add('translate-x-0');
                    mobileMenu.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                    setTimeout(() => overlay.classList.add('opacity-100'), 10);
                }
            }

            hamburger.addEventListener('click', toggleMenu);
            closeMenu.addEventListener('click', toggleMenu);
            overlay.addEventListener('click', toggleMenu);

            // Password Toggle
            const toggleButtons = document.querySelectorAll('.toggle-password');
            toggleButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const input = this.closest('div').querySelector('input');
                    const icon = this.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.replace('ph-eye', 'ph-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.replace('ph-eye-slash', 'ph-eye');
                    }
                });
            });

            // Adjust height for fixed sidebar effect
            function adjustHeight() {
                if (window.innerWidth >= 768) {
                    const topH = document.getElementById('top-banner').offsetHeight;
                    const headH = document.getElementById('main-header').offsetHeight;
                    document.querySelector('.main-container').style.height = `calc(100vh - ${topH + headH}px)`;
                } else {
                    document.querySelector('.main-container').style.height = 'auto';
                }
            }

            window.addEventListener('resize', adjustHeight);
            adjustHeight();
        })
        const deleteModal = document.getElementById("deleteAddressModal");
        const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
        const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");

        let selectedAddressId = null;

        // Open Modal
        document.querySelectorAll(".delete-address-btn").forEach(button => {
            button.addEventListener("click", () => {
                selectedAddressId = button.dataset.id;

                deleteModal.classList.remove("hidden");
                deleteModal.classList.add("flex");
            });
        });

        // Close Modal
        function closeDeleteModal() {
            deleteModal.classList.remove("flex");
            deleteModal.classList.add("hidden");
            selectedAddressId = null;
        }

        cancelDeleteBtn.addEventListener("click", closeDeleteModal);

        // Close when clicking backdrop
        deleteModal.addEventListener("click", (e) => {
            if (e.target === deleteModal) {
                closeDeleteModal();
            }
        });

        // Delete Address
        confirmDeleteBtn.addEventListener("click", async () => {

            if (!selectedAddressId) return;

            try {

                const response = await fetch(`/address/${selectedAddressId}/delete`, {
                    method: "DELETE",
                    headers: {
                        "Content-Type": "application/json"
                    }
                });

                const data = await response.json();

                if (data.success) {
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to delete address");
                }

            } catch (err) {
                console.error(err);
                alert("Something went wrong.");
            }

            closeDeleteModal();
        })
         document.querySelectorAll(".set-default-btn").forEach(button => {

            button.addEventListener("click", async () => {

                const id = button.dataset.id;

                try {

                    const response = await fetch(`/address/${id}/default`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    const result = await response.json();

                    if (!result.success) {
                        showToast("error", result.message);
                        return;
                    }

                    showToast("success", result.message);

                    setTimeout(() => {
                        location.reload();
                    }, 800);

                } catch (err) {
                    console.error(err);
                    showToast("error", "Something went wrong.");
                }

            });

        });
         let toastTimeout;
         function showToast(type, message) {

            clearTimeout(toastTimeout);

            toast.classList.remove("hidden", "translate-x-full");

            if (type === "success") {

                toastIcon.className =
                    "w-10 h-10 rounded-full flex items-center justify-center bg-green-100 text-green-600";

                toastIcon.innerHTML =
                    `<i data-lucide="check" class="w-5 h-5"></i>`;

                toastTitle.textContent = "Success";

            } else if (type === "error") {

                toastIcon.className =
                    "w-10 h-10 rounded-full flex items-center justify-center bg-red-100 text-red-600";

                toastIcon.innerHTML =
                    `<i data-lucide="x-circle" class="w-5 h-5"></i>`;

                toastTitle.textContent = "Error";

            } else {

                toastIcon.className =
                    "w-10 h-10 rounded-full flex items-center justify-center bg-blue-100 text-blue-600";

                toastIcon.innerHTML =
                    `<i data-lucide="info" class="w-5 h-5"></i>`;

                toastTitle.textContent = "Info";
            }

            toastMessage.textContent = message;

            lucide.createIcons();

            toastTimeout = setTimeout(hideToast, 3000);
        }

        function hideToast() {

            toast.classList.add("translate-x-full");

            setTimeout(() => {

                toast.classList.add("hidden");

            }, 300);

        }
    </script>
</body>

</html>