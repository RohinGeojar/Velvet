<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - Velvet Vogue</title>
    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter for clean UI, Playfair Display for elegant serif titles -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,500;1,600&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        .brand-title {
            font-family: 'Playfair Display', serif;
            font-style: italic;
        }

        /* Custom styling for print media to ensure perfect formatting and hide UI controls */
        @media print {
            body {
                background-color: #ffffff;
                padding: 0;
            }

            .no-print {
                display: none !important;
            }

            .invoice-card {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
            }
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-2">



    <div class="w-full flex items-center justify-center">
        <div
            class="invoice-card bg-white w-full max-w-4xl p-8 sm:p-16 md:p-20 shadow-md border border-gray-100 rounded-sm">

            <!-- Action Bar / Utility Controls (Hidden on Print) -->
            <div class="no-print w-full max-w-5xl mb-6 flex justify-between items-center px-4">
                <span class="text-xs text-gray-500 font-medium">Invoice Preview</span>
                <a href="/order/invoice/<%= order._id %>/download"
                    class="flex items-center gap-2 bg-gray-900 hover:bg-gray-800 text-white text-xs font-semibold px-4 py-2 rounded-lg">

                    Download PDF

                </a>
            </div>

            <!-- Main Invoice Card -->
            <div
                class="invoice-card bg-white w-full max-w-6xl p-8 sm:p-12 md:p-16 shadow-md border border-gray-100 text-gray-800 tracking-wide rounded-sm">

                <!-- Top Section: Brand & Watermark -->
                <div class="flex flex-col sm:flex-row justify-between items-start gap-6 sm:gap-0">
                    <div>
                        <h1 class="brand-title text-4xl sm:text-5xl text-gray-900 mb-2">Velvet Vogue</h1>
                        <p class="text-[10px] font-bold tracking-[0.25em] text-slate-400 uppercase mb-4">Premium Fashion
                            Store
                        </p>
                        <div class="text-xs text-gray-500 space-y-1">
                            <p>123 Fashion Ave, Kochi, Kerala</p>
                            <p>support@velvetvogue.com</p>
                            <p>9896959493</p>
                        </div>
                    </div>
                    <div class="w-full sm:w-auto flex sm:justify-end">
                        <!-- Watermark styled "INVOICE" matching design -->
                        <span
                            class="text-5xl sm:text-6xl font-extrabold text-gray-100 tracking-widest uppercase block select-none font-sans italic opacity-70">
                            INVOICE
                        </span>
                    </div>
                </div>

                <hr class="border-gray-100 my-8 sm:my-10">

                <!-- Invoice & Order Metadata -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-0 text-xs">
                    <div class="grid grid-cols-[100px_1fr] gap-y-3">
                        <span class="text-gray-400 font-medium">Invoice :</span>
                        <span class="font-semibold text-gray-900">INV-<%= order.orderId %></span>

                        <span class="text-gray-400 font-medium">Order ID:</span>
                        <span class="font-semibold text-gray-900">
                            <%= order.orderId %>
                        </span>

                        <span class="text-gray-400 font-medium">Date:</span>
                        <span class="font-semibold text-gray-900">
                            <%= new Date(order.createdAt).toLocaleDateString("en-IN",{ day:"2-digit", month:"long",
                                year:"numeric" }) %>
                        </span>
                    </div>
                    <div class="grid grid-cols-[110px_1fr] gap-y-3 sm:justify-items-end">
                        <div class="sm:contents">
                            <span class="text-gray-400 font-medium sm:text-right w-full">Payment Status:</span>
                            <div class="flex items-center sm:justify-end w-full">
                                <span class="font-bold px-2 py-0.5 rounded text-[10px] tracking-wider uppercase
    <%= order.paymentStatus === 'Paid'
        ? 'bg-emerald-50 text-emerald-600'
        : 'bg-red-50 text-red-600' %>">
                                    <%= order.paymentStatus %>
                                </span>
                            </div>
                        </div>

                        <div class="sm:contents">
                            <span class="text-gray-400 font-medium sm:text-right w-full">Method:</span>
                            <span class="font-semibold text-gray-900 sm:text-right w-full">
                                <%= order.paymentMethod %>
                            </span>
                        </div>
                    </div>
                </div>

                <hr class="border-gray-100 my-8 sm:my-10">

                <!-- Billing & Shipping Information -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-xs mb-12">
                    <div>
                        <h3 class="text-[10px] font-bold tracking-widest text-gray-400 uppercase mb-3">Bill To</h3>
                        <p class="font-bold text-gray-900 text-sm mb-1.5">
                            <%= user.firstName %>
                                <%= user.lastName %><br>
                        </p>
                        <p class="text-gray-500 mb-1">
                            <%= user.email || "-" %>
                        </p>
                        <p class="text-gray-500">
                            <%= user.phone %>
                        </p>
                    </div>
                    <div>
                        <h3 class="text-[10px] font-bold tracking-widest text-gray-400 uppercase mb-3">Ship To</h3>
                        <p class="font-bold text-gray-900 text-sm mb-1.5">
                            <%= order.shippingAddress.name %><br>
                        </p>
                        <div class="text-gray-500 leading-relaxed max-w-[220px]">
                            <%= order.shippingAddress.addressLine1 %><br>
                                <%= order.shippingAddress.addressLine2 %><br>

                                    <%= order.shippingAddress.city %><br>

                                        <%= order.shippingAddress.pincode %>
                        </div>
                    </div>
                </div>

                <!-- Products / Items Table -->
                <div class="overflow-x-auto mb-10">
                    <table class="w-full text-xs border-collapse">
                        <thead>
                            <tr class="border-b border-gray-200 text-gray-900 font-bold">
                                <th class="pb-3 text-left font-bold w-[40%]">Product</th>
                                <th class="pb-3 text-left font-bold w-[25%]">Variant</th>
                                <th class="pb-3 text-center font-bold w-[10%]">Qty</th>
                                <th class="pb-3 text-right font-bold w-[12%]">Unit Price</th>
                                <th class="pb-3 text-right font-bold w-[13%]">Total</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">

                            <% order.items.forEach(item=> { %>

                                <tr class="text-gray-800">
                                    <td class="py-4">
                                        <div>
                                            <p class="<%= item.status === 'Cancelled' ? 'text-red-600' : item.status === 'Returned' ? 'text-purple-600' : 'text-gray-500' %>">
                                                <%= item.productName %>
                                            </p>


                                        </div>
                                    </td>

                                    <td class="py-5 text-gray-500 italic ">

                                        <p class="<%= item.status === 'Cancelled' ? 'text-red-600' : item.status === 'Returned' ? 'text-purple-600' : 'text-gray-500' %>">
                                            <%= item.color %> / <%= item.size %>
                                        </p>
                                    </td>

                                    <td class="py-5 text-center">
                                        <p class="<%= item.status === 'Cancelled' ? 'text-red-600' : item.status === 'Returned' ? 'text-purple-600' : 'text-gray-500' %>"> <%= item.quantity %>
                                        </p>
                                    </td>

                                    <td class="py-5 text-right">

                                        <p class="<%= item.status === 'Cancelled' ? 'text-red-600' : item.status === 'Returned' ? 'text-purple-600' : 'text-gray-500' %>"> ₹<%= item.price.toLocaleString("en-IN") %>
                                        </p>
                                    </td>

                                    <td class="py-5 text-right font-semibold">

                                        <p class="<%= item.status === 'Cancelled' ? 'text-red-600' : item.status === 'Returned' ? 'text-purple-600' : 'text-gray-500' %>"> ₹<%= (item.price *
                                                item.quantity).toLocaleString("en-IN") %>
                                        </p>
                                    </td>

                                </tr>

                                <% }) %>

                        </tbody>
                    </table>
                </div>

                <!-- Totals & Calculations Block -->
                <div class="flex justify-end text-xs">
                    <div class="w-full sm:w-[320px] space-y-3.5">
                        <div class="flex justify-between text-gray-500">
                            <span>Total (MRP)</span>
                            <span class="font-medium text-gray-900">₹<%= order.subtotal.toLocaleString("en-IN") %>
                            </span>
                        </div>
                        <div class="flex justify-between text-gray-500">
                            <span>Shipping</span>
                            <span class="font-medium text-gray-900">
                                <%= order.shippingCharge===0 ? "FREE" : "₹" +
                                    order.shippingCharge.toLocaleString("en-IN") %>
                            </span>
                        </div>
                        <div class="flex justify-between text-red-500">
                            <span>Coupon Discount</span>
                            <span class="font-medium">-₹<%= (order.couponDiscount || 0).toLocaleString("en-IN") %>
                            </span>
                        </div>
                        <div class="flex justify-between text-red-500">
                            <span>Discount</span>
                            <span class="font-medium">-₹<%= (order.productDiscount || 0).toLocaleString("en-IN") %>
                            </span>
                        </div>


                        <hr class="border-gray-100 my-4">

                        <div class="flex justify-between items-baseline pt-2">
                            <span class="text-sm font-bold text-gray-900 uppercase tracking-wider">Total</span>
                            <span class="text-xl font-bold text-gray-900">₹<%= order.grandTotal.toLocaleString("en-IN")
                                    %>
                            </span>
                        </div>
                    </div>
                </div>

                <% order.items.forEach(item=> { %>
                    <% if (item.status==="Cancelled" ) { %>
                        <span class=" text-red-500 text-xs ">
                            *One or more product is Cancelled
                        </span>
                        <% } else if (item.status==="Returned" ) { %>
                            <span class="text-xs  text-purple-600">
                                <br>*One or more product is Returned
                            </span>
                            <% } %>
                                <% }) %>

                                    <!-- Footer / Closing Remark -->
                                    <div class="mt-10 text-center">
                                        <p class="brand-title text-sm sm:text-base text-gray-500">Thank you for shopping
                                            with Velvet Vogue
                                        </p>
                                    </div>

            </div>


        </div>
    </div>
</body>

</html>