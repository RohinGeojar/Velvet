<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= success ? "Payment Successful" : "Payment Failed" %>
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap"
        rel="stylesheet">

    <style>
        html,
        body {
            height: 100%;
            overflow: hidden;
        }

        body {
            font-family: 'Montserrat', sans-serif;
        }

        .brand-font {
            font-family: 'Playfair Display', serif;
        }
    </style>
</head>

<body class="bg-white min-h-screen overflow-hidden">

    <%- include("../partials/user/otpModal") %>

        <!-- PAYMENT RESULT -->

        <main class="h-[calc(100vh-67px)] flex items-center justify-center overflow-hidden -translate-y-12">

            <div class="text-center  max-w-[650px] px-6">

                <% if (success) { %>

                    <!-- SUCCESS ICON -->
                    <div class="flex justify-center mb-5">

                        <div
                            class="w-9 h-9 rounded-full border-[3px] border-emerald-600 flex items-center justify-center">

                            <i data-lucide="check" class="w-5 h-5 text-emerald-600" stroke-width="3">
                            </i>

                        </div>

                    </div>

                    <!-- SUCCESS TITLE -->
                    <h2 class="text-[25px] md:text-[28px] font-semibold text-emerald-600 mb-5">
                        Payment Successful
                    </h2>

                    <!-- MESSAGE -->
                    <p class="text-[14px] md:text-[16px] text-gray-600 leading-6">
                        Thank You For Choosing Velvet Vogue. Your Order Has Been
                        Successfully Placed.
                    </p>

                    <% if (orderId) { %>

                        <p class="text-[14px] text-gray-600 mt-2">
                            Order ID:
                            <span class="font-semibold text-gray-800">
                                <%= orderId %>
                            </span>
                        </p>

                        <% } %>

                            <p class="text-[14px] text-gray-500 mt-3">
                                Your order details have been saved successfully.
                            </p>


                            <!-- BUTTON -->
                            <div class="mt-7">

                                <a href="/order"
                                    class="inline-flex items-center gap-2 text-[14px] font-medium text-gray-700 hover:text-black">

                                    <i data-lucide="chevron-left" class="w-3 h-3">
                                    </i>

                                    Back To My Orders

                                </a><br>OR <br>
                                <a href="/shop"
                                    class="inline-flex items-center gap-2 text-[14px] font-medium text-gray-700 hover:text-black">

                                    <i data-lucide="chevron-left" class="w-3 h-3">
                                    </i>

                                    Continue Shopping

                                </a>


                            </div>


                            <!-- CONTACT -->
                            <div class="mt-12">

                                <p class="text-[10px] text-gray-500">
                                    Please Contact Us For Any Query
                                </p>

                                <p class="text-[10px] text-gray-500 mt-2">
                                    9656057057
                                </p>

                                <p class="text-[9px] text-gray-400 my-1">
                                    OR
                                </p>

                                <p class="text-[10px] text-gray-500">
                                    Hello @ Velvet Vogue .Com
                                </p>

                            </div>


                            <% } else { %>


                                <!-- ERROR ICON -->
                                <div class="flex justify-center mb-5">

                                    <div class="w-9 h-9 rounded-full bg-red-600 flex items-center justify-center">

                                        <i data-lucide="circle-alert" class="w-5 h-5 text-white" stroke-width="3">
                                        </i>

                                    </div>

                                </div>


                                <!-- ERROR TITLE -->
                                <h2 class="text-[23px] md:text-[25px] font-semibold text-red-600 mb-5">
                                    Sorry, Payment Failed
                                </h2>


                                <!-- ERROR MESSAGE -->
                                <p class="text-[11px] md:text-[12px] text-gray-600 leading-6">
                                    <%= message || "Unfortunately, Your Order Cannot Be Completed." %>
                                </p>

                                <p class="text-[11px] md:text-[12px] text-gray-600 leading-6">
                                    Please Ensure That The Billing Address You Provided
                                    Is The Same One Your Debit/Credit Card Is Registered.
                                </p>

                                <p class="text-[11px] md:text-[12px] text-gray-600 leading-6">
                                    Alternatively, Please Try A Different Payment Method.
                                </p>


                                <!-- RETRY -->
                                <div class="mt-7">

                                    <a href="/shop/checkout"
                                        class="inline-flex items-center justify-center w-[210px] h-[32px] bg-[#60745d] text-white text-[9px] hover:bg-[#52654f] transition">

                                        Retry Payment

                                    </a>

                                </div>


                                <!-- BACK -->
                                

                                <% } %>

            </div>

        </main>


        <script src="https://unpkg.com/lucide@latest"></script>

        <script>
            lucide.createIcons()
        </script>

</body>

</html>