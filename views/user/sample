    <script>
        const editBtn = document.getElementById("editBtn");
        const saveBtn = document.getElementById("saveBtn");
        const inputs = document.querySelectorAll("input");

        editBtn.addEventListener("click", () => {
            inputs.forEach(input => input.disabled = false);

            saveBtn.disabled = false;
            saveBtn.classList.remove("opacity-50", "cursor-not-allowed");

            editBtn.style.display = "none"; 
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Menu Toggle
            const hamburger = document.getElementById('hamburger');
            const closeMenu = document.getElementById('close-menu');
            const mobileMenu = document.getElementById('mobile-menu');
            const overlay = document.getElementById('mobile-overlay');

            function toggleMenu() {
                const isOpen = mobileMenu.classList.contains('translate-x-0');
                if (isOpen) {
                    mobileMenu.classList.remove('translate-x-0');
                    mobileMenu.classList.add('-translate-x-full');
                    overlay.classList.add('hidden');
                    overlay.classList.remove('opacity-100');
                } else {
                    mobileMenu.classList.add('translate-x-0');
                    mobileMenu.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                    setTimeout(() => overlay.classList.add('opacity-100'), 10);
                }
            }

            hamburger.addEventListener('click', toggleMenu);
            closeMenu.addEventListener('click', toggleMenu);
            overlay.addEventListener('click', toggleMenu);

            // Password Toggle
            const toggleButtons = document.querySelectorAll('.toggle-password');
            toggleButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const input = this.closest('div').querySelector('input');
                    const icon = this.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.replace('ph-eye', 'ph-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.replace('ph-eye-slash', 'ph-eye');
                    }
                });
            });

            // Adjust height for fixed sidebar effect
            function adjustHeight() {
                if (window.innerWidth >= 768) {
                    const topH = document.getElementById('top-banner').offsetHeight;
                    const headH = document.getElementById('main-header').offsetHeight;
                    document.querySelector('.main-container').style.height = `calc(100vh - ${topH + headH}px)`;
                } else {
                    document.querySelector('.main-container').style.height = 'auto';
                }
            }

            window.addEventListener('resize', adjustHeight);
            adjustHeight();
        });
    </script>
</body>

