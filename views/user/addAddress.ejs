    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@1,600&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        kaushan: ['"Kaushan Script"', 'cursive']
                    },
                    colors: {
                        brand: {
                            DEFAULT: '#7a9575',
                            dark: '#627a5e',
                        },
                        footer: {
                            DEFAULT: '#4a4a4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for a cleaner look */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .sidebar-link.active {
            color: #7a9575;
            font-weight: 500;
        }

        .sidebar-link.active .icon-container {
            background-color: #7a9575;
            color: white;
        }

        .sidebar-link:not(.active) .icon-container {
            color: #9ca3af;
        }

        /* Fixed Heights and Independent Scrolling for Desktop */
        @media (min-width: 768px) {
            .main-container {
                height: calc(100vh - 120px);
                /* Adjust based on banner + header height */
                overflow: hidden;
            }

            .sidebar-scroll {
                height: 100%;
                overflow-y: auto;
            }

            .content-scroll {
                height: 100%;
                overflow-y: auto;
            }
        }

        /* Mobile Menu Transitions */
        #mobile-menu {
            transition: transform 0.3s ease-in-out;
        }

        .menu-open #mobile-menu {
            transform: translateX(0);
        }

        .menu-closed #mobile-menu {
            transform: translateX(-100%);
        }
    </style>
</head>

<body class="bg-white text-gray-800 font-sans antialiased flex flex-col min-h-screen overflow-x-hidden">

