    </div>

    <!-- Main Content Area with Independent Scrolling -->
    <div class="main-container flex-grow">
        <div class=" mx-auto h-full flex flex-col md:flex-row w-full">

            <!-- Sidebar (Left-placed, separate scroll on desktop) -->
            

            <!-- Main Scrollable Body Area -->
            <main class="flex-1 content-scroll  md:p-6 lg:p-8 bg-white mb-11">
                <nav class="flex items-center gap-2 text-[11px] uppercase tracking-[0.05em] text-gray-400 mb-4">
        <a href="/" class="hover:text-gray-600">HOME</a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <a href="/profile/overview" class="hover:text-gray-600">OVERVIEW </a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <a href="/address" class="hover:text-gray-600">ADDRESS </a>
        <i data-lucide="chevron-right" class="w-3 h-3"></i>
        <span class="text-gray-500 font-semibold">ADD or EDIT ADDRESS </span>
    </nav>
                <h1 class="text-3xl font-bold text-[#1A1A1A] mb-8">ADD OR EDIT ADDRESS</h1>

                <form id="addressForm" action="<%= address ? `/address/${address._id}/edit` : '/address' %>" method="POST" class="max-w-3xl">
                    <div class="grid grid-cols-2 gap-y-4 gap-x-4">

                        
                        <div class="col-span-1">
                            <input type="text" name="firstName"  id="firstName" value="<%= address?.name?.split(' ')[0] || '' %>" placeholder="First Name" required
                            class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500">
                            <p id="firstNameError" class="text-red-500 text-xs mt-1"></p>
                        </div>
                        <div class="col-span-1">
                            <input type="text" name="lastName" id="lastName" value="<%= address?.name?.split(' ').slice(1).join(' ') || '' %>" placeholder="Last Name" required
                            class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500">
                            <p id="lastNameError" class="text-red-500 text-xs mt-1"></p>
                        </div>
                        
                        <div class="col-span-2">
                            <input type="text" name="addressLine1" value="<%= address?.addressLine1 || '' %>" placeholder="Address Line 1" required
                            class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500">
                        </div>
                        
                        <div class="relative col-span-2">
                            <input type="text" name="addressLine2" value="<%= address?.addressLine2 || '' %>" placeholder="Address Line 2"
                            class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500 pr-10">
                            <div class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400">
                                <i data-lucide="search" class="w-5 h-5"></i>
                            </div>
                        </div>
                        
                        <div class="col-span-2">
                            <input type="text" name="landmark" value="<%= address?.landmark || '' %>" placeholder="Landmark (Optional)" 
                            class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500">
                        </div>
                        
                        <div class="relative col-span-2">
                            <input type="text" name="country" id="country" value="<%= address?.country || '' %>" placeholder="Country/Region"  required
                                class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500 pr-10">
                                <p id="countryError" class="text-red-500 text-xs mt-1"></p>
                            <div class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400">
                                <i data-lucide="x" class="w-5 h-5 cursor-pointer"></i>
                            </div>
                        </div>
                        <div class="col-span-1">
                            <input type="text" id="postalCode" name="postalCode" value="<%= address?.postalCode || '' %>" placeholder="Postal Code"  maxlength="6" inputmode="numeric" required
                                class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500">
                                <p id="postalCodeError" class="text-red-500 text-xs mt-1"></p>
                        </div>
                        <div class="col-span-1">
                            <input type="text" name="city" id="city" value="<%= address?.city || '' %>" placeholder="City" required
                                class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500">
                        </div>

                        <div class="relative col-span-2">
                            <input type="tel" name="phone" value="<%= address?.phone || '' %>" placeholder="Phone" required
                                class="w-full px-4 py-3 border border-gray-400 rounded-sm outline-none focus:border-black transition-colors placeholder:text-gray-500 pr-10">
                            <div class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400">
                                <i data-lucide="smartphone" class="w-5 h-5"></i>
                            </div>
                        </div>

                        <div class="col-span-2 flex items-center gap-3 pt-2">
                            <input  type="checkbox" name="isDefault" <%= address?.isDefault ? "checked" : "" %> 
                                class="w-4 h-4 border-gray-400 rounded accent-[#7A8B6E] cursor-pointer">
                            <label for="defaultAddress" class="text-sm text-gray-700 cursor-pointer">
                                Set This As Default Address
                            </label>
                        </div>
                    </div>

                    <div class="w-full h-[1px] bg-gray-200 my-10"></div>

                    <div class="flex items-center justify-end gap-4">
                        <button id="cancelBtn" type="button"
                            class="hidden px-10 py-2.5 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 font-medium transition-all">
                            Cancel
                        </button>
                        <button id="saveBtn" type="submit"
                            class="px-10 py-2.5 bg-[#4A5D4E] text-white rounded-md font-medium hover:opacity-90 transition-all flex items-center gap-2">
                            Save Address
                        </button>
                    </div>
                </form>
            </main>
            <!-- Spacing for end of scroll -->
            <div class="h-10 md:hidden"></div>
        </div>

        <!-- Footer (Inside main container logic for desktop layout) -->
        <footer class="bg-footer text-white pt-16 pb-8 border-t border-gray-700">
            <div class="px-6 lg:px-10">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
                    <!-- Newsletter -->
                    <div class="space-y-6">
                        <h4 class="text-lg font-medium">Join Our Club</h4>
                        <form class="space-y-4" onsubmit="event.preventDefault();">
                            <div
                                class="flex border border-gray-500 rounded-lg focus-within:border-brand transition-colors overflow-hidden">
                                <input type="email" placeholder="Email Address"
                                    class="w-full bg-transparent text-white px-4 py-3 focus:outline-none text-sm">
                                <button type="submit" class="px-4 text-gray-300 hover:text-white transition"><i
                                        class="ph ph-arrow-right"></i></button>
                            </div>
                            <p class="text-[10px] text-gray-400">By submitting, you agree to advertising emails.
                            </p>
                        </form>
                    </div>
                    <!-- Links 1 -->
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-6">About Us</h4>
                        <ul class="space-y-3">
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Collection</a>
                            </li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Support
                                    System</a></li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Privacy
                                    Policy</a></li>
                        </ul>
                    </div>
                    <!-- Links 2 -->
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-6">Support</h4>
                        <ul class="space-y-3">
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Shipping</a></li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Returns</a></li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Contact</a></li>
                        </ul>
                    </div>
                    <!-- Socials -->
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-6">Social</h4>
                        <div class="flex space-x-4">
                            <a href="#"
                                class="w-10 h-10 rounded-full border border-gray-600 flex items-center justify-center hover:bg-white hover:text-footer transition"><i
                                    class="ph ph-instagram-logo"></i></a>
                            <a href="#"
                                class="w-10 h-10 rounded-full border border-gray-600 flex items-center justify-center hover:bg-white hover:text-footer transition"><i
                                    class="ph ph-facebook-logo"></i></a>
                        </div>
                    </div>
                </div>
                <div class="pt-8 border-t border-gray-700 text-center text-xs text-gray-500">
                    © 2026 Velvet Vogue. All Rights Reserved.
                </div>
            </div>
        </footer>
    </div>
    </div>
    </div>
    <div id="toast"
  class="fixed top-6 right-6 bg-red-500 text-white px-4 py-3 rounded-md shadow-lg opacity-0 -translate-y-2 transition-all duration-300 z-50">
</div>

    <!-- Floating Chat Button -->
    <button
        class="fixed bottom-6 right-6 w-14 h-14 bg-white border border-gray-200 text-gray-800 rounded-full shadow-2xl flex items-center justify-center hover:bg-gray-50 transition-all active:scale-90 z-30">
        <i class="ph ph-chat-centered-text text-2xl"></i>
    </button>
<script src="https://unpkg.com/lucide@latest">
   
</script>
   <script>
document.addEventListener("DOMContentLoaded", () => {
     lucide.createIcons();

  const form = document.getElementById("addressForm");
  const saveBtn = document.getElementById("saveBtn");
  const cancelBtn = document.getElementById("cancelBtn");

  // ===============================
  // INITIAL STATE (IMPORTANT)
  // ===============================
  saveBtn.disabled = true;
  saveBtn.classList.add("opacity-50", "cursor-not-allowed");
  cancelBtn.classList.add("hidden");

  // ===============================
  // STORE INITIAL FORM STATE
  // ===============================
  let initialData = new FormData(form);
  let initialValues = Object.fromEntries(initialData.entries());

  function isFormChanged() {
    const currentData = new FormData(form);
    const currentValues = Object.fromEntries(currentData.entries());

    return Object.keys(initialValues).some(key => {
      return initialValues[key] !== currentValues[key];
    });
  }

  // ===============================
  // INPUT HANDLING
  // ===============================
  document.querySelectorAll("input").forEach(input => {
    input.addEventListener("input", () => {

      // clear error
      const errorEl = document.getElementById(input.name + "Error");
      if (errorEl) errorEl.innerText = "";

      input.classList.remove("border-red-500", "focus:border-red-500");
      input.classList.add("border-gray-400", "focus:border-black");

      if (isFormChanged()) {
        saveBtn.disabled = false;
        saveBtn.classList.remove("opacity-50", "cursor-not-allowed");
        cancelBtn.classList.remove("hidden");
      } else {
        saveBtn.disabled = true;
        saveBtn.classList.add("opacity-50", "cursor-not-allowed");
        cancelBtn.classList.add("hidden");
      }
    });
  });

  // ===============================
  // CANCEL BUTTON
  // ===============================
  cancelBtn.addEventListener("click", () => {
    window.location.reload();
  });

  // ===============================
  // SUBMIT
  // ===============================
  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    saveBtn.disabled = true;

    document.querySelectorAll("[id$='Error']").forEach(el => el.innerText = "");

    const formData = new FormData(form);
    const body = Object.fromEntries(formData.entries());

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      });

      const data = await res.json();

      if (!res.ok) {
  saveBtn.disabled = false;

  if (data.errors && data.errors.length > 0) {

    showToast("Please fix the highlighted fields");

    data.errors.forEach(err => {
      const input = document.querySelector(`[name="${err.field}"]`);
      const errorEl = document.getElementById(err.field + "Error");

      if (errorEl) errorEl.innerText = err.message;

      if (input) {
        input.classList.remove("border-gray-400", "focus:border-black");
        input.classList.add("border-red-500", "focus:border-red-500");
      }
    });
   
  } else if (data.message) {
  
    showToast(data.message);

    
  }

  return;
}

      // ✅ SUCCESS
      showToast("Address saved successfully", "success");
       location.href = "/address";

      // 🔥 reset state
      initialData = new FormData(form);
      initialValues = Object.fromEntries(initialData.entries());

      saveBtn.disabled = true;
      saveBtn.classList.add("opacity-50", "cursor-not-allowed");

      cancelBtn.classList.add("hidden");

    } catch (err) {
      console.log(err);
      saveBtn.disabled = false;
      showToast("Something went wrong");
    }
  });

  // ===============================
  // PINCODE AUTO FILL (FIXED POSITION)
  // ===============================
  const postalInput = document.getElementById("postalCode");

  if (postalInput) {
    let timeout;

    postalInput.addEventListener("input", function () {

      this.value = this.value.replace(/\D/g, '').slice(0, 6);
      const pincode = this.value;

      if (pincode.length < 6) {
  document.getElementById("city").value = "";
  document.getElementById("country").value = "";

  document.getElementById("city").readOnly = false;
  document.getElementById("country").readOnly = false;

  return;
}

      clearTimeout(timeout);

      timeout = setTimeout(async () => {
        try {
          const res = await fetch(`https://api.postalpincode.in/pincode/${pincode}`);
          const data = await res.json();

          if (data[0].Status === "Success") {
            const postOffice = data[0].PostOffice[0];

            document.getElementById("city").value = postOffice.District;
            document.getElementById("country").value = "India";

            document.getElementById("city").readOnly = true;
            document.getElementById("country").readOnly = true;
          }

        } catch (err) {
          console.log(err);
        }
      }, 300);
    });
  }

});

function showToast(message, type = "error") {
  const toast = document.getElementById("toast");
  if (!toast) return;

  toast.innerText = message;

  toast.className =
    "fixed top-6 right-6 px-4 py-3 rounded-md shadow-lg z-50 transition-all duration-300 " +
    (type === "error" ? "bg-red-500 text-white" : "bg-green-500 text-white");

  toast.classList.remove("opacity-0", "-translate-y-2");
  toast.classList.add("opacity-100", "translate-y-0");

  setTimeout(() => {
    toast.classList.remove("opacity-100");
    toast.classList.add("opacity-0", "-translate-y-2");
  }, 3000);
}
</script>
</body>

