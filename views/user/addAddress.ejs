                        </div>
                    </div>

                    <div class="w-full h-[1px] bg-gray-200 my-10"></div>

                    <div class="flex items-center justify-end gap-4">
                        <button type="button"
                            class="px-10 py-2.5 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 font-medium transition-all">
                            Cancel
                        </button>
                        <button type="submit"
                            class="px-10 py-2.5 bg-[#4A5D4E] text-white rounded-md font-medium hover:opacity-90 transition-all flex items-center gap-2">
