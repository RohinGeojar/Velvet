                    </div>
                    <!-- Links 1 -->
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-6">About Us</h4>
                        <ul class="space-y-3">
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Collection</a>
                            </li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Support
                                    System</a></li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Privacy
                                    Policy</a></li>
                        </ul>
                    </div>
                    <!-- Links 2 -->
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-6">Support</h4>
                        <ul class="space-y-3">
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Shipping</a></li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Returns</a></li>
                            <li><a href="#" class="text-gray-300 hover:text-white transition text-sm">Contact</a></li>
                        </ul>
                    </div>
                    <!-- Socials -->
                    <div>
                        <h4 class="text-sm font-bold uppercase tracking-widest text-gray-400 mb-6">Social</h4>
                        <div class="flex space-x-4">
                            <a href="#"
                                class="w-10 h-10 rounded-full border border-gray-600 flex items-center justify-center hover:bg-white hover:text-footer transition"><i
                                    class="ph ph-instagram-logo"></i></a>
                            <a href="#"
                                class="w-10 h-10 rounded-full border border-gray-600 flex items-center justify-center hover:bg-white hover:text-footer transition"><i
                                    class="ph ph-facebook-logo"></i></a>
                        </div>
                    </div>
                </div>
                <div class="pt-8 border-t border-gray-700 text-center text-xs text-gray-500">
                    © 2026 Velvet Vogue. All Rights Reserved.
                </div>
            </div>
        </footer>
    </div>
    </div>
    </div>

    <!-- Floating Chat Button -->
    <button
        class="fixed bottom-6 right-6 w-14 h-14 bg-white border border-gray-200 text-gray-800 rounded-full shadow-2xl flex items-center justify-center hover:bg-gray-50 transition-all active:scale-90 z-30">
        <i class="ph ph-chat-centered-text text-2xl"></i>
    </button>

    <script>
        const editBtn = document.getElementById("editBtn");
        const saveBtn = document.getElementById("saveBtn");
        const inputs = document.querySelectorAll("input");

        editBtn.addEventListener("click", () => {
            inputs.forEach(input => input.disabled = false);

            saveBtn.disabled = false;
            saveBtn.classList.remove("opacity-50", "cursor-not-allowed");

            editBtn.style.display = "none";
        });

        document.addEventListener('DOMContentLoaded', () => {
            // Menu Toggle
            const hamburger = document.getElementById('hamburger');
            const closeMenu = document.getElementById('close-menu');
            const mobileMenu = document.getElementById('mobile-menu');
            const overlay = document.getElementById('mobile-overlay');

            function toggleMenu() {
                const isOpen = mobileMenu.classList.contains('translate-x-0');
                if (isOpen) {
                    mobileMenu.classList.remove('translate-x-0');
                    mobileMenu.classList.add('-translate-x-full');
                    overlay.classList.add('hidden');
                    overlay.classList.remove('opacity-100');
                } else {
                    mobileMenu.classList.add('translate-x-0');
                    mobileMenu.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                    setTimeout(() => overlay.classList.add('opacity-100'), 10);
                }
            }

            hamburger.addEventListener('click', toggleMenu);
            closeMenu.addEventListener('click', toggleMenu);
            overlay.addEventListener('click', toggleMenu);

            // Password Toggle
            const toggleButtons = document.querySelectorAll('.toggle-password');
            toggleButtons.forEach(button => {
                button.addEventListener('click', function () {
                    const input = this.closest('div').querySelector('input');
                    const icon = this.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.replace('ph-eye', 'ph-eye-slash');
                    } else {
                        input.type = 'password';
                        icon.classList.replace('ph-eye-slash', 'ph-eye');
                    }
                });
            });

            // Adjust height for fixed sidebar effect
            function adjustHeight() {
                if (window.innerWidth >= 768) {
                    const topH = document.getElementById('top-banner').offsetHeight;
                    const headH = document.getElementById('main-header').offsetHeight;
                    document.querySelector('.main-container').style.height = `calc(100vh - ${topH + headH}px)`;
                } else {
                    document.querySelector('.main-container').style.height = 'auto';
                }
            }

            window.addEventListener('resize', adjustHeight);
            adjustHeight();
        });
    </script>
</body>

</html>