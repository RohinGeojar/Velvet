<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - Account Details</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <!-- Google Fonts (Inter for UI, Playfair Display for Logo) -->
    <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@1,600&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        kaushan: ['"Kaushan Script"', 'cursive']
                    },
                    colors: {
                        brand: {
                            DEFAULT: '#7a9575',
                            dark: '#627a5e',
                        },
                        footer: {
                            DEFAULT: '#4a4a4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for a cleaner look */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .sidebar-link.active {
            color: #7a9575;
            font-weight: 500;
        }

        .sidebar-link.active .icon-container {
            background-color: #7a9575;
            color: white;
        }

        .sidebar-link:not(.active) .icon-container {
            color: #9ca3af;
        }

        /* Fixed Heights and Independent Scrolling for Desktop */
        @media (min-width: 768px) {
            .main-container {
                height: calc(100vh - 120px);
                /* Adjust based on banner + header height */
                overflow: hidden;
            }

            .sidebar-scroll {
                height: 100%;
                overflow-y: auto;
            }

            .content-scroll {
                height: 100%;
                overflow-y: auto;
            }
        }

        /* Mobile Menu Transitions */
        #mobile-menu {
            transition: transform 0.3s ease-in-out;
        }

        .menu-open #mobile-menu {
            transform: translateX(0);
        }

        .menu-closed #mobile-menu {
            transform: translateX(-100%);
        }
    </style>
</head>

<body class="bg-white text-gray-800 font-sans antialiased flex flex-col min-h-screen overflow-x-hidden">

    <!-- Top Banner -->
    <div id="top-banner" class="bg-brand text-white text-center py-2 text-[10px] sm:text-sm tracking-wide z-50">
        Enjoy Free Shipping On All Orders
    </div>

    <!-- Header Navigation -->
    <header id="main-header" class="border-b border-gray-100 sticky top-0 bg-white z-40">
        <div class="w-full mx-0 px-4 sm:px-6 lg:px-8 py-4 sm:py-5 flex items-center justify-between">

            <!-- Hamburger Button (Mobile Only) -->
            <button id="hamburger" class="md:hidden text-gray-600 p-2 -ml-2" aria-label="Menu">
                <i class="ph ph-list text-2xl"></i>
            </button>

            <!-- Logo -->
            <div class="flex-shrink-0 flex flex-col items-center relative">
                <div class="flex items-center gap-1 mx-10">
                    <span class="font-kaushan text-2xl sm:text-3xl tracking-tight text-gray-800">Velvet
                        Vogue</span>
                    <i class="ph-fill ph-plant text-brand text-lg sm:text-xl relative -top-1"></i>
                </div>
                <span class="text-[0.5rem] sm:text-[0.6rem] text-gray-500 tracking-widest uppercase -mt-1">women
                    clothing</span>
            </div>

            <!-- Desktop Nav Links -->
            <nav class="hidden md:flex space-x-6 lg:space-x-8">
                <a href="#" class="text-gray-600 hover:text-brand transition text-sm lg:text-base">Collection</a>
                <a href="#" class="text-gray-600 hover:text-brand transition text-sm lg:text-base">New In</a>
                <a href="#" class="text-gray-600 hover:text-brand transition text-sm lg:text-base">Wedding</a>
                <a href="#" class="text-gray-600 hover:text-brand transition text-sm lg:text-base">Plus Size</a>
                <a href="#" class="text-gray-600 hover:text-brand transition text-sm lg:text-base">Kids</a>
            </nav>

            <!-- Icons -->
            <div class="flex items-center space-x-3 sm:space-x-6 mr-8 ">
                <a href="#" class="text-gray-600 hover:text-brand transition p-1" aria-label="Search"><i
                        class="ph ph-magnifying-glass text-xl sm:text-2xl"></i></a>
                <a href="#" class="text-gray-600 hover:text-brand transition p-1 relative hidden sm:block"
                    aria-label="Profile">
                    <div class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 w-1 h-1 bg-black rounded-full">
                    </div>
                    <i class="ph ph-user text-xl sm:text-2xl"></i>
                </a>
                <a href="#" class="text-gray-600 hover:text-brand transition p-1" aria-label="Favorites"><i
                        class="ph ph-heart text-xl sm:text-2xl"></i></a>
                <a href="#" class="text-gray-600 hover:text-brand transition p-1" aria-label="Cart">
                    <i class="ph ph-tote text-xl sm:text-2xl"></i>
                </a>
            </div>
        </div>
    </header>

    <!-- Mobile Navigation Overlay (Drawer) -->
    <div id="mobile-overlay" class="fixed inset-0 bg-black/50 z-[60] hidden transition-opacity duration-300"></div>
    <div id="mobile-menu"
        class="fixed inset-y-0 left-0 w-3/4 max-w-sm bg-white z-[70] transform -translate-x-full transition-transform duration-300 flex flex-col md:hidden">
        <div class="p-6 border-b flex justify-between items-center">
            <span class="font-serif italic text-2xl text-brand">Velvet Vogue</span>
            <button id="close-menu" class="p-2"><i class="ph ph-x text-2xl"></i></button>
        </div>
        <div class="flex-grow overflow-y-auto p-6">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Shop</h3>
            <nav class="flex flex-col space-y-4 mb-8">
                <a href="#" class="text-lg font-medium text-gray-800">Collection</a>
                <a href="#" class="text-lg font-medium text-gray-800">New In</a>
                <a href="#" class="text-lg font-medium text-gray-800">Wedding</a>
                <a href="#" class="text-lg font-medium text-gray-800">Plus Size</a>
                <a href="#" class="text-lg font-medium text-gray-800">Kids</a>
            </nav>
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Account</h3>
            <nav class="flex flex-col space-y-2">
                <a href="#" class="flex items-center gap-3 py-2 text-brand font-semibold"><i class="ph ph-user"></i>
                    Account Details</a>
                <a href="#" class="flex items-center gap-3 py-2 text-gray-600"><i class="ph ph-bag"></i> Order
