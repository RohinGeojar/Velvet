        <div id="mobile-menu"
            class="fixed inset-y-0 left-0 w-3/4 max-w-sm bg-white z-[70] transform -translate-x-full transition-transform duration-300 flex flex-col md:hidden">
            <div class="p-6 border-b flex justify-between items-center">
                <span class=" font-family: 'Kaushan Script', cursive text-2xl text-brand">Velvet Vogue</span>
                <button id="close-menu" class="p-2"><i class="ph ph-x text-2xl"></i></button>
            </div>
            <div class="flex-grow overflow-y-auto p-6">
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Shop</h3>
                <nav class="flex flex-col space-y-4 mb-8">
                    <a href="#" class="text-lg font-medium text-gray-800">Collection</a>
                    <a href="#" class="text-lg font-medium text-gray-800">New In</a>
                    <a href="#" class="text-lg font-medium text-gray-800">Wedding</a>
                    <a href="#" class="text-lg font-medium text-gray-800">Plus Size</a>
                    <a href="#" class="text-lg font-medium text-gray-800">Kids</a>
                </nav>
                <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Account</h3>
                <nav class="flex flex-col space-y-2">
                    <a href="#" class="flex items-center gap-3 py-2 text-brand font-semibold"><i class="ph ph-user"></i>
                        Account Details</a>
                    <a href="#" class="flex items-center gap-3 py-2 text-gray-600"><i class="ph ph-bag"></i> Order
                        History</a>
                    <a href="#" class="flex items-center gap-3 py-2 text-gray-600"><i class="ph ph-wallet"></i> My
                        Wallet</a>
                    <a href="/logout" class="flex items-center gap-3 py-2 text-red-500"><i class="ph ph-sign-out"></i>
                        Logout</a>
                </nav>
            </div>
        </div>

        <!-- Main Content Area with Independent Scrolling -->
        <div class="main-container flex-grow">
            <div class=" mx-auto h-full flex flex-col md:flex-row w-full">


                <!-- Main Scrollable Body Area -->
                <div class="flex-1 content-scroll bg-white w-full">

                    <div class="px-4 sm:px-6 lg:px-10 py-8 sm:py-12 space-y-8 w-full max-w-none">
                        <nav
                            class="flex items-center pl-10 gap-2 text-[11px] uppercase tracking-[0.05em] text-gray-400 mb-4">
                            <a href="/" class="hover:text-gray-600">HOME</a>
                            <i data-lucide="chevron-right" class="w-3 h-3"></i>
                            <a href="/profile/overview" class="hover:text-gray-600">OVERVIEW</a>
                            <i data-lucide="chevron-right" class="w-3 h-3"></i>
                            <span class="text-gray-500 font-semibold">EDIT PROFILE</span>
                        </nav>
                        <div class="pl-10">
                            <h1 class="text-4xl font-bold text-[#1A1A1A] mb-2 tracking-tight">EDIT PROFILE</h1>
                            <p class="text-gray-500 text-[15px]">Manage your profile and password security.</p>
                        </div>
                        <!-- Breadcrumbs (Mobile only, hidden desktop for cleaner app look) -->
                        <div class="md:hidden flex items-center gap-2 text-xs text-gray-400 mb-4">
                            <span>Account</span>
                            <i class="ph ph-caret-right"></i>
                            <span class="text-gray-800">Account Details</span>
                        </div>

                        <!-- Account Setting Section -->
                        <section class="border border-gray-100 rounded-xl overflow-hidden shadow-sm max-w-4xl mx-11">
                            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/80">
                                <h3 class="text-xs font-bold text-gray-500 tracking-widest uppercase">Profile setting
                                </h3>
                                <button type="button" id="editBtn"
                                    class="px-6 py-2 bg-brand text-white rounded-lg flex justify-self-end text-sm active:scale-95">Edit</button>
                            </div>


                            <div class="p-6 sm:p-8 flex flex-col lg:flex-row gap-10">
                                <!-- Photo Update Column -->

                                <div class="flex flex-col items-center space-y-6 w-full lg:w-1/3">
                                    <img id="profilePreview" src="<%= user?.profileImage?.url || 'images/default.png' %>"
                                        class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover shadow-inner">
                                    <form action="/profile/uploadPhoto" method="POST" enctype="multipart/form-data">

                                        <input type="file" name="profileImage" id="profileImage" class="hidden"
