<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - Account Details</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>

    <!-- Google Fonts (Inter for UI, Playfair Display for Logo) -->
    <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:ital,wght@1,600&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                        kaushan: ['"Kaushan Script"', 'cursive'],
                    },
                    colors: {
                        brand: {
                            DEFAULT: '#7a9575',// #7a9575,#475845  #7a9575,#475845 00674F ,#2e6f40
                            dark: '#627a5e',
                        },
                        footer: {
                            DEFAULT: '#4a4a4a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        /* Custom scrollbar for a cleaner look */
        ::-webkit-scrollbar {
            width: 6px;
        }

        .cropper-view-box,
        .cropper-face {
            border-radius: 50%;
            /* optional circle */
        }


        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        .sidebar-link.active {
            color: #7a9575;
            font-weight: 500;
        }

        .sidebar-link.active .icon-container {
            background-color: #7a9575;
            color: white;
        }

        .sidebar-link:not(.active) .icon-container {
            color: #9ca3af;
        }

        /* Fixed Heights and Independent Scrolling for Desktop */
        @media (min-width: 768px) {
            .main-container {
                height: calc(100vh - 120px);
                /* Adjust based on banner + header height */
                overflow: hidden;
            }

            .sidebar-scroll {
                height: 100%;
                overflow-y: auto;
            }

            .content-scroll {
                height: 100%;
                overflow-y: auto;
            }
        }

        /* Mobile Menu Transitions */
        #mobile-menu {
            transition: transform 0.3s ease-in-out;
        }

        .menu-open #mobile-menu {
            transform: translateX(0);
        }

        .menu-closed #mobile-menu {
            transform: translateX(-100%);
        }
    </style>
</head>

