                                        </label>


                                    </form>
                                    <div id="cropModal"
                                        class="fixed inset-0 bg-black/70 hidden flex items-center justify-center z-50">

                                        <div class="bg-white p-4 rounded-lg w-full max-w-md h-[550px] flex flex-col">
                                            <div class="w-full h-[450px]">
                                                <img id="cropImage" class="w-full h-full object-cover">
                                            </div>

                                            <div class="mt-3 flex gap-2">
                                                <button onclick="showConfirmModal()"
                                                    class="px-4 py-2 bg-green-600 text-white rounded">
                                                    Crop
                                                </button>

                                                <button onclick="closeModal()"
                                                    class="px-4 py-2 bg-gray-400 text-white rounded">
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                    <div id="confirmModal"
                                        class="fixed inset-0 bg-black/70 hidden flex items-center justify-center z-50">

                                        <div class="bg-white p-6 rounded-lg text-center">
                                            <p class="mb-4 font-semibold">Upload this image?</p>

                                            <div class="flex gap-3 justify-center">
                                                <button onclick="uploadCroppedImage()"
                                                    class="px-4 py-2 bg-green-600 text-white rounded">
                                                    Yes
                                                </button>

                                                <button onclick="closeConfirmModal()"
                                                    class="px-4 py-2 bg-gray-400 text-white rounded">
                                                    No
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Form Fields Column -->
                                <div class="w-full lg:w-2/3">
                                    <form action="/profile" method="POST" class="space-y-6">
                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-5">
                                            <div class="space-y-1.5">
                                                <label for="firstName"
                                                    class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">First
                                                    Name</label>
                                                <input type="text" id="firstName" name="firstName" disabled
                                                    value="<%= user?.firstName || '' %>"
                                                    class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                                            </div>
                                            <div class="space-y-1.5">
                                                <label for="lastName"
                                                    class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Last
                                                    Name</label>
                                                <input type="text" id="lastName" name="lastName" disabled
                                                    value="<%= user?.lastName || '' %>"
                                                    class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                                            </div>
                                            <div class="space-y-1.5">
                                                <label for="phone"
                                                    class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Phone
                                                    Number</label>
                                                <input type="tel" id="phone" disabled name="phone"
                                                    pattern="[6-9][0-9]{9}" value="<%= user?.phone || '' %>"
                                                    class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                                            </div>
                                            <div class="space-y-1.5">
                                                <label for="email"
                                                    class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</label>
                                                <input type="email" id="email" disabled name="email"
                                                    value="<%= user?.email || '' %>"
                                                    class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition">
                                            </div>
                                        </div>
                                        <div class="flex justify-end gap-3 pt-2">

                                            <button type="button" id="cancelBtn"
                                                class="hidden px-6 py-3 border border-gray-300 rounded-lg text-sm">
                                                Cancel
                                            </button>

                                            <button type="submit" id="saveBtn" disabled
                                                class="px-10 py-3.5 bg-brand text-white opacity-50 cursor-not-allowed rounded-lg text-sm">
                                                Save Changes
                                            </button>

                                        </div>
                                    </form>
                                </div>
                            </div>



                        </section>

                        <!-- Change Password Section -->
                        <section class="border border-gray-100 rounded-xl overflow-hidden shadow-sm max-w-4xl mx-11">
                            <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/80">
                                <h3 class="text-xs font-bold text-gray-500 tracking-widest uppercase">Change Password
                                </h3>
                            </div>

                            <div class="p-6 sm:p-8">
                                <form id="passwordForm" action="/profile/changePassword" method="POST"
                                    class="space-y-6 max-w-xl">
                                    <div class="space-y-1.5">
                                        <label for="currentPassword"
                                            class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Current
                                            Password</label>
                                        <div class="relative">
                                            <input type="password" id="currentPassword" name="currentPassword"
                                                class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition pr-10">
                                            <button type="button"
                                                class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                                aria-label="Toggle password visibility">
                                                <i class="ph ph-eye text-xl"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="space-y-1.5">
                                        <label for="newPassword"
                                            class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">New
                                            Password</label>
                                        <div class="relative">
                                            <input type="password" id="newPassword" placeholder="6+ characters"
                                                name="newPassword"
                                                class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition pr-10">
                                            <button type="button"
                                                class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                                aria-label="Toggle password visibility">
                                                <i class="ph ph-eye text-xl"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="space-y-1.5">
                                        <label for="confirmPassword"
                                            class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Confirm
                                            Password</label>
                                        <div class="relative">
                                            <input type="password" id="confirmPassword" placeholder="6+ characters"
                                                name="confirmPassword"
                                                class="w-full border border-gray-200 rounded-lg px-4 py-3 text-gray-800 placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-brand/20 focus:border-brand transition pr-10">
                                            <button type="button"
                                                class="toggle-password absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                                                aria-label="Toggle password visibility">
                                                <i class="ph ph-eye text-xl"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="pt-2">
                                        <button type="button" onclick="submitPasswordForm()"
                                            class="w-full sm:w-auto px-10 py-3.5 bg-brand text-white font-semibold rounded-lg text-sm hover:bg-brand-dark transition-all shadow-md shadow-brand/10 active:scale-95">
                                            Change Password
                                        </button>
                                    </div>
                                </form>
                                <div id="passwordConfirmModal"
                                    class="fixed inset-0 bg-black/50 hidden flex items-center justify-center z-50">

                                    <div class="bg-white p-6 rounded-lg text-center w-[300px]">
                                        <h3 class="text-lg font-semibold mb-3">Confirm Password Change</h3>
                                        <p class="text-sm text-gray-600 mb-4">
                                            Are you sure you want to update your password?
                                        </p>

                                        <div class="flex justify-center gap-3">
                                            <button onclick="submitPasswordForm()"
                                                class="px-4 py-2 bg-green-600 text-white rounded">
                                                Yes
                                            </button>

                                            <button onclick="closePasswordModal()"
                                                class="px-4 py-2 bg-gray-400 text-white rounded">
                                                No
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Spacing for end of scroll -->
                        <div class="h-10 md:hidden"></div>
                    </div>

                    <!-- Footer (Inside main container logic for desktop layout) -->
                    <!-- Footer -->

                </div>
            </div>
        </div>

        <!-- Floating Chat Button -->
        <button
            class="fixed bottom-6 right-6 w-14 h-14 bg-white border border-gray-200 text-gray-800 rounded-full shadow-2xl flex items-center justify-center hover:bg-gray-50 transition-all active:scale-90 z-30">
            <i class="ph ph-chat-centered-text text-2xl"></i>
        </button>
        <script src="https://unpkg.com/lucide@latest"></script>
        <script>

            lucide.createIcons();

            const editBtn = document.getElementById("editBtn");
            const saveBtn = document.getElementById("saveBtn");


            const form = document.querySelector("form[action='/profile']");
            const inputs = form.querySelectorAll("input");
            const cancelBtn = document.getElementById("cancelBtn");

            // store initial values
            const initialData = {};
            inputs.forEach(input => {
                initialData[input.name] = input.value;
            });
            inputs.forEach(input => {
                input.addEventListener("input", () => {
                    saveBtn.disabled = false;
                    saveBtn.innerText = "Save Changes";
                    saveBtn.classList.remove("opacity-50", "cursor-not-allowed");
                });
            });
            console.log(editBtn)
            editBtn.addEventListener("click", () => {
                inputs.forEach(input => input.disabled = false);

                saveBtn.disabled = true;
                saveBtn.classList.add("opacity-50", "cursor-not-allowed");

                cancelBtn.classList.remove("hidden"); 
                editBtn.style.display = "none";
            });
            cancelBtn.addEventListener("click", () => {

               
                inputs.forEach(input => {
                    input.value = initialData[input.name];
                    input.disabled = true;
                });

                // reset buttons
                saveBtn.disabled = true;
                saveBtn.innerText = "Save Changes";
                saveBtn.classList.add("opacity-50", "cursor-not-allowed");

                cancelBtn.classList.add("hidden"); // 
                editBtn.style.display = "block";   // 
            });

            document.addEventListener('DOMContentLoaded', () => {

                // Menu Toggle
                const hamburger = document.getElementById('hamburger');
                const closeMenu = document.getElementById('close-menu');
                const mobileMenu = document.getElementById('mobile-menu');
                const overlay = document.getElementById('mobile-overlay');

                function toggleMenu() {
                    const isOpen = mobileMenu.classList.contains('translate-x-0');
                    if (isOpen) {
                        mobileMenu.classList.remove('translate-x-0');
                        mobileMenu.classList.add('-translate-x-full');
                        overlay.classList.add('hidden');
                        overlay.classList.remove('opacity-100');
                    } else {
                        mobileMenu.classList.add('translate-x-0');
                        mobileMenu.classList.remove('-translate-x-full');
                        overlay.classList.remove('hidden');
                        setTimeout(() => overlay.classList.add('opacity-100'), 10);
                    }
                }

                hamburger.addEventListener('click', toggleMenu);
                closeMenu.addEventListener('click', toggleMenu);
                overlay.addEventListener('click', toggleMenu);

                // Password Toggle
                const toggleButtons = document.querySelectorAll('.toggle-password');
                toggleButtons.forEach(button => {
                    button.addEventListener('click', function () {
                        const input = this.closest('div').querySelector('input');
                        const icon = this.querySelector('i');
                        if (input.type === 'password') {
                            input.type = 'text';
                            icon.classList.replace('ph-eye', 'ph-eye-slash');
                        } else {
                            input.type = 'password';
                            icon.classList.replace('ph-eye-slash', 'ph-eye');
                        }
                    });
                });

                // Adjust height for fixed sidebar effect
                function adjustHeight() {
                    const mainContainer = document.querySelector('.main-container');

                    if (!mainContainer) return;

                    if (window.innerWidth >= 768) {
                        const topBanner = document.getElementById('top-banner');
                        const mainHeader = document.getElementById('main-header');

                        const topH = topBanner ? topBanner.offsetHeight : 0;
                        const headH = mainHeader ? mainHeader.offsetHeight : 0;

                        mainContainer.style.height = `calc(100vh - ${topH + headH}px)`;
                    } else {
                        mainContainer.style.height = 'auto';
                    }
                }
                window.addEventListener('resize', adjustHeight);
                adjustHeight();
            });

            //modal crop

            let cropper;
            let croppedCanvas;

            document.getElementById("profileImage").addEventListener("change", function (e) {
                const file = e.target.files[0];
                if (!file) return;
                if (!file.type.startsWith("image/")) {
                    showToast("Only image files are allowed", "error");
                    this.value = "";
                    return;
                }


                if (file.size > 2 * 1024 * 1024) {
                    showToast("Image must be less than 2MB", "error");
                    this.value = "";
                    return;
                }

                const cropImage = document.getElementById("cropImage");
                const modal = document.getElementById("cropModal");
                const url = URL.createObjectURL(file);

                cropImage.src = url;
                modal.classList.remove("hidden");

                cropImage.onload = () => {
                    console.log(typeof Cropper)
                    if (cropper) cropper.destroy();
                    cropper = new Cropper(cropImage, {
                        aspectRatio: 1,
                        viewMode: 1,
                        dragMode: 'move',

                        autoCropArea: 0.8, 

                        responsive: true,
                        restore: false
                    });
                };
            });

            function showConfirmModal() {
                if (!cropper) return;
                console.log(cropper)
                croppedCanvas = cropper.getCroppedCanvas({
                    width: 300,
                    height: 300
                });
                closeModal();
                document.getElementById("confirmModal").classList.remove("hidden");
            }

            function uploadCroppedImage() {
                const preview = document.getElementById("profilePreview");
                preview.src = croppedCanvas.toDataURL();

                croppedCanvas.toBlob((blob) => {
                    const formData = new FormData();
                    formData.append("profileImage", blob, "cropped.png");
                    fetch("/profile/uploadPhoto", {
                        method: "POST",
                        body: formData
                    })
                        .then(async (res) => {
                            const data = await res.json();

                            if (!res.ok) {
                                return showToast(data.message || "Upload failed", "error");
                            }

                            showToast(data.message || "Image uploaded", "success");
                        })
                        .catch(() => {
                            showToast("Upload error", "error");
                        });
                });

                closeConfirmModal();
                document.getElementById("profileImage").value = "";
            }

            function closeModal() {
                document.getElementById("cropModal").classList.add("hidden");
            }

            function closeConfirmModal() {
                document.getElementById("confirmModal").classList.add("hidden");
            }

            function openPasswordModal() {
                document.getElementById("passwordConfirmModal").classList.remove("hidden");
            }

            function closePasswordModal() {
                document.getElementById("passwordConfirmModal").classList.add("hidden");
            }

            function submitPasswordForm() {
                const form = document.getElementById("passwordForm");


                form.requestSubmit();

                closePasswordModal();
            }
            document.getElementById("phone").addEventListener("input", function (e) {
                this.value = this.value.replace(/\D/g, '').slice(0, 10);
            });

            document.querySelector("form[action='/profile']").addEventListener("submit", async (e) => {
    e.preventDefault();

    const modal = document.getElementById("otpModal");

    
    modal.classList.remove("hidden");
                startTimer()
    showToast("Sending OTP", "success");

    const formData = new FormData(e.target);
    const body = Object.fromEntries(formData.entries());

    try {
        const res = await fetch("/profile", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(body)
        });

        const data = await res.json();

     
        if (!res.ok) {
            modal.classList.add("hidden"); 
            return showToast(data.message, "error");
        }

     
        if (data.requireOtp) {
            showToast(`OTP has been send  `,"success")
            const form = modal.querySelector("form");

            currentOtpFlow = "emailChange";
            form.action = "/profile/verifyEmailChange";
            if (data.reused) {
  showToast("OTP already sent. Please check your email.", "success");
}
            
            return;
        }

        // ✅ normal profile update (NO OTP)
        modal.classList.add("hidden"); // 🔥 close modal if not needed

        showToast("Profile updated successfully", "success");

        saveBtn.disabled = true;

        inputs.forEach(input => input.disabled = true);

        inputs.forEach(input => {
            initialData[input.name] = input.value;
        });

        cancelBtn.classList.add("hidden");
        editBtn.style.display = "block";

    } catch (err) {
        // ❌ network / unexpected error
        modal.classList.add("hidden"); // 🔥 close modal
        saveBtn.disabled = false;
        saveBtn.innerText = "Save Changes";
        showToast("Something went wrong", "error");
    }
});
            document.getElementById("passwordForm").addEventListener("submit", async (e) => {
                e.preventDefault();


                const formData = new FormData(e.target);
                const body = Object.fromEntries(formData.entries());

                try {
                    const res = await fetch("/profile/changePassword", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify(body)
                    });


                    const data = await res.json();

                    if (!res.ok) {
                        return showToast(data.message, "error");
                    }

                    showToast(data.message, "success");
                    e.target.reset();

                } catch (err) {
                    showToast("Something went wrong", "error");
                }
            });
            function showToast(message, type = "success") {
                const toast = document.createElement("div");

                toast.className = `
        fixed top-5 left-1/2 -translate-x-1/2 px-4 py-2 rounded text-white z-50 shadow-lg
        ${type === "error" ? "bg-red-500" : "bg-green-600"}
    `;

                toast.innerText = message;

                document.body.appendChild(toast);

                setTimeout(() => toast.remove(), 3000);
            }
            function startTimer() {
    if (!timerEl || !resendBtn) return;

    clearInterval(interval);
    time = 120;

    resendBtn.disabled = true;
    resendBtn.classList.add("text-gray-400", "cursor-not-allowed");
    resendBtn.classList.remove("text-[#6b7f6a]");

    interval = setInterval(() => {
      time--;

      let minutes = Math.floor(time / 60);
      let seconds = time % 60;
      seconds = seconds < 10 ? "0" + seconds : seconds;

      timerEl.innerText = `${minutes}:${seconds}`;

      if (time <= 0) {
        clearInterval(interval);
        resendBtn.disabled = false;
        resendBtn.classList.remove("text-gray-400", "cursor-not-allowed");
        resendBtn.classList.add("text-[#6b7f6a]");
      }
    }, 1000);
  }
