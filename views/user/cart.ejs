<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Cart - Velvet Vogue</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandGreen: {
                            DEFAULT: '#556B55',
                            hover: '#425242'
                        },
                        primaryText: '#111827',
                        secondaryText: '#6B7280',
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts for Clean Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
        rel="stylesheet">

    <style>
        /* Premium elegant brand font styling */
        .brand-title {
            font-family: 'Playfair Display', Georgia, serif;
        }

        /* Simple custom scrollbar if needed */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #c5cbc5;
            border-radius: 3px;
        }
    </style>
</head>

<body class="bg-white text-primaryText min-h-screen flex flex-col font-sans antialiased selection:bg-brandGreen/20 ">




    <!-- Main Cart Section -->
    <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 flex-grow pb-20">

        <!-- Sub-header: Back Button, Page Title, Continue Shopping Link -->
        <div
            class="flex flex-col sm:flex-row sm:items-center sm:justify-between border-b border-gray-100 pb-6 mb-8 mt-4 gap-4">
            <div class="flex items-center space-x-4">
                <a href="javascript:history.back()"
                    class="text-sm font-medium text-secondaryText hover:text-primaryText transition-colors flex items-center group">
                    <svg class="w-4 h-4 mr-1.5 transform group-hover:-translate-x-0.5 transition-transform" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                    Back
                </a>
                <!-- <h6 class="text-3xl font-bold tracking-tight text-primaryText">Your Cart Product Count <%= cartItemCount %> 
                </h6> -->
            </div>
            <div>
                <a href="/shop"
                    class="text-sm font-medium text-secondaryText hover:text-primaryText transition-colors hover:underline underline-offset-4">
                    Continue Shopping
                </a>
            </div>
        </div>

        <!-- EJS Conditional Logic: Empty Cart State -->
        <% if (items.length===0) { %>
            <div class="text-center py-24 px-4 border border-dashed border-gray-200 rounded-2xl max-w-2xl mx-auto">
                <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                <h2 class="text-xl font-medium text-primaryText mb-1">Your cart is empty</h2>
                <p class="text-secondaryText text-sm mb-6">Looks like you haven't added anything to your cart yet.</p>
                <a href="/shop"
                    class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-md text-white bg-brandGreen hover:bg-brandGreen-hover transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brandGreen">
                    Start Shopping
                </a>
            </div>
            <% } else { %>

                <!-- Two-Column Layout Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

                    <!-- Left Column: Cart Items List (Occupies 7 columns on Desktop) -->
                    <section class="lg:col-span-7 space-y-8">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-2">

                            <h2 class="text-lg font-semibold text-primaryText">
                                Order Summary
                            </h2>
                            <button onclick="openClearCartModal()"
                                class="text-sm text-red-500 hover:text-red-700 font-medium">
                                Clear Cart
                            </button>

                        </div>
                        <% if (cartError) { %>
                            <div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-600">
                                <%= cartError %>
                            </div>
                            <% } %>
                                <div class="divide-y divide-gray-100" id="cart-items-container">
                                    <% items.forEach((item, index)=> { %>
                                        <!-- Cart Item Component -->
                                        <div class="py-6 flex flex-row gap-4 sm:gap-6 group relative"
                                            data-stock="<%= item.availableStock %>"
                                            data-item-id="<%= item.id || 'item-' + index %>"
                                            data-price="<%= item.price %>"
                                            data-invalid="<%= item.isOutOfStock || item.isUnavailable %>">

                                            <!-- Product Image -->
                                            <a href="/shop/product/<%= item.slug %>?variant=<%= item.variantIndex %>"
                                                class="w-24 h-32 sm:w-28 sm:h-36 flex-shrink-0 overflow-hidden rounded-lg bg-gray-50 border border-gray-100 relative group">
                                                <img src="<%= item.image_url %>" alt="<%= item.title %>" class="w-full h-full object-cover object-center group-hover:scale-105 transition duration-300
                                            <%= item.isOutOfStock || item.isUnavailable
                                            ? 'blur-[2px] opacity-60'
                                            : ''
                                            %>" onerror="this.src='https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&q=80&w=400';">
                                                <% if(item.isOutOfStock){ %>

                                                    <div class="absolute inset-0 flex items-center justify-center">

                                                        <span
                                                            class="bg-white/90 text-red-500 px-4 py-2 text-xs font-bold tracking-widest uppercase">

                                                            Out Of Stock

                                                        </span>

                                                    </div>

                                                    <% } %>

                                                        <% if(item.isUnavailable){ %>

                                                            <div
                                                                class="absolute inset-0 flex items-center justify-center">

                                                                <span
                                                                    class="bg-white/90 text-gray-700 px-4 py-2 text-xs font-bold tracking-widest uppercase">

                                                                    Currently Unavailable

                                                                </span>

                                                            </div>

                                                            <% } %>
                                            </a>
                                            <button
                                                class="absolute top-5 right-10 w-9 h-9 rounded-full bg-white shadow flex items-center justify-center hover:bg-gray-50 transition">

                                                <i class="ph ph-heart text-lg"></i>

                                            </button>

                                            <!-- Product Details & Controls -->
                                            <div class="flex-grow flex flex-col justify-between">
                                                <div class="space-y-1 pr-6">
                                                    <div class="flex justify-between items-start">
                                                        <h3 class="text-base font-bold text-primaryText tracking-tight">
                                                            <%= item.title %>
                                                        </h3>

                                                    </div>
                                                    <p class="text-sm text-secondaryText">SKU: <span
                                                            class="text-secondaryText font-small">
                                                            <%= item.slug.toUpperCase() %>
                                                        </span></p>
                                                    <p class="text-sm text-secondaryText">Size: <span
                                                            class="text-primaryText font-medium">
                                                            <%= item.size %>
                                                        </span></p>
                                                    <p class="text-sm text-secondaryText">Color: <span
                                                            class="text-primaryText font-medium">
                                                            <%= item.color %>
                                                        </span></p>
                                                </div>

                                                <!-- Quantity Selector & Price Row -->
                                                <div class="text-xs text-red-500 mt-2 hidden stock-error">
                                                </div>
                                                <div class="flex items-center justify-between mt-4">
                                                    <!-- Dynamic Quantity Selector -->
                                                    <div class="flex items-center border border-gray-200 rounded-md bg-white
                                                    <%= item.isOutOfStock || item.isUnavailable
                                                    ? 'opacity-50 pointer-events-none'
                                                    : ''
                                                    %>"> <button type="button" onclick="decrementQuantity(this)"
                                                            class="px-2.5 py-1.5 text-secondaryText hover:text-primaryText hover:bg-gray-50 transition-colors focus:outline-none"
                                                            aria-label="Decrease quantity">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor"
                                                                viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2.5" d="M20 12H4" />
                                                            </svg>
                                                        </button>
                                                        <span
                                                            class="px-3 py-1 text-sm font-semibold text-primaryText min-w-[2.5rem] text-center select-none quantity-display">
                                                            <%= item.quantity %>
                                                        </span>
                                                        <button type="button" onclick="incrementQuantity(this)"
                                                            class="px-2.5 py-1.5 text-secondaryText hover:text-primaryText hover:bg-gray-50 transition-colors focus:outline-none"
                                                            aria-label="Increase quantity">
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor"
                                                                viewBox="0 0 24 24">
                                                                <path stroke-linecap="round" stroke-linejoin="round"
                                                                    stroke-width="2.5" d="M12 4v16m8-8H4" />
                                                            </svg>
                                                        </button>
                                                    </div>


                                                    <!-- Price Representation -->
                                                    <div class="text-right">

                                                        <% if (!item.isOutOfStock && !item.isUnavailable) { %>



                                                            <% if(item.offer && item.offer.hasOffer){ %>

                                                                <div class="flex items-center justify-end gap-2 mt-1">
                                                                    <span
                                                                        class="inline-flex items-center rounded-full bg-green-100 text-green-700 text-xs font-semibold px-2 py-0.5">
                                                                        <%= item.offer.discountPercentage %>% OFF
                                                                    </span>

                                                                    <span
                                                                        class=" original-item-price text-md text-gray-600 line-through">
                                                                        ₹<%= (item.originalPrice *
                                                                            item.quantity).toLocaleString("en-IN") %>

                                                                    </span>


                                                                </div>

                                                                <% } %>
                                                                    <div
                                                                        class="text-lg font-bold text-primaryText item-total-price">
                                                                        ₹<%= (item.price *
                                                                            item.quantity).toLocaleString("en-IN") %>
                                                                    </div>

                                                                    <% } %>

                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Remove Button (Absolute placed on top right) -->
                                            <button type="button" onclick="removeCartItem('<%= item.id %>',this)"
                                                class="absolute top-6 right-0 p-1 text-gray-400 hover:text-red-500 transition-colors focus:outline-none"
                                                aria-label="Remove item">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor"
                                                    viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                        stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                                                </svg>
                                            </button>

                                        </div>
                                        <% }) %>
                                </div>
                    </section>

                    <!-- Right Column: Order Summary Card (Occupies 5 columns on Desktop) -->
                    <aside class="lg:col-span-5 bg-gray-50/50 rounded-2xl p-6 sm:p-8 border border-gray-100 mt-2">

                        <!-- Decorative Top border alignment mimicking mockup -->
                        <div class="border-t border-gray-200 pt-6">
                            <h2 class="sr-only">Billing Details</h2>

                            <div class="space-y-5">

                                <!-- Subtotal Line item -->
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-secondaryText font-medium" id="subtotal-label">Subtotal (<%=
                                            items.reduce((acc, curr)=> acc + curr.quantity, 0) %>)</span>
                                    <span id="summary-subtotal" class="font-medium  text-base">
                                        ₹<%= subtotal.toLocaleString("en-IN") %>
                                    </span>
                                </div>

                                <!-- Discount Line item -->
                                <div class="flex items-center justify-between text-sm">
                                    <span class="text-secondaryText">Discount</span>
                                    <span class="font-medium text-green-600 text-base" id="summary-discount">-₹<%= offerDiscount.toLocaleString("en-IN") %></span>
                                </div>

                                <!-- Shipping Line item -->
                                <div class="flex items-center justify-between text-sm pb-4 border-b border-gray-100">
                                    <span class="text-secondaryText">Shipping</span>
                                    <span class="font-medium text-primaryText" id="summary-shipping">
                                        <%= shipping===0 ? 'Free' : '₹' + shipping.toLocaleString("en-IN") %>
                                    </span>
                                </div>

                                <!-- Grand Total Line item -->
                                <div class="flex items-center justify-between pt-2">
                                    <span class="text-base font-medium text-primaryText">Total :</span>
                                    <span id="summary-grandtotal">
                                        ₹<%= grandTotal.toLocaleString("en-IN") %>
                                    </span>
                                </div>
                                <% const hasInvalidItems=items.some( item=> item.isOutOfStock || item.isUnavailable
                                    );
                                    %>
                                    <div id="checkout-error" class="<%= hasInvalidItems ? '' : 'hidden' %> mb-4">

                                        <div
                                            class="flex items-start gap-2 p-4 rounded-lg border border-red-200 bg-red-50">

                                            <i class="ph-fill ph-warning-circle text-red-500 text-lg"></i>

                                            <p class="text-sm text-red-600">
                                                Some items in your cart are unavailable. Remove them to continue
                                                checkout.
                                            </p>

                                        </div>

                                    </div>
                                    <!-- Checkout Button Action Container -->
                                    <a href="/shop/checkout">
                                        <div class="pt-6">
                                            <button id="checkout-btn" type="button" <%=hasInvalidItems ? "disabled" : ""
                                                %>

                                                onclick="<%= hasInvalidItems ? '' : 'triggerCheckout()' %>"

                                                    class="w-full py-4 px-6 rounded-md font-medium tracking-wide
                                                    text-sm uppercase transition-all

                                                    <%= hasInvalidItems ? 'bg-gray-300 text-gray-500 cursor-not-allowed'
                                                        : 'bg-brand hover:bg-brand-dark text-white' %>">

                                                        Checkout

                                            </button>

                                        </div>
                                    </a>

                            </div>
                        </div>
                    </aside>

                </div>
                <% } %>
                    <!-- Clear Cart Modal -->
                    <div id="clear-cart-modal"
                        class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4">

                        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl">

                            <div class="text-center">

                                <div
                                    class="mx-auto flex items-center justify-center w-14 h-14 rounded-full bg-red-100 mb-4">

                                    <svg class="w-7 h-7 text-red-500" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">

                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7L5 7M10 11V17M14 11V17M6 7L7 19C7.1 20.1 7.9 21 9 21H15C16.1 21 16.9 20.1 17 19L18 7M9 7V5C9 3.9 9.9 3 11 3H13C14.1 3 15 3.9 15 5V7">
                                        </path>

                                    </svg>

                                </div>

                                <h3 class="text-xl font-semibold text-gray-900 mb-2">
                                    Clear Cart?
                                </h3>

                                <p class="text-sm text-gray-500 mb-6">
                                    Remove all items from your cart?
                                    This action cannot be undone.
                                </p>

                                <div class="flex gap-3">

                                    <button onclick="closeClearCartModal()"
                                        class="flex-1 border border-gray-300 text-gray-700 py-3 rounded-lg hover:bg-gray-50 transition">

                                        Cancel

                                    </button>

                                    <button onclick="clearCart()"
                                        class="flex-1 bg-red-500 text-white py-3 rounded-lg hover:bg-red-600 transition">

                                        Yes, Clear

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>

    </main>

    <!-- Interactive Feedback Overlay Modal (Replacing browser alert) -->


    <!-- Real-Time Client Side Interactivity Logic -->
    <script>

        function clearAll() {

        }
        const offerDiscountVal = parseFloat("<%= offerDiscount %>") || 0;
        const shippingVal = parseFloat("<%= shipping %>") || 0;

        // Recalculates all cart math in real time dynamically
        function updateCartCalculations(data = null) {

            if (!data) return;

            document.getElementById("subtotal-label").textContent =
                `Subtotal (${data.cartCount})`;

            document.getElementById("summary-subtotal").textContent =
                `₹${Number(data.subtotal || 0).toLocaleString("en-IN")}`;

            document.getElementById("summary-discount").textContent =
                `-₹${Number(data.offerDiscount || 0).toLocaleString("en-IN")}`;

            document.getElementById("summary-shipping").textContent =
                Number(data.shipping || 0) === 0
                    ? "Free"
                    : `₹${Number(data.shipping).toLocaleString("en-IN")}`;

            document.getElementById("summary-grandtotal").textContent =
                `₹${Number(data.grandTotal || 0).toLocaleString("en-IN")}`;
        }
        function updateCheckoutState() {

            const invalidItems =
                document.querySelectorAll(
                    "[data-invalid='true']"
                );

            const errorBox =
                document.getElementById(
                    "checkout-error"
                );

            const checkoutBtn =
                document.getElementById(
                    "checkout-btn"
                );

            if (invalidItems.length > 0) {

                errorBox.classList.remove("hidden");

                checkoutBtn.disabled = true;

                checkoutBtn.onclick = null;

                checkoutBtn.classList.remove(
                    "bg-brandGreen",
                    "hover:bg-brandGreen-hover",
                    "text-white"
                );

                checkoutBtn.classList.add(
                    "bg-gray-300",
                    "text-gray-500",
                    "cursor-not-allowed"
                );

            } else {

                errorBox.classList.add("hidden");

                checkoutBtn.disabled = false;

                checkoutBtn.onclick = checkoutBtn.onclick = () => {
                    window.location.href = "/shop/checkout";
                }

                checkoutBtn.classList.remove(
                    "bg-gray-300",
                    "text-gray-500",
                    "cursor-not-allowed"
                );

                checkoutBtn.classList.add(
                    "bg-brand", "hover:bg-brand-dark",
                    "text-white"
                );
            }
        }
        function updateCartItemUI(itemRow, data) {

            const qtyDisplay =
                itemRow.querySelector(".quantity-display");

            if (qtyDisplay) {
                qtyDisplay.textContent = data.quantity;
            }

            const itemTotalElement =
                itemRow.querySelector(".item-total-price");

            if (itemTotalElement) {
                itemTotalElement.textContent =
                    `₹${Number(data.itemTotal || 0).toLocaleString("en-IN")}`;
            }

            const originalPriceElement =
                itemRow.querySelector(".original-item-price");

            if (originalPriceElement) {
                originalPriceElement.textContent =
                    `₹${Number(data.originalItemTotal || 0).toLocaleString("en-IN")}`;
            }

            updateCartCalculations(data);

            updateCartBadge(data.cartCount);
        }

        // Handles decrement action clicks safely
        async function decrementQuantity(button) {

    const itemRow = button.closest("[data-item-id]");

    if (!itemRow) return;

    const itemId = itemRow.dataset.itemId;

    const qtyDisplay =
        itemRow.querySelector(".quantity-display");

    const currentQty =
        parseInt(qtyDisplay.textContent) || 1;

    if (currentQty <= 1) {
        return;
    }

    try {

        const response = await fetch(
            "/shop/cart/updateQuantity",
            {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    itemId,
                    action: "decrement"
                })
            }
        );

        const data = await response.json();

        if (data.loginRequired) {
            window.location.href = "/login";
            return;
        }

        if (!data.success) {

            const errorBox =
                itemRow.querySelector(".stock-error");

            if (errorBox) {
                errorBox.textContent = data.message;
                errorBox.classList.remove("hidden");

                setTimeout(() => {
                    errorBox.classList.add("hidden");
                }, 3000);
            }

            return;
        }

        // Update quantity
        qtyDisplay.textContent = data.quantity;

        // Update item total
        const itemTotal =
            itemRow.querySelector(".item-total-price");

        if (itemTotal) {
            itemTotal.textContent =
                `₹${Number(data.itemTotal || 0).toLocaleString("en-IN")}`;
        }

        // Update original price only when the element exists
        const originalPrice =
            itemRow.querySelector(".original-item-price");

        if (originalPrice) {
            originalPrice.textContent =
                `₹${Number(data.originalItemTotal || 0).toLocaleString("en-IN")}`;
        }

        // Update subtotal, offer discount, shipping and grand total
        updateCartCalculations(data);

        // Update navbar cart badge
        updateCartBadge(data.cartCount);

    } catch (error) {

        console.error("Decrease quantity error:", error);

        showToast(
            "Unable to update quantity.",
            "error"
        );
    }
}

        // Handles increment action clicks safely
        async function incrementQuantity(button) {

            const itemRow =
                button.closest("[data-item-id]");

            const itemId =
                itemRow.dataset.itemId;

            try {

                const response = await fetch(
                    "/shop/cart/updateQuantity",
                    {
                        method: "PATCH",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            itemId,
                            action: "increment"
                        })
                    }
                );

                const data = await response.json();

                if (data.loginRequired) {
                    window.location.href = "/login";
                    return;
                }

                if (!data.success) {

                    const errorBox =
                        itemRow.querySelector(".stock-error");

                    if (errorBox) {
                        errorBox.textContent = data.message;
                        errorBox.classList.remove("hidden");

                        setTimeout(() => {
                            errorBox.classList.add("hidden");
                        }, 3000);
                    }

                    return;
                }

                updateCartItemUI(itemRow, data);

            } catch (error) {

                console.error(
                    "Increase quantity error:",
                    error
                );

                showToast(
                    "Unable to update quantity.",
                    "error"
                );
            }
        }
        // Animates and removes item element from UI
        async function removeCartItem(itemId, button) {

            try {

                const response = await fetch(
                    `/shop/cart/remove/${itemId}`,
                    {
                        method: "DELETE"
                    }
                );

                const data = await response.json();

                if (!data.success) return;
                const itemRow =
                    button.closest("[data-item-id]");
                itemRow.style.transition =
                    "all .4s ease";

                itemRow.style.opacity = "0";

                itemRow.style.transform =
                    "translateX(20px)";

                setTimeout(() => {

                    itemRow.remove();
                    const remainingItems = document.querySelectorAll("[data-item-id]");

                    if (remainingItems.length === 0) {
                        location.reload();
                        return;
                    }



                    updateCartCalculations(data)
                    updateCartBadge(data.cartCount)
                    updateCheckoutState();

                }, 400)


            } catch (error) {

                console.log(error);

            }
        }

        // Modal Trigger for elegant Checkout feedback

        async function clearCart() {


            try {
                const response = await fetch("/shop/cart/clear", { method: "DELETE" })

                const data = await response.json()

                if (data.success) {

                    window.location.reload()

                } else {
                    showToast("removing cart items failed", "error")
                }
            } catch (error) {
                console.log("clear cart error: ", error)
            }
        }


        function showToast(message, type = "success") {
            const toast = document.createElement("div");

            toast.className = `
        fixed top-5 left-1/2 -translate-x-1/2 px-4 py-2 rounded text-white z-50 shadow-lg
        ${type === "error" ? "bg-red-500" : "bg-green-600"}
    `;

            toast.innerText = message;

            document.body.appendChild(toast);

            setTimeout(() => toast.remove(), 3000);
        }

        function openClearCartModal() {

            const modal =
                document.getElementById(
                    "clear-cart-modal"
                );

            modal.classList.remove("hidden");
            modal.classList.add("flex");
        }

        function closeClearCartModal() {

            const modal =
                document.getElementById(
                    "clear-cart-modal"
                );

            modal.classList.add("hidden");
            modal.classList.remove("flex");
        }

        // Initial Execution to compute subtotals perfectly on load
        document.addEventListener('DOMContentLoaded', () => {

            updateCheckoutState()
        });
    </script>
</body>

</html>