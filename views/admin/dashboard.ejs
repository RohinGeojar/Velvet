<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue | Admin Dashboard</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F9FAFB;
        }

        .bg-brand {
            background-color: #8B5E3C;
        }

        .sidebar-active {
            background-color: #8B5E3C;
            color: white;
        }

        .status-paid {
            background-color: #DCFCE7;
            color: #15803D;
        }

        .status-pending {
            background-color: #FEF3C7;
            color: #D97706;
        }

        .status-refunded {
            background-color: #FEE2E2;
            color: #DC2626;
        }
    </style>
</head>

<body class="flex min-h-screen text-gray-800">

    <!-- Sidebar -->
    <%- include("../partials/admin/adminSidebar") %>

        <!-- Main Content -->
        <main class="flex-1 flex flex-col overflow-hidden min-w-0">

            <!-- Top Header -->
            <header class="h-20 bg-white border-b border-gray-100 flex items-center justify-between px-8">
                <div class="relative w-96">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </span>
                    <input type="text" placeholder="Search anything..."
                        class="w-full bg-gray-50 border-none rounded-full py-2.5 pl-11 focus:ring-2 focus:ring-[#8B5E3C]/20 text-sm">
                </div>

                <div class="flex items-center gap-6">
                    <button class="relative p-2 text-gray-400 hover:text-gray-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                            </path>
                        </svg>
                        <span
                            class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    <div class="flex items-center gap-3 pl-6 border-l border-gray-100">
                        <div class="text-right">
                            <p class="text-sm font-semibold text-gray-900 leading-tight">Admin User</p>
                            <p class="text-xs text-gray-500">Super Admin</p>
                        </div>
                        <div
                            class="w-10 h-10 rounded-full bg-emerald-200 overflow-hidden border border-gray-100 flex items-center justify-center">
                            <span class="text-emerald-700 font-bold">AU</span>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Dashboard Body -->
            <div class="flex-1 overflow-y-auto p-8">
                <div class="mb-8 text-left">
                    <nav class="flex text-xs text-gray-400 mb-2 gap-1 uppercase tracking-wider font-semibold">
                        <span>Dashboard</span>
                        <span>/</span>
                        <span class="text-[#8B5E3C]">Overview</span>
                    </nav>
                    <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
                </div>

                <!-- KPI Cards -->
                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6 mb-8">
                    <!-- Revenue -->
                    <div
                        class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z">
                                    </path>
                                </svg>
                            </div>
                            <span
                                class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">Live</span>
                        </div>
                        <p class="text-xs font-medium text-gray-500 mb-1">Total Revenue</p>
                        <p id="kpiRevenue" class="text-2xl font-bold text-gray-900 leading-none">₹0</p>
                    </div>
                    <!-- Orders -->
                    <div
                        class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                                    </path>
                                </svg>
                            </div>
                            <span
                                class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">Live</span>
                        </div>
                        <p class="text-xs font-medium text-gray-500 mb-1">Total Orders</p>
                        <p id="kpiOrders" class="text-2xl font-bold text-gray-900 leading-none">0</p>
                    </div>
                    <!-- Products -->
                    <div
                        class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                                </svg>
                            </div>
                            <span
                                class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">Active</span>
                        </div>
                        <p class="text-xs font-medium text-gray-500 mb-1">Total Products</p>
                        <p id="kpiProducts" class="text-2xl font-bold text-gray-900 leading-none">0</p>
                    </div>
                    <!-- Users -->
                    <div
                        class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
                                    </path>
                                </svg>
                            </div>
                            <span
                                class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">Total</span>
                        </div>
                        <p class="text-xs font-medium text-gray-500 mb-1">Total Users</p>
                        <p id="kpiUsers" class="text-2xl font-bold text-gray-900 leading-none">0</p>
                    </div>
                    <!-- Offers -->
                    <div
                        class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex justify-between items-start mb-4">
                            <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z">
                                    </path>
                                </svg>
                            </div>
                            <span
                                class="text-xs font-bold text-[#8B5E3C] bg-orange-50 px-2 py-1 rounded-full">Active</span>
                        </div>
                        <p class="text-xs font-medium text-gray-500 mb-1">Active Offers</p>
                        <p id="kpiOffers" class="text-2xl font-bold text-gray-900 leading-none">0</p>
                    </div>
                </div>

                <!-- Charts Row -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
                    <!-- Sales Overview Chart -->
                    <div
                        class="lg:col-span-2 bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm flex flex-col justify-between">
                        <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
                            <div>
                                <h3 class="text-lg font-bold text-left">Sales Overview</h3>
                                <p class="text-xs text-gray-400">Revenue aggregated by filter</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <select id="timeFilter" onchange="handleFilterChange()"
                                    class="text-xs font-semibold text-gray-700 bg-gray-50 px-4 py-2 rounded-xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-[#8B5E3C]/20">
                                    <option value="yearly" selected>Yearly</option>
                                    <option value="monthly">Monthly</option>
                                    <option value="weekly">Weekly</option>
                                    <option value="daily">Daily</option>
                                    <option value="custom">Custom Range</option>
                                </select>
                            </div>
                        </div>

                        <!-- Custom Date Selection -->
                        <div id="customDateBox"
                            class="hidden flex items-center gap-3 mb-4 p-3 bg-gray-50 rounded-xl border border-gray-100">
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-medium text-gray-500">From:</label>
                                <input type="date" id="startDate"
                                    class="text-xs bg-white border border-gray-200 rounded-lg px-2.5 py-1.5">
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-medium text-gray-500">To:</label>
                                <input type="date" id="endDate"
                                    class="text-xs bg-white border border-gray-200 rounded-lg px-2.5 py-1.5">
                            </div>
                            <button onclick="fetchDashboardData()"
                                class="text-xs font-semibold bg-[#8B5E3C] text-white px-4 py-1.5 rounded-lg hover:bg-[#724a2e] transition">Apply</button>
                        </div>

                        <div class="relative h-64 w-full">
                            <canvas id="salesChart"></canvas>
                        </div>
                    </div>

                    <!-- Orders Analytics -->
                    <div class="bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm">
                        <h3 class="text-lg font-bold mb-8 text-left">Orders Summary</h3>
                        <div class="space-y-6 mb-8">
                            <div>
                                <div class="flex justify-between text-sm mb-2 font-medium">
                                    <span class="text-gray-600">Confirmed / Delivered</span>
                                    <span class="text-gray-900 font-semibold" id="pctConfirmed">100%</span>
                                </div>
                                <div class="w-full h-2 bg-gray-50 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full bg-emerald-500" style="width: 100%"></div>
                                </div>
                            </div>
                            <div>
                                <div class="flex justify-between text-sm mb-2 font-medium">
                                    <span class="text-gray-600">Valid Transactions</span>
                                    <span class="text-gray-900 font-semibold">Active</span>
                                </div>
                                <div class="w-full h-2 bg-gray-50 rounded-full overflow-hidden">
                                    <div class="h-full rounded-full bg-[#8B5E3C]" style="width: 100%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-10 p-5 bg-[#FDFBF9] rounded-2xl border border-orange-50 flex items-center gap-4">
                            <div class="p-2 bg-white rounded-lg shadow-sm">
                                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                </svg>
                            </div>
                            <div class="text-left">
                                <p class="text-sm font-bold text-gray-900">Real-Time Data</p>
                                <p class="text-xs text-gray-500 font-medium">Synced directly with MongoDB</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top 10 Best Sellers Section -->
                <div class="bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm mb-8">
                    <div class="flex flex-wrap justify-between items-center mb-6 border-b border-gray-100 pb-4 gap-4">
                        <div>
                            <h3 id="tagHead" class="text-lg font-bold">Top 10 Products</h3>
                            <p class="text-xs text-gray-400">Calculated from actual completed order sales</p>
                        </div>
                        <!-- Tabs -->
                        <div class="flex bg-gray-100 p-1 rounded-xl">
                            <button id="tabBtnProducts" onclick="switchTopTab('products')"
                                class="px-4 py-2 text-xs font-semibold rounded-lg bg-white shadow-xs text-gray-900 transition">
                                Products
                            </button>

                            <button id="tabBtnCategories" onclick="switchTopTab('categories')"
                                class="px-4 py-2 text-xs font-semibold rounded-lg text-gray-500 hover:text-gray-900 transition">
                                Categories
                            </button>

                            <!-- <button id="tabBtnBrands" onclick="switchTopTab('brands')"
                                class="px-4 py-2 text-xs font-semibold rounded-lg text-gray-500 hover:text-gray-900 transition">
                                Brands
                            </button> -->
                        </div>
                    </div>

                    <!-- Products Table -->
                    <div id="topProductsContainer" class="overflow-x-auto">
                        <table class="w-full">
                            <thead
                                class="bg-gray-50/50 rounded-xl text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">
                                <tr>
                                    <th class="px-4 py-3">#</th>
                                    <th class="px-4 py-3">Product Name</th>
                                    <th class="px-4 py-3">Quantity Sold</th>
                                    <th class="px-4 py-3">Total Revenue</th>
                                </tr>
                            </thead>
                            <tbody id="topProductsTable" class="text-sm text-left divide-y divide-gray-50">
                                <tr>
                                    <td colspan="4" class="px-4 py-6 text-center text-gray-400 text-xs">Loading
                                        best-selling products...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Categories Table -->
                    <div id="topCategoriesContainer" class="hidden overflow-x-auto">
                        <table class="w-full">
                            <thead
                                class="bg-gray-50/50 rounded-xl text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">
                                <tr>
                                    <th class="px-4 py-3">#</th>
                                    <th class="px-4 py-3">Category Name</th>
                                    <th class="px-4 py-3">Quantity Sold</th>
                                    <th class="px-4 py-3">Total Revenue</th>
                                </tr>
                            </thead>
                            <tbody id="topCategoriesTable" class="text-sm text-left divide-y divide-gray-50">
                                <tr>
                                    <td colspan="4" class="px-4 py-6 text-center text-gray-400 text-xs">Loading
                                        best-selling categories...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Brands Table -->
                    <div id="topBrandsContainer" class="hidden overflow-x-auto">
                        <table class="w-full">
                            <thead
                                class="bg-gray-50/50 rounded-xl text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">
                                <tr>
                                    <th class="px-4 py-3">#</th>
                                    <th class="px-4 py-3">Brand Name</th>
                                    <th class="px-4 py-3">Quantity Sold</th>
                                    <th class="px-4 py-3">Total Revenue</th>
                                </tr>
                            </thead>
                            <tbody id="topBrandsTable" class="text-sm text-left divide-y divide-gray-50">
                                <tr>
                                    <td colspan="4" class="px-4 py-6 text-center text-gray-400 text-xs">Loading
                                        best-selling brands...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>

                <!-- Bottom Row: Recent Orders -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                    <div class="lg:col-span-3 bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm">
                        <div class="flex justify-between items-center mb-8">
                            <h3 class="text-lg font-bold">Recent Orders</h3>
                            <a href="/orderManagement"
                                class="text-xs font-bold text-[#8B5E3C] hover:underline underline-offset-4">View All
                                Orders</a>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead
                                    class="bg-gray-50/50 rounded-xl text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">
                                    <tr>
                                        <th class="px-4 py-4">Order ID</th>
                                        <th class="px-4 py-4">Customer</th>
                                        <th class="px-4 py-4">Amount</th>
                                        <th class="px-4 py-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="recentOrdersTable" class="text-sm text-left divide-y divide-gray-50">
                                    <tr>
                                        <td colspan="4" class="px-4 py-6 text-center text-gray-400 text-xs">Loading
                                            recent orders...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script>
            let salesChartInstance = null;

            function handleFilterChange() {
                const filter = document.getElementById("timeFilter").value;
                const customBox = document.getElementById("customDateBox");
                if (filter === "custom") {
                    customBox.classList.remove("hidden");
                } else {
                    customBox.classList.add("hidden");
                    fetchDashboardData();
                }
            }

            

            async function fetchDashboardData() {
    try {
        const filter = document.getElementById("timeFilter").value
        const startDate = document.getElementById("startDate").value
        const endDate = document.getElementById("endDate").value

        let url = `/dashboard/data?filter=${filter}`

        if (filter === "custom" && startDate && endDate) {
            url += `&startDate=${startDate}&endDate=${endDate}`
        }

        const res = await fetch(url)
        const result = await res.json()

        console.log("Dashboard response:", result)

        if (result.success && result.data) {
     
            renderChart(result.data.salesData)
            renderKPIs(result.data.summaryStats)
            renderTopProducts(result.data.bestProducts)
            renderTopCategories(result.data.bestCategories)
            renderTopBrands(result.data.bestBrands)
            renderRecentOrders(result.data.recentOrders)
        }
      
    } catch (err) {
        console.error("Failed to fetch dashboard data:", err)
    }
}

            function renderChart(salesData) {
                if (!salesData || !Array.isArray(salesData)) return

                const labels = salesData.map(item => item.label)
                const dataValues = salesData.map(item => item.sales)
                const ctx = document.getElementById("salesChart").getContext("2d")

                if (salesChartInstance) salesChartInstance.destroy()

                salesChartInstance = new Chart(ctx, {
                    type: "line",
                    data: {
                        labels,
                        datasets: [{
                            label: "Sales Revenue",
                            data: dataValues,
                            borderColor: "#8B5E3C",
                            backgroundColor: "rgba(139, 94, 60, 0.08)",
                            fill: true,
                            tension: 0.4,
                            borderWidth: 2,
                            pointRadius: 3,
                            pointHoverRadius: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: context => "₹" + context.parsed.y.toLocaleString("en-IN")
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: "#F3F4F6" },
                                ticks: {
                                    callback: value => "₹" + value.toLocaleString("en-IN")
                                }
                            },
                            x: {
                                grid: { display: false }
                            }
                        }
                    }
                })
            }
            function switchTopTab(tab) {
                const prodCont = document.getElementById("topProductsContainer")
                const catCont = document.getElementById("topCategoriesContainer")
                const brandCont = document.getElementById("topBrandsContainer")
                const prodBtn = document.getElementById("tabBtnProducts")
                const catBtn = document.getElementById("tabBtnCategories")
                const brandBtn = document.getElementById("tabBtnBrands")
                const tagHead = document.getElementById("tagHead")

                if (prodCont) prodCont.classList.add("hidden")
                if (catCont) catCont.classList.add("hidden")
                if (brandCont) brandCont.classList.add("hidden")

                if (prodBtn) prodBtn.className = "px-4 py-2 text-xs font-semibold rounded-lg text-gray-500 hover:text-gray-900 transition"
                if (catBtn) catBtn.className = "px-4 py-2 text-xs font-semibold rounded-lg text-gray-500 hover:text-gray-900 transition"
                if (brandBtn) brandBtn.className = "px-4 py-2 text-xs font-semibold rounded-lg text-gray-500 hover:text-gray-900 transition"

                if (tab === "products") {
                    tagHead.textContent = "Top 10 Products"
                    if (prodCont) prodCont.classList.remove("hidden")
                    if (prodBtn) prodBtn.className = "px-4 py-2 text-xs font-semibold rounded-lg bg-white shadow-xs text-gray-900 transition"
                } else if (tab === "categories") {
                    tagHead.textContent = "Top 10 Categories"
                    if (catCont) catCont.classList.remove("hidden")
                    if (catBtn) catBtn.className = "px-4 py-2 text-xs font-semibold rounded-lg bg-white shadow-xs text-gray-900 transition"
                } else if (tab === "brands") {
                    if (brandCont) brandCont.classList.remove("hidden")
                    if (brandBtn) brandBtn.className = "px-4 py-2 text-xs font-semibold rounded-lg bg-white shadow-xs text-gray-900 transition"
                }
            }


            function renderKPIs(stats) {
                if (!stats) return;
                document.getElementById("kpiRevenue").textContent = '₹' + (stats.totalRevenue || 0).toLocaleString('en-IN');
                document.getElementById("kpiOrders").textContent = (stats.totalOrders || 0).toLocaleString('en-IN');
                document.getElementById("kpiProducts").textContent = (stats.totalProducts || 0).toLocaleString('en-IN');
                document.getElementById("kpiUsers").textContent = (stats.totalUsers || 0).toLocaleString('en-IN');
                document.getElementById("kpiOffers").textContent = (stats.activeOffers || 0).toLocaleString('en-IN');
            }

            function renderTopProducts(products) {
                const table = document.getElementById("topProductsTable");
                if (!products || products.length === 0) {
                    table.innerHTML = `<tr><td colspan="4" class="px-4 py-5 text-center text-gray-400 text-xs">No sales data found</td></tr>`;
                    return;
                }
                table.innerHTML = products.map((item, index) => `
                <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="px-4 py-4 font-bold text-[#8B5E3C]">${index + 1}</td>
                    <td class="px-4 py-4 font-semibold text-gray-800">${item.productName || 'Unknown Product'}</td>
                    <td class="px-4 py-4 font-medium text-gray-600">${item.totalSold || 0} pcs</td>
                    <td class="px-4 py-4 font-bold text-gray-900">₹${(item.revenue || 0).toLocaleString('en-IN')}</td>
                </tr>
            `).join('');
            }

            function renderTopCategories(categories) {
                const table = document.getElementById("topCategoriesTable");
                if (!categories || categories.length === 0) {
                    table.innerHTML = `<tr><td colspan="4" class="px-4 py-5 text-center text-gray-400 text-xs">No sales data found</td></tr>`;
                    return;
                }
                table.innerHTML = categories.map((item, index) => `
                <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="px-4 py-4 font-bold text-[#8B5E3C]">${index + 1}</td>
                    <td class="px-4 py-4 font-semibold text-gray-800">${item.categoryName || 'Unknown Category'}</td>
                    <td class="px-4 py-4 font-medium text-gray-600">${item.totalSold || 0} pcs</td>
                    <td class="px-4 py-4 font-bold text-gray-900">₹${(item.revenue || 0).toLocaleString('en-IN')}</td>
                </tr>
            `).join('');
            }

            function renderTopBrands(brands) {
                const table = document.getElementById("topBrandsTable");
                if (!brands || brands.length === 0) {
                    table.innerHTML = `<tr><td colspan="4" class="px-4 py-5 text-center text-gray-400 text-xs">No sales data found</td></tr>`;
                    return;
                }
                table.innerHTML = brands.map((item, index) => `
                <tr class="hover:bg-gray-50/50 transition-colors">
                    <td class="px-4 py-4 font-bold text-[#8B5E3C]">${index + 1}</td>
                    <td class="px-4 py-4 font-semibold text-gray-800">${item.brandName || 'Velvet Vogue'}</td>
                    <td class="px-4 py-4 font-medium text-gray-600">${item.totalSold || 0} pcs</td>
                    <td class="px-4 py-4 font-bold text-gray-900">₹${(item.revenue || 0).toLocaleString('en-IN')}</td>
                </tr>
            `).join('');
            }

function renderRecentOrders(orders) {
    const table = document.getElementById("recentOrdersTable")

    console.log("Recent orders received:", orders)
    console.log("Is array:", Array.isArray(orders))

    if (!Array.isArray(orders) || orders.length === 0) {
        table.innerHTML = `<tr><td colspan="4" class="px-4 py-5 text-center text-gray-400 text-xs">No recent orders</td></tr>`
        return
    }

    table.innerHTML = orders.map(order => {
        const customerName = order.userId ? `${order.userId.firstName || ""} ${order.userId.lastName || ""}`.trim() : "Guest"

        const statusClass = order.paymentStatus === "Paid" ? "status-paid" : order.paymentStatus === "Refunded" ? "status-refunded" : "status-pending"

        return `
            <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="px-4 py-4 font-semibold text-gray-700">${order.orderId || order._id}</td>
                <td class="px-4 py-4 font-medium text-gray-900">${customerName}</td>
                <td class="px-4 py-4 font-bold text-gray-900">₹${(order.grandTotal || 0).toLocaleString("en-IN")}</td>
                <td class="px-4 py-4">
                    <span class="px-3 py-1 rounded-full text-[10px] font-black tracking-wider uppercase ${statusClass}">
                        ${order.paymentStatus || "PENDING"}
                    </span>
                </td>
            </tr>
        `
    }).join("")
}

