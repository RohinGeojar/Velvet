<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue | Admin Dashboard</title>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F9FAFB; }
         .bg-brand { background-color: #8B5E3C;}
        .sidebar-active { background-color: #8B5E3C; color: white; }
        .status-paid { background-color: #DCFCE7; color: #15803D; }
        .status-pending { background-color: #FEF3C7; color: #D97706; }
        .status-refunded { background-color: #FEE2E2; color: #DC2626; }
        /* Custom bar chart styling to match the image colors */
        .bar-color { background-color: #D2B48C; opacity: 0.6; }
        .bar-color-active { background-color: #8B5E3C; opacity: 1; }
    </style>
</head>
<body class="flex min-h-screen text-gray-800">

    <!-- Sidebar -->
    <%- include("../partials/admin/adminSidebar") %>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col overflow-hidden min-w-0 ">
        
        <!-- Top Header -->
        <header class="h-20 bg-white border-b border-gray-100 flex items-center justify-between px-8">
            <div class="relative w-96">
                <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                </span>
                <input type="text" placeholder="Search anything..." class="w-full bg-gray-50 border-none rounded-full py-2.5 pl-11 focus:ring-2 focus:ring-[#8B5E3C]/20 text-sm">
            </div>

            <div class="flex items-center gap-6">
                <button class="relative p-2 text-gray-400 hover:text-gray-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
                    <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                </button>
                <div class="flex items-center gap-3 pl-6 border-l border-gray-100">
                    <div class="text-right">
                        <p class="text-sm font-semibold text-gray-900 leading-tight">Admin User</p>
                        <p class="text-xs text-gray-500">Super Admin</p>
                    </div>
                    <div class="w-10 h-10 rounded-full bg-emerald-200 overflow-hidden border border-gray-100 flex items-center justify-center">
                        <span class="text-emerald-700 font-bold">AU</span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Dashboard Body -->
        <div class="flex-1 overflow-y-auto p-8">
            <div class="mb-8 text-left">
                <nav class="flex text-xs text-gray-400 mb-2 gap-1 uppercase tracking-wider font-semibold">
                    <span>Dashboard</span>
                    <span>/</span>
                    <span class="text-[#8B5E3C]">Overview</span>
                </nav>
                <h1 class="text-2xl font-bold text-gray-900">Admin Dashboard</h1>
            </div>

            <!-- KPI Cards -->
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6 mb-8">
                <!-- Revenue -->
                <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>
                        <span class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">+12%</span>
                    </div>
                    <p class="text-xs font-medium text-gray-500 mb-1">Total Revenue</p>
                    <p class="text-2xl font-bold text-gray-900 leading-none">$128,430</p>
                </div>
                <!-- Orders -->
                <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                        </div>
                        <span class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">+5%</span>
                    </div>
                    <p class="text-xs font-medium text-gray-500 mb-1">Total Orders</p>
                    <p class="text-2xl font-bold text-gray-900 leading-none">1,240</p>
                </div>
                <!-- Products -->
                <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                        </div>
                        <span class="text-xs font-bold text-gray-400 bg-gray-50 px-2 py-1 rounded-full">Static</span>
                    </div>
                    <p class="text-xs font-medium text-gray-500 mb-1">Total Products</p>
                    <p class="text-2xl font-bold text-gray-900 leading-none">450</p>
                </div>
                <!-- Users -->
                <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                        </div>
                        <span class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-1 rounded-full">+18%</span>
                    </div>
                    <p class="text-xs font-medium text-gray-500 mb-1">Total Users</p>
                    <p class="text-2xl font-bold text-gray-900 leading-none">8,920</p>
                </div>
                <!-- Offers -->
                <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex justify-between items-start mb-4">
                        <div class="p-2.5 bg-[#F2EDE4] rounded-xl text-[#8B5E3C]">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"></path></svg>
                        </div>
                        <span class="text-xs font-bold text-gray-400 bg-gray-50 px-2 py-1 rounded-full">2 Active</span>
                    </div>
                    <p class="text-xs font-medium text-gray-500 mb-1">Active Offers</p>
                    <p class="text-2xl font-bold text-gray-900 leading-none">12</p>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-8">
                <!-- Sales Overview Chart -->
                <div class="lg:col-span-2 bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm">
                    <div class="flex justify-between items-center mb-10">
                        <h3 class="text-lg font-bold text-left">Sales Overview</h3>
                        <button class="flex items-center gap-2 text-xs font-semibold text-gray-500 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100">
                            Last 6 Months
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                    </div>
                    <div class="flex items-end justify-between h-56 gap-4 px-2">
                        <div class="flex-1 flex flex-col items-center group">
                            <div class="w-full bar-color rounded-t-xl transition-all h-[40%]"></div>
                            <span class="mt-4 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Jan</span>
                        </div>
                        <div class="flex-1 flex flex-col items-center group">
                            <div class="w-full bar-color rounded-t-xl transition-all h-[65%]"></div>
                            <span class="mt-4 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Feb</span>
                        </div>
                        <div class="flex-1 flex flex-col items-center group">
                            <div class="w-full bar-color rounded-t-xl transition-all h-[55%]"></div>
                            <span class="mt-4 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Mar</span>
                        </div>
                        <div class="flex-1 flex flex-col items-center group">
                            <div class="w-full bar-color rounded-t-xl transition-all h-[80%]"></div>
                            <span class="mt-4 text-[10px] font-bold text-gray-400 uppercase tracking-widest">Apr</span>
                        </div>
                        <div class="flex-1 flex flex-col items-center group">
                            <div class="w-full bar-color rounded-t-xl transition-all h-[45%]"></div>
                            <span class="mt-4 text-[10px] font-bold text-gray-400 uppercase tracking-widest">May</span>
                        </div>
                        <div class="flex-1 flex flex-col items-center group">
                            <div class="w-full bar-color-active rounded-t-xl transition-all h-[95%]"></div>
                            <span class="mt-4 text-[10px] font-bold text-[#8B5E3C] uppercase tracking-widest">Jun</span>
                        </div>
                    </div>
                </div>

                <!-- Orders Analytics -->
                <div class="bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm">
                    <h3 class="text-lg font-bold mb-8 text-left">Orders Analytics</h3>
                    <div class="space-y-6 mb-8">
                        <div>
                            <div class="flex justify-between text-sm mb-2 font-medium">
                                <span class="text-gray-600">Completed</span>
                                <span class="text-gray-900">75%</span>
                            </div>
                            <div class="w-full h-2 bg-gray-50 rounded-full overflow-hidden">
                                <div class="h-full rounded-full bg-emerald-400" style="width: 75%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-2 font-medium">
                                <span class="text-gray-600">Processing</span>
                                <span class="text-gray-900">15%</span>
                            </div>
                            <div class="w-full h-2 bg-gray-50 rounded-full overflow-hidden">
                                <div class="h-full rounded-full bg-amber-400" style="width: 15%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="flex justify-between text-sm mb-2 font-medium">
                                <span class="text-gray-600">Cancelled</span>
                                <span class="text-gray-900">10%</span>
                            </div>
                            <div class="w-full h-2 bg-gray-50 rounded-full overflow-hidden">
                                <div class="h-full rounded-full bg-rose-400" style="width: 10%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-10 p-5 bg-[#FDFBF9] rounded-2xl border border-orange-50 flex items-center gap-4">
                        <div class="p-2 bg-white rounded-lg shadow-sm">
                            <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                        </div>
                        <div class="text-left">
                            <p class="text-sm font-bold text-gray-900">Weekly Target</p>
                            <p class="text-xs text-gray-500 font-medium">85% achieved this week</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Row -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Recent Orders Table -->
                <div class="lg:col-span-2 bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm">
                    <div class="flex justify-between items-center mb-8">
                        <h3 class="text-lg font-bold">Recent Orders</h3>
                        <a href="#" class="text-xs font-bold text-[#8B5E3C] hover:underline underline-offset-4">View All</a>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50/50 rounded-xl text-left text-[11px] font-bold text-gray-400 uppercase tracking-widest">
                                <tr>
                                    <th class="px-4 py-4">Order ID</th>
                                    <th class="px-4 py-4">Customer</th>
                                    <th class="px-4 py-4">Amount</th>
                                    <th class="px-4 py-4">Status</th>
                                </tr>
                            </thead>
                            <tbody class="text-sm text-left">
                                <tr class="border-b border-gray-50 last:border-0 hover:bg-gray-50/50 transition-colors">
                                    <td class="px-4 py-5 font-semibold text-gray-700">#VV-9281</td>
                                    <td class="px-4 py-5 font-medium text-gray-900">Sarah Jenkins</td>
                                    <td class="px-4 py-5 font-bold text-gray-900">$240.00</td>
                                    <td class="px-4 py-5">
                                        <span class="px-3 py-1 rounded-full text-[10px] font-black tracking-wider uppercase status-paid">PAID</span>
                                    </td>
                                </tr>
                                <tr class="border-b border-gray-50 last:border-0 hover:bg-gray-50/50 transition-colors">
                                    <td class="px-4 py-5 font-semibold text-gray-700">#VV-9280</td>
                                    <td class="px-4 py-5 font-medium text-gray-900">Michael Ross</td>
                                    <td class="px-4 py-5 font-bold text-gray-900">$1,120.50</td>
                                    <td class="px-4 py-5">
                                        <span class="px-3 py-1 rounded-full text-[10px] font-black tracking-wider uppercase status-pending">PENDING</span>
                                    </td>
                                </tr>
                                <tr class="border-b border-gray-50 last:border-0 hover:bg-gray-50/50 transition-colors">
                                    <td class="px-4 py-5 font-semibold text-gray-700">#VV-9279</td>
                                    <td class="px-4 py-5 font-medium text-gray-900">Elena Gilbert</td>
                                    <td class="px-4 py-5 font-bold text-gray-900">$85.00</td>
                                    <td class="px-4 py-5">
                                        <span class="px-3 py-1 rounded-full text-[10px] font-black tracking-wider uppercase status-paid">PAID</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Right Side Widgets -->
                <div class="space-y-8">
                    <!-- Top Selling -->
                    <div class="bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm">
                        <h3 class="text-lg font-bold mb-6 text-left">Top Selling</h3>
                        <div class="space-y-6">
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 bg-gray-50 rounded-2xl flex-shrink-0 flex items-center justify-center p-2">
                                    <div class="w-full h-full bg-[#8B5E3C]/10 rounded-lg flex items-center justify-center text-[#8B5E3C]">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0 text-left">
                                    <p class="text-sm font-bold text-gray-900 truncate">Velvet Evening Gown</p>
                                    <p class="text-xs text-gray-400 font-medium">842 sold</p>
                                </div>
                                <p class="text-sm font-black text-gray-900">$189</p>
                            </div>
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 bg-gray-50 rounded-2xl flex-shrink-0 flex items-center justify-center p-2">
                                    <div class="w-full h-full bg-[#8B5E3C]/10 rounded-lg flex items-center justify-center text-[#8B5E3C]">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0 text-left">
                                    <p class="text-sm font-bold text-gray-900 truncate">Silk Summer Scarf</p>
                                    <p class="text-xs text-gray-400 font-medium">650 sold</p>
                                </div>
                                <p class="text-sm font-black text-gray-900">$45</p>
                            </div>
                        </div>
                    </div>

                    <!-- Low Stock Alert -->
                    <div class="bg-white p-8 rounded-[2.5rem] border-l-4 border-l-orange-400 border border-gray-100 shadow-sm relative">
                        <div class="flex justify-between items-center mb-6">
                            <h3 class="text-lg font-bold text-gray-900">Low Stock Alert</h3>
                            <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                        </div>
                        <div class="space-y-4 text-left">
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray-600">Leather Handbag</span>
                                <span class="text-sm font-black text-rose-500">2 left</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-sm font-medium text-gray-600">Cashmere Sweater</span>
                                <span class="text-sm font-black text-rose-500">5 left</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>