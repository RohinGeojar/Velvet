    <script>

        const offerItems = {

<% offers.forEach(offer => { %>

            "<%= offer._id %>": [

<% if (offer.offerType === "product") { %>

<% (offer.products || []).forEach((product, index) => { %>

            {
                name: "<%- product.productName %>"
            } <%= index !== offer.products.length - 1 ? "," : "" %>

<% }) %>

<% } else { %>

<% (offer.categories || []).forEach((category, index) => { %>

            {
                name: "<%- category.name %>"
            } <%= index !== offer.categories.length - 1 ? "," : "" %>

<% }) %>

<% } %>

],

<% }) %>

}
        function showOfferItems(id) {

            const body = document.getElementById("offerItemsBody");

            body.innerHTML = "";

            offerItems[id].forEach(item => {

                body.innerHTML += `

        <div class="flex items-center gap-3 border rounded-lg p-3">

            <div
                class="w-8 h-8 rounded-full bg-[#704221] text-white flex items-center justify-center">

                <i class="fa-solid fa-check"></i>

            </div>

            <span class="font-medium">

                ${item.name}

            </span>

        </div>

        `;

            });

            document
                .getElementById("offerItemsModal")
                .classList.remove("hidden");

            document
                .getElementById("offerItemsModal")
                .classList.add("flex");

        }

        function closeOfferItems() {

            document
                .getElementById("offerItemsModal")
                .classList.remove("flex");

            document
                .getElementById("offerItemsModal")
                .classList.add("hidden");

        }

    </script>
    <script>

        lucide.createIcons();

    const form = document.getElementById("filterForm");

    const offerTypeInput = document.getElementById("offerTypeInput");

    const searchInput = document.getElementById("searchInput");

    const statusFilter = document.getElementById("statusFilter");

    const sortFilter = document.getElementById("sortFilter");

    const offerTabs = document.querySelectorAll(".offerTab");

    let debounce;

    // Product / Category Toggle
    offerTabs.forEach(tab => {

        tab.addEventListener("click", () => {

            offerTypeInput.value = tab.dataset.type;

            form.submit();

        });

    });

    // Auto Search (500ms debounce)
    searchInput.addEventListener("input", () => {

        clearTimeout(debounce);

        debounce = setTimeout(() => {

            form.submit();

        }, 500);

    });

    // Auto Status Filter
    statusFilter.addEventListener("change", () => {

        form.submit();

    });

    // Auto Sort
    sortFilter.addEventListener("change", () => {

        form.submit();

    });
    function openOfferModal(button) {

    document.getElementById("viewOfferName").textContent =
        button.dataset.offerName;

    document.getElementById("viewOfferType").textContent =
        button.dataset.offerType;

    document.getElementById("viewApplyLabel").textContent =
        button.dataset.offerType === "product"
            ? "Product"
            : "Category";
const container = document.getElementById("viewApplyTo");

container.innerHTML = "";

let items = [];

try {

    items = JSON.parse(button.dataset.apply);

} catch {

    items = [button.dataset.apply];

}

items.forEach(item => {

    const badge = document.createElement("span");

    badge.className =
        "inline-flex items-center px-3 py-1 rounded-full bg-purple-50 text-purple-700 text-sm font-medium border border-purple-200";

    badge.textContent = item;

    container.appendChild(badge);

});

    document.getElementById("viewDiscount").textContent =
        button.dataset.discount + "%";

    document.getElementById("viewStartDate").textContent =
        button.dataset.start;

    document.getElementById("viewExpiryDate").textContent =
        button.dataset.expiry;

    const badge = document.getElementById("viewStatus");

    badge.textContent = button.dataset.status;

    badge.className =
        "inline-flex px-3 py-1 rounded-full text-xs font-semibold";

    switch (button.dataset.status) {

        case "Active":
            badge.classList.add("bg-green-100", "text-green-700");
            break;

        case "Upcoming":
            badge.classList.add("bg-blue-100", "text-blue-700");
            break;

        case "Blocked":
            badge.classList.add("bg-yellow-100", "text-yellow-700");
            break;

        case "Expired":
            badge.classList.add("bg-orange-100", "text-orange-700");
            break;

        case "Deleted":
            badge.classList.add("bg-red-100", "text-red-700");
            break;
    }

    document.getElementById("editOfferBtn").href =
        "/couponManagement/offers/edit/" + button.dataset.id;

    document.getElementById("offerModal").classList.remove("hidden");
    document.getElementById("offerModal").classList.add("flex");

    lucide.createIcons();

}

function closeOfferModal() {

    document.getElementById("offerModal").classList.remove("flex");
    document.getElementById("offerModal").classList.add("hidden");

}

    </script>
