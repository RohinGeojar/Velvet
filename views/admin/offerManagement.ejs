                    </div>
                    <div class="p-3 bg-gray-50/50 border border-gray-100 rounded-lg">
                        <span class="text-textMuted block text-[10px] uppercase font-bold tracking-wider mb-0.5">Target Finish Date</span>
                        <span class="text-textDark" id="preview-end-date">Dec 15, 2026</span>
                    </div>
                </div>

                <!-- Promotional Template Box Presentation Mock -->
                <div class="border-2 border-dashed border-[#8C6239]/20 bg-[#F5EFEB]/30 p-4 rounded-xl text-center space-y-1">
                    <p class="text-[10px] text-textMuted uppercase font-bold tracking-widest">Active Front-store Coupon Banner</p>
                    <h5 class="text-lg font-black text-primary tracking-tight" id="preview-banner-text">Save 25% on Silk Midi Dress!</h5>
                    <p class="text-[10px] text-[#8C6239]/80 font-medium">Automatic promotion applied at checkout checkout.</p>
                </div>
            </div>

            <div class="px-6 py-4 bg-gray-50 border-t border-gray-150 flex items-center justify-end">
                <button onclick="closePreviewModal()" class="px-5 py-2 text-xs font-bold bg-[#8C6239] hover:bg-[#724f2d] text-white rounded-lg transition-all shadow-md">
                    Done
                </button>
            </div>
        </div>
    </div>


    <script>
        // Real Mock DB Database Data Storage (State Management)
        let dataset = [
            {
                id: 1,
