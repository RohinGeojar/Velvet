<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue - Offer Management</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Custom Style Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#8C6239',
                        primaryLight: '#F5EFEB',
                        textDark: '#1F2937',
                        textMuted: '#6B7280',
                        bgMain: '#F9FAFB',
                        bgSidebar: '#EFEAE4',
                        success: '#10B981',
                        successBg: '#D1FAE5',
                        danger: '#EF4444',
                        borderLight: '#E5E7EB'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar for premium feel */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #c7b29a;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #8c6239;
        }
    </style>
</head>
<body class="h-full flex flex-col overflow-hidden  text-textDark">

    
    <!-- Toast Notification Banner -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- Main Shell Layout -->
    <div class="flex h-full ml-[250px] overflow-hidden">
        
          <%- include("../partials/admin/adminSidebar") %>
      


        <!-- Mobile Drawer Navigation Overlay -->
        <div id="mobile-sidebar" class="fixed inset-0 z-40 hidden md:hidden" role="dialog" aria-modal="true">
            <div class="fixed inset-0 bg-gray-600/75" onclick="toggleMobileSidebar()"></div>
            <div class="fixed inset-y-0 left-0 flex w-full max-w-xs flex-col bg-bgSidebar py-4 shadow-xl">
                <div class="flex items-center justify-between px-6 pb-4 border-b border-gray-200">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-[#8C6239] rounded-lg flex items-center justify-center text-white">
                            <i data-lucide="sparkles" class="w-4 h-4"></i>
                        </div>
                        <span class="text-base font-bold text-primary">Velvet Vogue</span>
                    </div>
                    <button onclick="toggleMobileSidebar()" class="rounded-md p-1 text-gray-500 hover:bg-gray-100">
                        <i data-lucide="x" class="w-6 h-6"></i>
                    </button>
                </div>
                <nav class="flex-1 space-y-1 px-4 py-4 overflow-y-auto">
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="shopping-bag" class="w-4 h-4"></i> Products
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="shopping-cart" class="w-4 h-4"></i> Orders
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="users" class="w-4 h-4"></i> Users
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="folder" class="w-4 h-4"></i> Categories
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="ticket" class="w-4 h-4"></i> Coupons
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="image" class="w-4 h-4"></i> Banners
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                        <i data-lucide="trending-up" class="w-4 h-4"></i> Sales Report
                    </a>
                    <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium bg-[#8C6239] text-white">
                        <i data-lucide="tag" class="w-4 h-4"></i> Offers
                    </a>
                </nav>
                <div class="px-4 border-t border-gray-200 pt-4">
                    <button onclick="handleLogout()" class="w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50">
                        <i data-lucide="log-out" class="w-4 h-4"></i> Sign Out
                    </button>
                </div>
            </div>
        </div>


        <!-- Right Side Frame Content Panel -->
        <main class="flex-1 flex flex-col h-full overflow-hidden bg-bgMain">
            <!-- Header Bar -->
            <header class="h-16 flex items-center justify-between px-6 bg-white border-b border-gray-200">
                <!-- Hamburger and Global Search Group -->
                <div class="flex items-center gap-4 flex-1">
                    <button onclick="toggleMobileSidebar()" class="md:hidden p-1.5 rounded-lg hover:bg-gray-100 text-gray-500">
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                    <!-- Beautiful Custom Global Search -->
                    <div class="relative w-full max-w-md hidden sm:block">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                            <i data-lucide="search" class="w-4 h-4"></i>
                        </div>
                        <input type="text" placeholder="Search anything..." class="w-full max-w-md bg-gray-50 border border-gray-200 rounded-full pl-10 pr-4 py-1.5 text-sm outline-none focus:border-primary focus:bg-white focus:ring-2 focus:ring-primaryLight transition-all">
                    </div>
                </div>

                <!-- Profile and Notification Group -->
                <div class="flex items-center gap-4">
                    <!-- Notification Bell -->
                    <div class="relative cursor-pointer p-1.5 rounded-full hover:bg-gray-100 text-gray-600 transition-all">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span class="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 border-2 border-white rounded-full"></span>
                    </div>

                    <div class="h-8 w-[1px] bg-gray-200"></div>

                    <!-- User Information Info Grid -->
                    <div class="flex items-center gap-3">
                        <div class="hidden lg:flex flex-col text-right">
                            <span class="text-xs font-semibold text-textDark">Rohin Geojar</span>
                            <span class="text-[10px] text-textMuted uppercase font-bold tracking-wider">Administrator</span>
                        </div>
                        <img class="w-9 h-9 rounded-full object-cover border-2 border-primaryLight shadow-sm" src="https://placehold.co/100x100/8C6239/ffffff?text=RG" alt="User Avatar">
                    </div>
                </div>
            </header>


            <!-- Scrollable Content Viewport -->
            <div class="flex-1 overflow-y-auto p-6 md:p-8 space-y-8">
                <!-- Breadcrumbs & Document Info -->
                <div>
                    <nav class="flex items-center gap-2 text-xs text-textMuted font-medium mb-2">
                        <span class="hover:text-primary cursor-pointer transition">Dashboard</span>
                        <i data-lucide="chevron-right" class="w-3 h-3"></i>
                        <span class="hover:text-primary cursor-pointer transition">Marketing</span>
                        <i data-lucide="chevron-right" class="w-3 h-3"></i>
                        <span class="text-[#8C6239] font-semibold">Offers</span>
                    </nav>
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                        <div>
                            <h2 class="text-2xl font-bold tracking-tight text-textDark md:text-3xl">Offer Management</h2>
                            <p class="text-sm text-textMuted mt-1">Manage product-based and category-based promotional offers.</p>
                        </div>
                        <!-- Secondary mobile-friendly Create Button -->
                        <button onclick="openCreateModal()" class="sm:hidden flex items-center justify-center gap-2 bg-[#8C6239] text-white px-4 py-2 rounded-lg font-medium shadow-md hover:bg-[#724f2d] transition-all">
                            <i data-lucide="plus" class="w-4 h-4"></i> Create Offer
                        </button>
                    </div>
                </div>


                <!-- Stat Cards Grid Section -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Total Offer Stat -->
                    <div class="bg-white border border-gray-100 p-6 rounded-2xl shadow-sm flex items-center justify-between hover:border-gray-200 transition-all">
                        <div class="space-y-1">
                            <span class="text-xs text-textMuted font-medium tracking-wide">Total Offers</span>
                            <h3 id="stat-total" class="text-3xl font-extrabold text-textDark">128</h3>
                        </div>
                        <div class="w-12 h-12 bg-blue-50 text-blue-500 rounded-2xl flex items-center justify-center">
                            <i data-lucide="ticket" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <!-- Active Offer Stat -->
                    <div class="bg-white border border-gray-100 p-6 rounded-2xl shadow-sm flex items-center justify-between hover:border-gray-200 transition-all">
                        <div class="space-y-1">
                            <span class="text-xs text-textMuted font-medium tracking-wide">Active Offers</span>
                            <h3 id="stat-active" class="text-3xl font-extrabold text-textDark">84</h3>
                        </div>
                        <div class="w-12 h-12 bg-green-50 text-green-500 rounded-2xl flex items-center justify-center">
                            <i data-lucide="check-circle" class="w-6 h-6"></i>
                        </div>
                    </div>

                    <!-- Expired Offer Stat -->
                    <div class="bg-white border border-gray-100 p-6 rounded-2xl shadow-sm flex items-center justify-between hover:border-gray-200 transition-all">
                        <div class="space-y-1">
                            <span class="text-xs text-textMuted font-medium tracking-wide">Expired Offers</span>
                            <h3 id="stat-expired" class="text-3xl font-extrabold text-textDark">44</h3>
                        </div>
                        <div class="w-12 h-12 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center">
                            <i data-lucide="clock" class="w-6 h-6"></i>
                        </div>
                    </div>
                </div>


                <!-- Offers Central Workspace/Container -->
                <div class="bg-white border border-gray-150 rounded-2xl shadow-sm overflow-hidden flex flex-col">
                    
                    <!-- Table Action Tabs and Control Filters Bar -->
                    <div class="px-6 border-b border-gray-200 bg-gray-50/50 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 py-4">
                        
                        <!-- Tabs -->
                        <div class="flex gap-2 border-b lg:border-b-0 pb-2 lg:pb-0" id="offer-type-tabs">
                            <button onclick="switchTab('product')" id="tab-product" class="px-4 py-2 font-semibold text-sm rounded-lg transition-all focus:outline-none border-b-2 border-primary text-[#8C6239] bg-[#F5EFEB]">
                                Product Offers
                            </button>
                            <button onclick="switchTab('category')" id="tab-category" class="px-4 py-2 font-semibold text-sm text-textMuted hover:text-primary rounded-lg transition-all focus:outline-none">
                                Category Offers
                            </button>
                        </div>

                        <!-- Search, Filter, Action Button Container -->
                        <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center">
                            <!-- Local Live Search -->
                            <div class="relative flex-1 sm:w-64">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                                    <i data-lucide="search" class="w-4 h-4"></i>
                                </div>
                                <input type="text" id="table-search" placeholder="Search offers..." oninput="handleSearch()" class="w-full bg-white border border-gray-300 rounded-lg pl-9 pr-4 py-2 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all">
                            </div>

                            <!-- Filter Dropdown -->
                            <div class="relative flex items-center bg-white border border-gray-300 rounded-lg px-3 py-2 text-sm text-textMuted cursor-pointer hover:border-gray-400">
                                <i data-lucide="filter" class="w-4 h-4 mr-2"></i>
                                <select id="status-filter" onchange="handleStatusFilter()" class="bg-transparent border-none text-textDark outline-none cursor-pointer text-sm font-medium pr-2">
                                    <option value="ALL">All Status</option>
                                    <option value="ACTIVE">Active</option>
                                    <option value="EXPIRED">Expired</option>
                                </select>
                            </div>

                            <!-- Add Offer Action Button -->
                            <button onclick="openCreateModal()" class="hidden sm:flex items-center gap-2 bg-[#8C6239] text-white px-4 py-2 rounded-lg font-medium shadow hover:bg-[#724f2d] transition-all">
                                <i data-lucide="plus" class="w-4 h-4"></i> Create Offer
                            </button>
                        </div>
                    </div>


                    <!-- Main Dynamic Content Table Wrapper -->
                    <div class="overflow-x-auto min-h-[300px]">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-gray-50 border-b border-gray-200 text-[11px] font-bold tracking-wider text-textMuted select-none">
                                    <th class="px-6 py-4" id="col-target-type">PRODUCT</th>
                                    <th class="px-6 py-4">OFFER NAME</th>
                                    <th class="px-6 py-4">DISCOUNT</th>
                                    <th class="px-6 py-4">END DATE</th>
                                    <th class="px-6 py-4">STATUS</th>
                                    <th class="px-6 py-4 text-right">ACTIONS</th>
                                </tr>
                            </thead>
                            <tbody id="offers-table-body" class="divide-y divide-gray-100 text-sm">
                                <!-- Generated Dynamic Table Rows here -->
                            </tbody>
                        </table>
                        <!-- Empty State View -->
                        <div id="table-empty-state" class="hidden flex-col items-center justify-center p-12 text-center text-gray-400">
                            <i data-lucide="inbox" class="w-12 h-12 stroke-1 mb-3"></i>
                            <p class="font-semibold text-textDark text-base">No offers found</p>
                            <p class="text-xs text-textMuted max-w-xs mt-1">Try adapting your search parameters or make a fresh promotion right away.</p>
                        </div>
                    </div>


                    <!-- Footer Pagination Row -->
                    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50/50 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <span id="pagination-summary" class="text-xs text-textMuted font-medium">
                            Showing 1 to 10 of 128 results
                        </span>
                        
                        <div class="flex items-center gap-1.5" id="pagination-controls">
                            <!-- Prev, Next & Page Number Badges -->
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>


    <!-- Form Modal (Unified Create/Edit Offer Dialog) -->
    <div id="offer-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
        <!-- Backdrop Backdrop -->
        <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm transition-opacity" onclick="closeFormModal()"></div>
        
        <!-- Modal Center Window -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg bg-white rounded-2xl shadow-2xl overflow-hidden transition-all duration-300">
            <!-- Modal Header -->
            <div class="bg-primaryLight p-6 border-b border-gray-200/50 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-[#8C6239] text-white rounded-xl flex items-center justify-center shadow">
                        <i data-lucide="tag" id="modal-title-icon" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[#8C6239]" id="modal-title">Create New Offer</h3>
                        <p class="text-xs text-textMuted" id="modal-subtitle">Setup customizable discounts for active sales campaigns.</p>
                    </div>
                </div>
                <button onclick="closeFormModal()" class="text-gray-400 hover:text-gray-600 rounded-lg p-1.5 hover:bg-gray-100 transition-all">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Modal Form Frame -->
            <form id="offer-form" onsubmit="saveOffer(event)" class="p-6 space-y-4">
                <input type="hidden" id="form-offer-id">

                <!-- Target Category / Product Tab Switcher Inside Form -->
                <div>
                    <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2">Campaign Category Type</label>
                    <div class="grid grid-cols-2 gap-2 bg-gray-100 p-1 rounded-xl">
                        <button type="button" onclick="setFormType('product')" id="form-type-product" class="py-2 text-xs font-semibold rounded-lg text-center transition-all bg-white text-[#8C6239] shadow-sm">
                            Product Offer
                        </button>
                        <button type="button" onclick="setFormType('category')" id="form-type-category" class="py-2 text-xs font-semibold rounded-lg text-center transition-all text-textMuted hover:text-[#8C6239]">
                            Category Offer
                        </button>
                    </div>
                </div>

                <!-- Targeted Target Field (Product or Category Select input dependently) -->
                <div>
                    <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2" id="form-label-target">Product Selection</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i data-lucide="shopping-bag" id="form-target-icon" class="w-4 h-4"></i>
                        </div>
                        <input type="text" id="form-target-name" required placeholder="Enter Product Name (e.g. Silk Midi Dress)" class="w-full bg-white border border-gray-300 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all">
                    </div>
                </div>

                <!-- Custom Campaign Name -->
                <div>
                    <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2">Offer Campaign Name</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                            <i data-lucide="edit-3" class="w-4 h-4"></i>
                        </div>
                        <input type="text" id="form-offer-name" required placeholder="Summer Flash, Clearance 2026..." class="w-full bg-white border border-gray-300 rounded-lg pl-10 pr-4 py-2.5 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all">
                    </div>
                </div>

                <!-- Discount Matrix & Value Combo Section -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2">Discount Type</label>
                        <select id="form-discount-type" onchange="adaptDiscountInputPlaceholder()" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all font-medium">
                            <option value="PERCENTAGE">Percentage (% Off)</option>
                            <option value="FIXED">Fixed Price Discount ($)</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2" id="form-label-discount-val">Discount Value</label>
                        <input type="number" id="form-discount-val" required min="1" placeholder="25" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all">
                    </div>
                </div>

                <!-- Date & Initial Status Inputs Group -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2">Campaign End Date</label>
                        <input type="date" id="form-end-date" required class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-textDark uppercase tracking-wider mb-2">Initial Campaign Status</label>
                        <select id="form-status" class="w-full bg-white border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:border-primary focus:ring-1 focus:ring-primaryLight outline-none transition-all font-semibold">
                            <option value="ACTIVE">ACTIVE</option>
                            <option value="EXPIRED">EXPIRED</option>
                        </select>
                    </div>
                </div>

                <!-- Footer Modals CTA Buttons -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-150">
                    <button type="button" onclick="closeFormModal()" class="px-4 py-2 text-sm font-semibold text-textMuted bg-gray-50 rounded-lg border border-gray-300 hover:bg-gray-100 transition-all">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 text-sm font-semibold bg-[#8C6239] hover:bg-[#724f2d] text-white rounded-lg shadow-md transition-all">
                        Save Offer Campaign
                    </button>
                </div>
            </form>
        </div>
    </div>


    <!-- Preview Modal (Inspect Detailed Offer Content) -->
    <div id="preview-modal" class="fixed inset-0 z-50 hidden" role="dialog" aria-modal="true">
        <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" onclick="closePreviewModal()"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-2xl shadow-2xl overflow-hidden transition-all duration-300">
            
            <div class="bg-primaryLight p-6 border-b border-gray-200/50 flex justify-between items-center">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 bg-[#8C6239] text-white rounded-xl flex items-center justify-center shadow">
                        <i data-lucide="eye" class="w-4 h-4"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-[#8C6239]">Offer Overview</h3>
                        <p class="text-xs text-textMuted">Explore live configuration properties.</p>
                    </div>
                </div>
                <button onclick="closePreviewModal()" class="text-gray-400 hover:text-gray-600 rounded-lg p-1.5 hover:bg-gray-100 transition-all">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Visual Presentation Container -->
            <div class="p-6 space-y-6">
                <!-- Main Header Card Visual representation -->
                <div class="flex items-center gap-4 bg-gray-50 p-4 rounded-xl border border-gray-100">
                    <div id="preview-avatar-wrap" class="w-16 h-16 rounded-xl overflow-hidden shadow-sm flex-shrink-0 flex items-center justify-center text-white font-bold text-xl">
                        <!-- Img or initials loaded dynamically -->
                    </div>
                    <div class="space-y-1">
                        <h4 class="text-xs uppercase font-extrabold tracking-widest text-[#8C6239]" id="preview-badge-type">Product</h4>
                        <h3 class="text-base font-bold text-textDark leading-tight" id="preview-target-name">Velvet Evening Gown</h3>
                        <p class="text-xs text-textMuted" id="preview-offer-name">Winter Special</p>
                    </div>
                </div>

                <!-- Structured Properties Specs List -->
                <div class="grid grid-cols-2 gap-4 text-xs font-semibold">
                    <div class="p-3 bg-gray-50/50 border border-gray-100 rounded-lg">
                        <span class="text-textMuted block text-[10px] uppercase font-bold tracking-wider mb-0.5">Campaign Type</span>
                        <span class="text-textDark" id="preview-type">Product Offer</span>
                    </div>
                    <div class="p-3 bg-gray-50/50 border border-gray-100 rounded-lg">
                        <span class="text-textMuted block text-[10px] uppercase font-bold tracking-wider mb-0.5">Assigned Status</span>
