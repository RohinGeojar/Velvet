<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue - Offer Management</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Custom Style Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#8C6239',
                        primaryLight: '#F5EFEB',
                        textDark: '#1F2937',
                        textMuted: '#6B7280',
                        bgMain: '#F9FAFB',
                        bgSidebar: '#EFEAE4',
                        success: '#10B981',
                        successBg: '#D1FAE5',
                        danger: '#EF4444',
                        borderLight: '#E5E7EB'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }

        /* Custom scrollbar for premium feel */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #c7b29a;
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #8c6239;
        }
    </style>
</head>

<body class="h-full flex flex-col overflow-hidden  text-textDark">


    <!-- Toast Notification Banner -->
    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <!-- Main Shell Layout -->
    <div class="flex h-full ml-[250px] overflow-hidden">

        <%- include("../partials/admin/adminSidebar") %>



            <!-- Mobile Drawer Navigation Overlay -->
            <div id="mobile-sidebar" class="fixed inset-0 z-40 hidden md:hidden" role="dialog" aria-modal="true">
                <div class="fixed inset-0 bg-gray-600/75" onclick="toggleMobileSidebar()"></div>
                <div class="fixed inset-y-0 left-0 flex w-full max-w-xs flex-col bg-bgSidebar py-4 shadow-xl">
                    <div class="flex items-center justify-between px-6 pb-4 border-b border-gray-200">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-[#8C6239] rounded-lg flex items-center justify-center text-white">
                                <i data-lucide="sparkles" class="w-4 h-4"></i>
                            </div>
                            <span class="text-base font-bold text-primary">Velvet Vogue</span>
                        </div>
                        <button onclick="toggleMobileSidebar()" class="rounded-md p-1 text-gray-500 hover:bg-gray-100">
                            <i data-lucide="x" class="w-6 h-6"></i>
                        </button>
                    </div>
                    <nav class="flex-1 space-y-1 px-4 py-4 overflow-y-auto">
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="layout-dashboard" class="w-4 h-4"></i> Dashboard
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="shopping-bag" class="w-4 h-4"></i> Products
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="shopping-cart" class="w-4 h-4"></i> Orders
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="users" class="w-4 h-4"></i> Users
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="folder" class="w-4 h-4"></i> Categories
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="ticket" class="w-4 h-4"></i> Coupons
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="image" class="w-4 h-4"></i> Banners
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-textMuted hover:bg-white/50">
                            <i data-lucide="trending-up" class="w-4 h-4"></i> Sales Report
                        </a>
                        <a href="#"
                            class="flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium bg-[#8C6239] text-white">
                            <i data-lucide="tag" class="w-4 h-4"></i> Offers
                        </a>
                    </nav>
                    <div class="px-4 border-t border-gray-200 pt-4">
                        <button onclick="handleLogout()"
                            class="w-full flex items-center gap-3 px-3 py-2 rounded-md text-sm font-medium text-red-600 hover:bg-red-50">
                            <i data-lucide="log-out" class="w-4 h-4"></i> Sign Out
                        </button>
                    </div>
                </div>
            </div>


            <!-- Right Side Frame Content Panel -->
            <main class="flex-1 flex flex-col h-full overflow-hidden bg-bgMain">
                <!-- Header Bar -->
                <header class="h-16 flex items-center justify-between px-6 bg-white border-b border-gray-200">
                    <!-- Hamburger and Global Search Group -->
                    <div class="flex items-center gap-4 flex-1">
                        <button onclick="toggleMobileSidebar()"
                            class="md:hidden p-1.5 rounded-lg hover:bg-gray-100 text-gray-500">
                            <i data-lucide="menu" class="w-6 h-6"></i>
                        </button>
                        <!-- Beautiful Custom Global Search -->
                        <div class="relative w-full max-w-md hidden sm:block">
                            <div
                                class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-gray-400">
                                <i data-lucide="search" class="w-4 h-4"></i>
                            </div>
                            <input type="text" placeholder="Search anything..."
                                class="w-full max-w-md bg-gray-50 border border-gray-200 rounded-full pl-10 pr-4 py-1.5 text-sm outline-none focus:border-primary focus:bg-white focus:ring-2 focus:ring-primaryLight transition-all">
                        </div>
                    </div>

                    <!-- Profile and Notification Group -->
                    <div class="flex items-center gap-4">
                        <!-- Notification Bell -->
                        <div
                            class="relative cursor-pointer p-1.5 rounded-full hover:bg-gray-100 text-gray-600 transition-all">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            <span
                                class="absolute top-1 right-1 w-2.5 h-2.5 bg-red-500 border-2 border-white rounded-full"></span>
                        </div>

                        <div class="h-8 w-[1px] bg-gray-200"></div>

                        <!-- User Information Info Grid -->
                        <div class="flex items-center gap-3">
                            <div class="hidden lg:flex flex-col text-right">
                                <span class="text-xs font-semibold text-textDark">Rohin Geojar</span>
                                <span
                                    class="text-[10px] text-textMuted uppercase font-bold tracking-wider">Administrator</span>
                            </div>
                            <img class="w-9 h-9 rounded-full object-cover border-2 border-primaryLight shadow-sm"
                                src="https://placehold.co/100x100/8C6239/ffffff?text=RG" alt="User Avatar">
                        </div>
                    </div>
                </header>


                <!-- Scrollable Content Viewport -->
                <div class="flex-1 overflow-y-auto p-6 md:p-8 space-y-8">
                    <!-- Breadcrumbs & Document Info -->
                    <div>
                        <nav class="flex items-center gap-2 text-xs text-textMuted font-medium mb-2">
                            <span class="hover:text-primary cursor-pointer transition">Dashboard</span>
                            <i data-lucide="chevron-right" class="w-3 h-3"></i>
                            <span class="hover:text-primary cursor-pointer transition">Marketing</span>
                            <i data-lucide="chevron-right" class="w-3 h-3"></i>
                            <span class="text-[#8C6239] font-semibold">Offers</span>
                        </nav>
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                            <div>
                                <h2 class="text-2xl font-bold tracking-tight text-textDark md:text-3xl">Offer Management
                                </h2>
                                <p class="text-sm text-textMuted mt-1">Manage product-based and category-based
                                    promotional offers.</p>
                            </div>
                            <!-- Secondary mobile-friendly Create Button -->
                            <a href="/couponManagement/offers/create"
                                class="hidden sm:inline-flex items-center gap-2 bg-[#8C6239] text-white px-4 py-2 rounded-lg font-medium shadow hover:bg-[#724f2d] transition-all">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                                Create Offer
                            </a>
                        </div>
                    </div>


                    <!-- Stat Cards Grid Section -->
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">

                        <!-- Total -->
                        <a href="/couponManagement/offers?search=<%= search %>&offerType=<%= offerType %>&sort=<%= sort %>"
                            class="bg-white border rounded-2xl p-5 shadow-sm flex items-center justify-between hover:shadow-lg transition duration-200 cursor-pointer">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Total Offers</p>
                                <h2 id="stat-total" class="text-3xl font-bold mt-1">
                                    <%= dashboard.total %>
                                </h2>
                            </div>
                            <div
                                class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                                <i data-lucide="ticket-percent" class="w-6 h-6"></i>
                            </div>
                        </a>

                        <!-- Active -->
                        <a href="/couponManagement/offers?status=active&search=<%= search %>&offerType=<%= offerType %>&sort=<%= sort %>"
                            class="bg-white border rounded-2xl p-5 shadow-sm flex items-center justify-between hover:shadow-lg transition duration-200 cursor-pointer">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Active</p>
                                <h2 id="stat-active" class="text-3xl font-bold mt-1">
                                    <%= dashboard.active %>
                                </h2>
                            </div>
                            <div
                                class="w-12 h-12 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">
                                <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                            </div>
                        </a>

                        <!-- Upcoming -->
                        <a href="/couponManagement/offers?status=upcoming&search=<%= search %>&offerType=<%= offerType %>&sort=<%= sort %>"
                            class="bg-white border rounded-2xl p-5 shadow-sm flex items-center justify-between hover:shadow-lg transition duration-200 cursor-pointer">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Upcoming</p>
                                <h2 id="stat-upcoming" class="text-3xl font-bold mt-1">
                                    <%= dashboard.upcoming %>
                                </h2>
                            </div>
                            <div
                                class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">
                                <i data-lucide="calendar-clock" class="w-6 h-6"></i>
                            </div>
                        </a>

                        <!-- Blocked -->
                        <a href="/couponManagement/offers?status=blocked&search=<%= search %>&offerType=<%= offerType %>&sort=<%= sort %>"
                            class="bg-white border rounded-2xl p-5 shadow-sm flex items-center justify-between hover:shadow-lg transition duration-200 cursor-pointer">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Blocked</p>
                                <h2 id="stat-blocked" class="text-3xl font-bold mt-1">
                                    <%= dashboard.blocked %>
                                </h2>
                            </div>
                            <div
                                class="w-12 h-12 rounded-xl bg-yellow-100 text-yellow-600 flex items-center justify-center">
                                <i data-lucide="ban" class="w-6 h-6"></i>
                            </div>
                        </a>

                        <!-- Expired -->
                        <a href="/couponManagement/offers?status=expired&search=<%= search %>&offerType=<%= offerType %>&sort=<%= sort %>"
                            class="bg-white border rounded-2xl p-5 shadow-sm flex items-center justify-between hover:shadow-lg transition duration-200 cursor-pointer">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Expired</p>
                                <h2 id="stat-expired" class="text-3xl font-bold mt-1">
                                    <%= dashboard.expired %>
                                </h2>
                            </div>
                            <div
                                class="w-12 h-12 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center">
                                <i data-lucide="clock-3" class="w-6 h-6"></i>
                            </div>
                        </a>

                        <!-- Deleted -->
                        <a href="/couponManagement/offers?status=deleted&search=<%= search %>&offerType=<%= offerType %>&sort=<%= sort %>"
                            class="bg-white border rounded-2xl p-5 shadow-sm flex items-center justify-between hover:shadow-lg transition duration-200 cursor-pointer">
                            <div>
                                <p class="text-xs text-gray-500 font-medium">Deleted</p>
                                <h2 id="stat-deleted" class="text-3xl font-bold mt-1">
                                    <%= dashboard.deleted %>
                                </h2>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center">
                                <i data-lucide="trash-2" class="w-6 h-6"></i>
                            </div>
                        </a>

                    </div>

                    <!-- Offers Central Workspace/Container -->
                    <div class="bg-white border border-gray-150 rounded-2xl shadow-sm overflow-hidden flex flex-col">

                        <!-- Table Action Tabs and Control Filters Bar -->
                        <!-- Filter Bar -->
<!-- ===================== OFFER TOOLBAR ===================== -->

<form
    id="filterForm"
    action="/couponManagement/offers"
    method="GET"
    class="bg-white border rounded-xl px-5 py-4 flex items-center gap-4">

    <!-- Preserve Selected Offer Type -->
    <input
        type="hidden"
        id="offerTypeInput"
        name="offerType"
        value="<%= offerType || 'product' %>">

    <!-- Product / Category Toggle -->
    <div class="flex rounded-lg overflow-hidden border shrink-0">

        <button
            type="button"
            data-type="product"
            class="offerTab px-5 py-2 text-sm font-medium transition
            <%= offerType !== 'category'
                ? 'bg-[#8C6239] text-white'
                : 'bg-white text-gray-700 hover:bg-gray-100' %>">

            Product

        </button>

        <button
            type="button"
            data-type="category"
            class="offerTab px-5 py-2 text-sm font-medium border-l transition
            <%= offerType === 'category'
                ? 'bg-[#8C6239] text-white'
                : 'bg-white text-gray-700 hover:bg-gray-100' %>">

            Category

        </button>

    </div>

    <!-- Search -->
    <div class="relative flex-1">

        <i
            data-lucide="search"
            class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400">
        </i>

        <input
            id="searchInput"
            type="text"
            name="search"
            value="<%= search %>"
            placeholder="Search offer..."
            class="w-full pl-10 pr-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-[#8C6239]">

    </div>

    <!-- Status -->
    <select
        id="statusFilter"
        name="status"
        class="w-40 px-3 py-2 border rounded-lg">

        <option value="">All Status</option>

        <option value="active"
            <%= status==="active" ? "selected" : "" %>>
            Active
        </option>

        <option value="upcoming"
            <%= status==="upcoming" ? "selected" : "" %>>
            Upcoming
        </option>

        <option value="blocked"
            <%= status==="blocked" ? "selected" : "" %>>
            Blocked
        </option>

        <option value="expired"
            <%= status==="expired" ? "selected" : "" %>>
            Expired
        </option>

        <option value="deleted"
            <%= status==="deleted" ? "selected" : "" %>>
            Deleted
        </option>

    </select>

    <!-- Sort -->
    <select
        id="sortFilter"
        name="sort"
        class="w-44 px-3 py-2 border rounded-lg">

        <option
            value="latest"
            <%= !sort || sort==="latest" ? "selected" : "" %>>

            Latest

        </option>

        <option
            value="a-z"
            <%= sort==="a-z" ? "selected" : "" %>>

            A-Z

        </option>

        <option
            value="z-a"
            <%= sort==="z-a" ? "selected" : "" %>>

            Z-A

        </option>

        <option
            value="highest"
            <%= sort==="highest" ? "selected" : "" %>>

            Highest Discount

        </option>

        <option
            value="lowest"
            <%= sort==="lowest" ? "selected" : "" %>>

            Lowest Discount

        </option>

        <option
            value="start"
            <%= sort==="start" ? "selected" : "" %>>

            Start Date

        </option>

        <option
            value="expiry"
            <%= sort==="expiry" ? "selected" : "" %>>

            Expiry Date

        </option>

    </select>

    <!-- Clear -->
    <a
        href="/couponManagement/offers?offerType=<%= offerType || 'product' %>"
        class="px-5 py-2 border rounded-lg hover:bg-gray-100 transition">

        Clear

    </a>

</form>



                        <!-- Main Dynamic Content Table Wrapper -->
                        <div class="overflow-x-auto min-h-[300px]">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr
                                        class="bg-gray-50 border-b border-gray-200 text-[11px] font-bold tracking-wider text-textMuted select-none">
                                        <th class="px-6 py-4" id="col-target-type"> <%= offerType === "category" ? "CATEGORY" : "PRODUCT" %></th>
                                        <th class="px-6 py-4">OFFER NAME</th>
                                        <th class="px-6 py-4">DISCOUNT</th>
                                        <th class="px-6 py-4">EXPIERY</th>
                                        <th class="px-6 py-4">STATUS</th>
                                        <th class="px-6 py-4 text-center">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody id="offers-table-body" class="divide-y divide-gray-100 text-sm">
                                    <% if (offers.length) { %>

                                        <% offers.forEach(offer=> { %>

                                            <tr class="hover:bg-gray-50 transition-all">

                                                <!-- Product / Category -->
                                                <td class="py-4 px-6">
                                                    <% const items=offer.offerType==="product" ? (offer.products || [])
                                                        : (offer.categories || []); %>

                                                        <% items.slice(0,2).forEach(item=>{ %>

                                                            <p class="font-medium text-gray-800">

                                                                <%= offer.offerType==="product" ? item.productName :
                                                                    item.name %>

                                                            </p>

                                                            <% }) %>

                                                                <% if(items.length>2){ %>

                                                                    <button onclick="showOfferItems('<%= offer._id %>')"
                                                                        class="text-xs text-[#704221] hover:underline font-semibold">

                                                                        +<%= items.length-2 %> more

                                                                    </button>

                                                                    <% } %>

                                                </td>
                                                <!-- Offer Name -->
                                                <td class="py-4 px-6">

                                                    <p class="font-bold text-[#704221]">
                                                        <%= offer.offerName %>
                                                    </p>

                                                    <p class="text-xs text-gray-500 mt-1">
                                                        <%= offer.offerType==="product" ? "Product Offer"
                                                            : "Category Offer" %>
                                                    </p>

                                                </td>

                                                <!-- Discount -->
                                                <td class="py-4 px-6">

                                                    <span class="font-semibold text-green-700">

                                                        <%= offer.discountValue %>% OFF

                                                    </span>

                                                </td>

                                                <!-- End Date -->
                                                <td class="py-4 px-6 text-gray-600 font-medium">

                                                    <%= offer.expiryDate.toLocaleDateString("en-IN",{ day:"2-digit",
                                                        month:"short", year:"numeric" }) %>

                                                </td>

                                                <!-- Status -->
                                                <td class="py-4 px-6">

                                                    <% if (offer.status==="Active" ) { %>

                                                        <span
                                                            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                                            ACTIVE
                                                        </span>

                                                        <% } else if (offer.status==="Upcoming" ) { %>

                                                            <span
                                                                class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 border border-blue-200">
                                                                UPCOMING
                                                            </span>

                                                            <% } else if (offer.status==="Blocked" ) { %>

                                                                <span
                                                                    class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-700 border border-yellow-200">
                                                                    BLOCKED
                                                                </span>

                                                                <% } else if (offer.status==="Expired" ) { %>

                                                                    <span
                                                                        class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-orange-100 text-orange-700 border border-orange-200">
                                                                        EXPIRED
                                                                    </span>

                                                                    <% } else { %>

                                                                        <span
                                                                            class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700 border border-red-200">
                                                                            DELETED
                                                                        </span>

                                                                        <% } %>

                                                </td>

                                                <!-- Actions -->
                                                <td class="px-6 py-4">

    <div class="flex items-center justify-center gap-2">

        <!-- View -->
       <button
    onclick="openOfferModal(this)"
    data-id="<%= offer._id %>"
    data-offer-name="<%= offer.offerName %>"
    data-offer-type="<%= offer.offerType %>"
    data-apply='<%= JSON.stringify(
    offer.offerType === "product"
        ? offer.products.map(product => product.productName)
        : offer.categories.map(category => category.name)
) %>'
    data-discount="<%= offer.discountValue %>"
    data-start="<%= new Date(offer.startDate).toLocaleDateString('en-IN') %>"
    data-expiry="<%= new Date(offer.expiryDate).toLocaleDateString('en-IN') %>"
    data-status="<%= offer.status %>"
    class="w-9 h-9 rounded-lg border flex items-center justify-center text-blue-600 hover:bg-blue-50">

    <i data-lucide="eye" class="w-4 h-4"></i>

</button>

        <!-- Edit -->
        <a
            href="/couponManagement/offers/edit/<%= offer._id %>"
            class="w-9 h-9 rounded-lg border flex items-center justify-center text-amber-600 hover:bg-amber-50 transition"
            title="Edit">

            <i data-lucide="square-pen" class="w-4 h-4"></i>

        </a>

        <!-- Block / Unblock -->
        <% if(offer.isActive){ %>

            <button
                class="w-9 h-9 rounded-lg border flex items-center justify-center text-orange-600 hover:bg-orange-50 transition"
                title="Block"
                onclick="blockOffer('<%= offer._id %>')">

                <i data-lucide="ban" class="w-4 h-4"></i>

            </button>

        <% } else { %>

            <button
                class="w-9 h-9 rounded-lg border flex items-center justify-center text-green-600 hover:bg-green-50 transition"
                title="Unblock"
                onclick="unblockOffer('<%= offer._id %>')">

                <i data-lucide="check" class="w-4 h-4"></i>

            </button>

        <% } %>

        <!-- Delete -->
        <button
            class="w-9 h-9 rounded-lg border flex items-center justify-center text-red-600 hover:bg-red-50 transition"
            title="Delete"
            onclick="deleteOffer('<%= offer._id %>')">

            <i data-lucide="trash-2" class="w-4 h-4"></i>

        </button>

