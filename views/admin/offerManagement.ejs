                categoryName: 'Accessories',
                offerName: 'Category Kickoff',
                discountType: 'PERCENTAGE',
                discountValue: 10,
                endDate: '2026-11-20',
                status: 'ACTIVE',
                image: 'https://images.unsplash.com/photo-1511556532299-8f662fc26c06?w=150&auto=format&fit=crop&q=60'
            },
            {
                id: 6,
                type: 'product',
                productName: 'Suede Loafers',
                categoryName: 'Footwear',
                offerName: 'Summer Breeze Footwear',
                discountType: 'PERCENTAGE',
                discountValue: 30,
                endDate: '2026-07-28',
                status: 'ACTIVE',
                image: 'https://images.unsplash.com/photo-1533867617858-e7b97e060509?w=150&auto=format&fit=crop&q=60'
            },
            {
                id: 7,
                type: 'category',
                productName: 'Winter Outerwear',
                categoryName: 'Coats & Jackets',
                offerName: 'Pre-season Warmth',
                discountType: 'FIXED',
                discountValue: 75.00,
                endDate: '2024-10-15',
                status: 'EXPIRED',
                image: 'https://images.unsplash.com/photo-1544022613-e87ca75a784a?w=150&auto=format&fit=crop&q=60'
            }
        ];

        // Active State Filter Engine variables
        let currentTab = 'product'; // 'product' | 'category'
        let searchQuery = '';
        let statusFilter = 'ALL'; // 'ALL' | 'ACTIVE' | 'EXPIRED'
        let currentPage = 1;
        const itemsPerPage = 5;


        // Run setup actions on launch
        window.addEventListener('DOMContentLoaded', () => {
            renderDashboard();
            updateStats();
            lucide.createIcons();
        });

        // Toggle Sidebar Drawer on mobile layout screens
        function toggleMobileSidebar() {
            const drawer = document.getElementById('mobile-sidebar');
            drawer.classList.toggle('hidden');
        }

        // Display beautiful toast notifications inside browser viewport
        function showNotification(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            // Build dynamic colors for the toast alert banner
            let bgClass = 'bg-white border-blue-500';
            let iconColor = 'text-blue-500';
            let icon = 'info';

            if (type === 'success') {
                bgClass = 'bg-white border-green-500';
                iconColor = 'text-green-500';
                icon = 'check-circle';
            } else if (type === 'danger') {
                bgClass = 'bg-white border-red-500';
                iconColor = 'text-red-500';
                icon = 'alert-triangle';
            }

            toast.className = `flex items-center gap-3 px-4 py-3 bg-white border-l-4 rounded-xl shadow-lg pointer-events-auto transition-all transform translate-x-12 opacity-0 duration-300 w-80 max-w-sm ${bgClass}`;
            toast.innerHTML = `
                <div class="${iconColor}">
                    <i data-lucide="${icon}" class="w-5 h-5"></i>
                </div>
                <div class="flex-1 text-xs font-semibold text-textDark">
                    ${message}
                </div>
                <button class="text-gray-400 hover:text-gray-600 ml-2" onclick="this.parentElement.remove()">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            `;
            
            container.appendChild(toast);
            lucide.createIcons({attrs: {class: ["w-4", "h-4"]}});

            // Animate in the notification
            setTimeout(() => {
                toast.classList.remove('translate-x-12', 'opacity-0');
            }, 50);

            // Animate out automatically
            setTimeout(() => {
                toast.classList.add('translate-x-12', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // Update top row metrics dynamically
        function updateStats() {
            const total = dataset.length;
            const active = dataset.filter(item => item.status === 'ACTIVE').length;
            const expired = dataset.filter(item => item.status === 'EXPIRED').length;

            document.getElementById('stat-total').innerText = total;
            document.getElementById('stat-active').innerText = active;
            document.getElementById('stat-expired').innerText = expired;
        }


        // Tab selection engine switches
        function switchTab(tab) {
            currentTab = tab;
            
            // Adjust buttons active styling state
            const tabProduct = document.getElementById('tab-product');
            const tabCategory = document.getElementById('tab-category');
            
            const activeClasses = 'border-b-2 border-primary text-[#8C6239] bg-[#F5EFEB]'.split(' ');
            const inactiveClasses = 'text-textMuted hover:text-primary'.split(' ');

            if (tab === 'product') {
                tabProduct.classList.add(...activeClasses);
                tabProduct.classList.remove(...inactiveClasses);
                tabCategory.classList.add(...inactiveClasses);
                tabCategory.classList.remove(...activeClasses);
                document.getElementById('col-target-type').innerText = 'PRODUCT';
            } else {
                tabCategory.classList.add(...activeClasses);
                tabCategory.classList.remove(...inactiveClasses);
                tabProduct.classList.add(...inactiveClasses);
                tabProduct.classList.remove(...activeClasses);
                document.getElementById('col-target-type').innerText = 'CATEGORY';
            }

            currentPage = 1;
            renderDashboard();
        }

        // Process status search filters input
        function handleSearch() {
            searchQuery = document.getElementById('table-search').value.toLowerCase();
            currentPage = 1;
            renderDashboard();
        }

        // Status select query processor
        function handleStatusFilter() {
            statusFilter = document.getElementById('status-filter').value;
            currentPage = 1;
            renderDashboard();
        }


        // Standard render engine dashboard
        function renderDashboard() {
            const tbody = document.getElementById('offers-table-body');
            const emptyState = document.getElementById('table-empty-state');
            tbody.innerHTML = '';

            // Apply logical query pipeline
            const filteredData = dataset.filter(item => {
                const matchesTab = item.type === currentTab;
                const matchesStatus = statusFilter === 'ALL' || item.status === statusFilter;
                
                const matchesSearch = item.productName.toLowerCase().includes(searchQuery) || 
                                      item.offerName.toLowerCase().includes(searchQuery) ||
                                      (item.categoryName && item.categoryName.toLowerCase().includes(searchQuery));
                
                return matchesTab && matchesStatus && matchesSearch;
            });

            // If empty, trigger design layout empty placeholder overlay
            if (filteredData.length === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
                document.getElementById('pagination-summary').innerText = 'Showing 0 results';
                document.getElementById('pagination-controls').innerHTML = '';
                return;
            } else {
                emptyState.classList.remove('flex');
                emptyState.classList.add('hidden');
            }

            // Calculation Pagination variables
            const totalItems = filteredData.length;
            const totalPages = Math.ceil(totalItems / itemsPerPage);
            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = Math.min(startIndex + itemsPerPage, totalItems);
            const paginatedItems = filteredData.slice(startIndex, endIndex);

            // Populate active rows
            paginatedItems.forEach(offer => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-gray-50/70 transition-all';

                // Display form discount rate visually
                const discountDisplay = offer.discountType === 'PERCENTAGE' 
                    ? `${offer.discountValue}% Off` 
                    : `$${parseFloat(offer.discountValue).toFixed(2)} Fixed`;

                // Display dynamic actions block dependently on Active or Expired state
                let actionsHTML = '';
                if (offer.status === 'ACTIVE') {
                    actionsHTML = `
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="previewOffer(${offer.id})" title="View Details" class="p-1.5 rounded-lg text-textMuted hover:text-primary hover:bg-[#F5EFEB] transition-all">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                            <button onclick="editOffer(${offer.id})" title="Edit Offer" class="p-1.5 rounded-lg text-textMuted hover:text-primary hover:bg-[#F5EFEB] transition-all">
                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteOffer(${offer.id})" title="Delete Offer" class="p-1.5 rounded-lg text-textMuted hover:text-red-500 hover:bg-red-50 transition-all">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    `;
                } else {
                    actionsHTML = `
                        <div class="flex items-center justify-end gap-2">
                            <button onclick="restoreOffer(${offer.id})" title="Restore Campaign" class="p-1.5 rounded-lg text-textMuted hover:text-green-500 hover:bg-green-50 transition-all">
                                <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteOffer(${offer.id})" title="Delete Permanently" class="p-1.5 rounded-lg text-textMuted hover:text-red-500 hover:bg-red-50 transition-all">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    `;
                }

                // Pick an alternative graphic banner background or fallback
                const fallbackImg = `https://placehold.co/100x100/EFEAE4/8C6239?text=${encodeURIComponent(offer.productName.charAt(0))}`;
                const rowImg = offer.image || fallbackImg;

                // Create Status Styles matching original specifications
                const badgeStyle = offer.status === 'ACTIVE' 
                    ? 'bg-green-100 text-green-700 text-[10px] px-2.5 py-1 rounded-full font-bold inline-block' 
                    : 'bg-gray-100 text-gray-500 text-[10px] px-2.5 py-1 rounded-full font-bold inline-block';

                // Format end dates nicely
                const formattedDate = new Date(offer.endDate).toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                });

                tr.innerHTML = `
                    <td class="px-6 py-4.5 whitespace-nowrap">
                        <div class="flex items-center gap-3">
                            <img class="w-10 h-10 rounded-xl object-cover border border-gray-100 shadow-sm" src="${rowImg}" onerror="this.onerror=null; this.src='${fallbackImg}'" alt="Row Graphic">
                            <div>
                                <span class="font-bold text-textDark block leading-tight">${offer.productName}</span>
                                <span class="text-[10px] text-textMuted uppercase font-bold tracking-wider">${offer.categoryName || 'General'}</span>
                            </div>
                        </div>
                    </td>
                    <td class="px-6 py-4.5 whitespace-nowrap align-middle">
                        <span class="font-medium text-textDark text-sm">${offer.offerName}</span>
                    </td>
                    <td class="px-6 py-4.5 whitespace-nowrap align-middle">
                        <span class="text-[#8C6239] font-bold text-sm tracking-tight">${discountDisplay}</span>
                    </td>
                    <td class="px-6 py-4.5 whitespace-nowrap text-textMuted text-xs font-semibold align-middle">
                        ${formattedDate}
                    </td>
                    <td class="px-6 py-4.5 whitespace-nowrap align-middle">
                        <span class="${badgeStyle}">${offer.status}</span>
                    </td>
                    <td class="px-6 py-4.5 whitespace-nowrap text-right align-middle">
                        ${actionsHTML}
                    </td>
                `;

                tbody.appendChild(tr);
            });

            // Build/Update Pagination controls inside panel
            document.getElementById('pagination-summary').innerText = `Showing ${startIndex + 1} to ${endIndex} of ${totalItems} results`;
            renderPaginationControls(totalPages);

            // Reapply Lucide Icon renders
            lucide.createIcons();
        }


        // Construct intuitive navigation button matrices
        function renderPaginationControls(totalPages) {
            const container = document.getElementById('pagination-controls');
            container.innerHTML = '';

            if (totalPages <= 1) return;

            // Generate Prev Indicator button
            const prevBtn = document.createElement('button');
            prevBtn.disabled = currentPage === 1;
            prevBtn.className = `p-2 rounded-lg border border-gray-300 hover:bg-gray-50 text-gray-500 disabled:opacity-40 disabled:hover:bg-transparent transition-all`;
            prevBtn.innerHTML = `<i data-lucide="chevron-left" class="w-4 h-4"></i>`;
            prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; renderDashboard(); } };
            container.appendChild(prevBtn);

            // Draw numerical page selection
            for (let i = 1; i <= totalPages; i++) {
                // Reduce excess numbers using simple ellipses logic if dataset gets extremely long
                if (totalPages > 5 && Math.abs(currentPage - i) > 1 && i !== 1 && i !== totalPages) {
                    if (i === 2 || i === totalPages - 1) {
                        const dot = document.createElement('span');
                        dot.className = 'px-2 text-textMuted text-sm font-semibold';
                        dot.innerText = '...';
                        container.appendChild(dot);
                    }
                    continue;
                }

                const pageBtn = document.createElement('button');
                const isSelected = i === currentPage;
                pageBtn.className = isSelected 
                    ? `w-8 h-8 flex items-center justify-center rounded-lg text-xs font-bold bg-[#8C6239] text-white shadow-md transition-all` 
                    : `w-8 h-8 flex items-center justify-center rounded-lg text-xs font-semibold text-textMuted hover:bg-gray-100 transition-all`;
                
                pageBtn.innerText = i;
                pageBtn.onclick = () => { currentPage = i; renderDashboard(); };
                container.appendChild(pageBtn);
            }

            // Generate Next Indicator button
            const nextBtn = document.createElement('button');
            nextBtn.disabled = currentPage === totalPages;
            nextBtn.className = `p-2 rounded-lg border border-gray-300 hover:bg-gray-50 text-gray-500 disabled:opacity-40 disabled:hover:bg-transparent transition-all`;
            nextBtn.innerHTML = `<i data-lucide="chevron-right" class="w-4 h-4"></i>`;
            nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; renderDashboard(); } };
            container.appendChild(nextBtn);

            lucide.createIcons();
        }


        // Set state values inside target selection container on custom Modal
        let activeFormType = 'product';
        
        function setFormType(type) {
            activeFormType = type;
            const btnProd = document.getElementById('form-type-product');
            const btnCat = document.getElementById('form-type-category');

            const activeStyles = 'bg-white text-[#8C6239] shadow-sm'.split(' ');
            const inactiveStyles = 'text-textMuted hover:text-[#8C6239]'.split(' ');

            if (type === 'product') {
                btnProd.classList.add(...activeStyles);
                btnProd.classList.remove(...inactiveStyles);
                btnCat.classList.add(...inactiveStyles);
                btnCat.classList.remove(...activeStyles);
                
                document.getElementById('form-label-target').innerText = 'Product Selection';
                document.getElementById('form-target-name').placeholder = 'Enter Product Name (e.g. Silk Midi Dress)';
                document.getElementById('form-target-icon').setAttribute('data-lucide', 'shopping-bag');
            } else {
                btnCat.classList.add(...activeStyles);
                btnCat.classList.remove(...inactiveStyles);
                btnProd.classList.add(...inactiveStyles);
                btnProd.classList.remove(...activeStyles);
                
                document.getElementById('form-label-target').innerText = 'Category Selection';
                document.getElementById('form-target-name').placeholder = 'Enter Category Selection (e.g. Footwear)';
                document.getElementById('form-target-icon').setAttribute('data-lucide', 'folder');
            }
            lucide.createIcons();
        }

        function adaptDiscountInputPlaceholder() {
            const type = document.getElementById('form-discount-type').value;
            const valLabel = document.getElementById('form-label-discount-val');
            const valInput = document.getElementById('form-discount-val');
            
            if (type === 'PERCENTAGE') {
                valLabel.innerText = 'Discount Percentage (%)';
                valInput.placeholder = '25';
                valInput.max = '100';
            } else {
                valLabel.innerText = 'Fixed Cash Discount ($)';
                valInput.placeholder = '50';
                valInput.removeAttribute('max');
            }
        }

        // Open Modal view frame for adding details
        function openCreateModal() {
            document.getElementById('offer-form').reset();
            document.getElementById('form-offer-id').value = '';
            document.getElementById('modal-title').innerText = 'Create New Offer';
            document.getElementById('modal-subtitle').innerText = 'Setup customizable discounts for active sales campaigns.';
            
            // Default parameters
            setFormType(currentTab);
            adaptDiscountInputPlaceholder();

            const modal = document.getElementById('offer-modal');
            modal.classList.remove('hidden');
        }

        // Retrieve existing details and map onto target form inputs
        function editOffer(id) {
            const item = dataset.find(x => x.id === id);
            if (!item) return;

            document.getElementById('form-offer-id').value = item.id;
            document.getElementById('form-offer-name').value = item.offerName;
            document.getElementById('form-target-name').value = item.productName;
            document.getElementById('form-discount-type').value = item.discountType;
            document.getElementById('form-discount-val').value = item.discountValue;
            document.getElementById('form-end-date').value = item.endDate;
            document.getElementById('form-status').value = item.status;

            setFormType(item.type);
            adaptDiscountInputPlaceholder();

            document.getElementById('modal-title').innerText = 'Edit Offer Campaign';
            document.getElementById('modal-subtitle').innerText = 'Update configuration specifications for this promotion.';

            const modal = document.getElementById('offer-modal');
            modal.classList.remove('hidden');
        }

        function closeFormModal() {
            document.getElementById('offer-modal').classList.add('hidden');
        }

        // Process submitting campaign forms (Create or Update actions)
        function saveOffer(event) {
            event.preventDefault();

            const id = document.getElementById('form-offer-id').value;
            const offerName = document.getElementById('form-offer-name').value;
            const targetName = document.getElementById('form-target-name').value;
            const discountType = document.getElementById('form-discount-type').value;
            const discountValue = parseFloat(document.getElementById('form-discount-val').value);
            const endDate = document.getElementById('form-end-date').value;
            const status = document.getElementById('form-status').value;

            // Generate temporary visual graphic patterns representation
            let targetImage = '';
            if (activeFormType === 'product') {
                targetImage = 'https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=150&auto=format&fit=crop&q=60';
            } else {
                targetImage = 'https://images.unsplash.com/photo-1483985988355-763728e1935b?w=150&auto=format&fit=crop&q=60';
            }

            if (id) {
                // Update Operation Flow
                const index = dataset.findIndex(x => x.id === parseInt(id));
                if (index !== -1) {
                    dataset[index] = {
                        ...dataset[index],
                        type: activeFormType,
                        productName: targetName,
                        categoryName: activeFormType === 'category' ? targetName : 'Assorted Products',
                        offerName,
                        discountType,
                        discountValue,
                        endDate,
                        status
                    };
                    showNotification('Offer campaign updated successfully!', 'success');
                }
            } else {
                // Create Operation Flow
                const newId = dataset.length > 0 ? Math.max(...dataset.map(x => x.id)) + 1 : 1;
                dataset.push({
                    id: newId,
                    type: activeFormType,
                    productName: targetName,
                    categoryName: activeFormType === 'category' ? targetName : 'Products Line',
                    offerName,
                    discountType,
                    discountValue,
                    endDate,
                    status,
                    image: targetImage
                });
                showNotification('New offer campaign generated successfully!', 'success');
            }

            closeFormModal();
            updateStats();
            renderDashboard();
        }


        // Inspect and review full details inside Modal Popup
        function previewOffer(id) {
            const item = dataset.find(x => x.id === id);
            if (!item) return;

            const isProd = item.type === 'product';
            
            // Map text details
            document.getElementById('preview-badge-type').innerText = isProd ? 'Product Offer' : 'Category Offer';
            document.getElementById('preview-target-name').innerText = item.productName;
            document.getElementById('preview-offer-name').innerText = item.offerName;
            document.getElementById('preview-type').innerText = isProd ? 'Individual Product' : 'Department/Category';
            
            const statusNode = document.getElementById('preview-status');
            statusNode.innerText = item.status;
            if (item.status === 'ACTIVE') {
                statusNode.className = 'px-2 py-0.5 rounded-full inline-block text-[10px] font-bold mt-0.5 bg-green-100 text-green-700';
            } else {
                statusNode.className = 'px-2 py-0.5 rounded-full inline-block text-[10px] font-bold mt-0.5 bg-gray-100 text-gray-500';
            }

            const discountText = item.discountType === 'PERCENTAGE' 
                ? `${item.discountValue}% Off` 
                : `$${parseFloat(item.discountValue).toFixed(2)} Fixed`;
            document.getElementById('preview-discount').innerText = discountText;

            // Date Format
            const formattedDate = new Date(item.endDate).toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric'
            });
            document.getElementById('preview-end-date').innerText = formattedDate;

            // Generate Preview Image or Placeholder
            const avatarWrap = document.getElementById('preview-avatar-wrap');
            if (item.image) {
                avatarWrap.innerHTML = `<img src="${item.image}" class="w-full h-full object-cover" />`;
            } else {
                avatarWrap.style.backgroundColor = '#8C6239';
                avatarWrap.innerHTML = `<span>${item.productName.charAt(0)}</span>`;
            }

            // Set front-store mock text banner
            document.getElementById('preview-banner-text').innerText = `${discountText} on ${item.productName}!`;

            document.getElementById('preview-modal').classList.remove('hidden');
        }

        function closePreviewModal() {
            document.getElementById('preview-modal').classList.add('hidden');
        }

        // Toggle state of inactive promotions (Set ACTIVE again)
        function restoreOffer(id) {
            const index = dataset.findIndex(x => x.id === id);
            if (index !== -1) {
                dataset[index].status = 'ACTIVE';
                showNotification(`Successfully restored campaign "${dataset[index].offerName}"!`, 'success');
                updateStats();
                renderDashboard();
            }
        }

        // Perform Soft/Hard Campaign removal operation
        function deleteOffer(id) {
            const index = dataset.findIndex(x => x.id === id);
            if (index !== -1) {
                const targetName = dataset[index].offerName;
                
                // If it is active, mark it expired as warning first, otherwise delete permanently
                if (dataset[index].status === 'ACTIVE') {
                    dataset[index].status = 'EXPIRED';
                    showNotification(`"${targetName}" campaign has been set to EXPIRED. Click trash icon again to remove completely.`, 'danger');
                } else {
                    dataset.splice(index, 1);
                    showNotification(`"${targetName}" deleted permanently from registry.`, 'danger');
                }
                
                updateStats();
                renderDashboard();
            }
        }

        // Mock Sign Out alert simulation
        function handleLogout() {
            showNotification('Signing out from Velvet Vogue administrative panel...', 'info');
            setTimeout(() => {
                showNotification('Session terminated securely.', 'success');
            }, 1000);
        }
    </script>
</body>
</html>