            },
            {
                id: 3,
                type: 'product',
                productName: 'Cashmere Knitwear',
                categoryName: 'Knitwear',
                offerName: 'Winter Special',
                discountType: 'PERCENTAGE',
                discountValue: 15,
                endDate: '2024-12-15',
                status: 'ACTIVE',
                image: 'https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?w=150&auto=format&fit=crop&q=60'
            },
            {
                id: 4,
                type: 'category',
                productName: 'Handbags Collection',
                categoryName: 'Accessories',
                offerName: 'Lux Bags Special',
                discountType: 'PERCENTAGE',
                discountValue: 20,
                endDate: '2026-09-30',
                status: 'ACTIVE',
