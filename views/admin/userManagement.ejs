<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Velvet Vogue - User Management</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #F4F3F2; /* Warm grey background from image */
        }

        /* Custom Velvet Vogue Colors */
        .bg-sidebar { background-color: #EBE6E1; }
        .text-brown-main { color: #8B6E4E; }
        .bg-brown-main { background-color: #8B6E4E; }
        .bg-brown-hover { background-color: #A08362; }
        .active-nav { background-color: #A08362; color: white; }

        /* Mobile Sidebar Transition */
        #mobile-sidebar {
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .sidebar-hidden { transform: translateX(-100%); }
    </style>
</head>
<body class="text-gray-700">

    <!-- Mobile Header -->
    <header class="lg:hidden flex items-center justify-between p-4 bg-white border-b sticky top-0 z-50">
        <div class="flex items-center gap-2">
            <i data-lucide="sparkles" class="text-brown-main w-6 h-6"></i>
            <span class="font-bold text-brown-main">Velvet Vogue</span>
        </div>
        <button id="menu-toggle" class="p-2 text-gray-500">
            <i data-lucide="menu"></i>
        </button>
    </header>

    <div class="flex min-h-screen">
        <!-- Sidebar - Desktop -->
        <aside class="hidden lg:flex w-64 flex-col bg-sidebar border-r fixed h-full">
            <div class="p-8 flex items-center gap-3">
                <div class="w-10 h-10 bg-brown-main rounded-xl flex items-center justify-center shadow-md">
                    <i data-lucide="sparkles" class="text-white w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="font-bold text-xl leading-tight text-brown-main">Velvet Vogue</h1>
                    <p class="text-[10px] uppercase tracking-widest text-gray-500 font-semibold">Admin Panel</p>
                </div>
            </div>
            
            <nav class="flex-1 px-4 space-y-1">
                <% const navItems = [
                    { name: 'Dashboard', icon: 'layout-grid', active: false },
                    { name: 'Products', icon: 'package', active: false },
                    { name: 'Orders', icon: 'shopping-cart', active: false },
                    { name: 'Users', icon: 'users', active: true },
                    { name: 'Categories', icon: 'layers', active: false },
                    { name: 'Coupons', icon: 'ticket', active: false },
                    { name: 'Banners', icon: 'image', active: false },
                    { name: 'Sales Report', icon: 'bar-chart-3', active: false },
                    { name: 'Offers', icon: 'percent', active: false }
                ] %>

                <% navItems.forEach(item => { %>
                <a href="#" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-200 <%= item.active ? 'active-nav shadow-lg shadow-brown-main/20' : 'text-gray-500 hover:bg-gray-200/50' %>">
                    <i data-lucide="<%= item.icon %>" class="w-5 h-5"></i>
                    <span class="font-medium"><%= item.name %></span>
                </a>
                <% }) %>
            </nav>

            <div class="p-6 border-t border-gray-200">
                <a href="#" class="flex items-center gap-3 px-4 py-3 text-rose-600 hover:bg-rose-50 rounded-xl transition-colors">
                    <i data-lucide="log-out" class="w-5 h-5"></i>
                    <span class="font-medium">Sign Out</span>
                </a>
            </div>
        </aside>

        <!-- Mobile Sidebar Overlay -->
        <div id="mobile-sidebar-container" class="hidden lg:hidden fixed inset-0 z-[60]">
            <div id="sidebar-overlay" class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
            <aside id="mobile-sidebar" class="sidebar-hidden absolute left-0 top-0 h-full w-4/5 max-w-xs bg-sidebar flex flex-col shadow-2xl">
                <div class="p-6 border-b flex items-center justify-between">
                    <span class="font-bold text-brown-main">Velvet Vogue</span>
                    <button id="menu-close"><i data-lucide="x" class="text-gray-400"></i></button>
                </div>
                <nav class="p-4 flex-1 overflow-y-auto">
                    <!-- Same Nav Items for Mobile -->
                    <% navItems.forEach(item => { %>
                    <a href="#" class="flex items-center gap-3 px-4 py-3 mb-1 rounded-xl <%= item.active ? 'active-nav' : 'text-gray-500' %>">
                        <i data-lucide="<%= item.icon %>" class="w-5 h-5"></i>
                        <span><%= item.name %></span>
                    </a>
                    <% }) %>
                </nav>
            </aside>
        </div>

        <!-- Main Content -->
        <main class="flex-1 lg:ml-64 transition-all">
            <!-- Header / Top Bar -->
            <div class="bg-white/80 backdrop-blur-md border-b sticky top-0 z-40 hidden lg:block px-8 py-4">
                <div class="flex items-center justify-between">
                    <div class="relative w-96">
                        <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                        <input type="text" placeholder="Search anything..." class="w-full pl-10 pr-4 py-2 bg-gray-100 border-none rounded-full text-sm focus:ring-2 focus:ring-brown-main/20 outline-none">
                    </div>
                    <div class="flex items-center gap-6">
                        <button class="relative text-gray-400 hover:text-gray-600">
                            <i data-lucide="bell" class="w-5 h-5"></i>
                            <span class="absolute -top-1 -right-1 w-2 h-2 bg-rose-500 rounded-full border-2 border-white"></span>
                        </button>
                        <div class="h-8 w-[1px] bg-gray-200"></div>
                        <div class="flex items-center gap-3">
                            <div class="text-right">
                                <p class="text-sm font-bold text-gray-900"><%= admin.name %></p>
                                <p class="text-[10px] text-gray-400 font-semibold uppercase"><%= admin.role %></p>
                            </div>
                            <img src="<%= admin.avatar %>" alt="Admin" class="w-10 h-10 rounded-full ring-2 ring-brown-main/10" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(admin.name) %>&background=8B6E4E&color=fff'">
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-4 md:p-8">
                <!-- Page Title -->
                <div class="mb-8">
                    <h2 class="text-3xl font-bold text-gray-900 mb-1">User Management</h2>
                    <p class="text-gray-500">Manage, search, and monitor your customer base.</p>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                    <% stats.forEach(stat => { 
                        let iconBg = 'bg-gray-100';
                        let iconColor = 'text-gray-600';
                        let lucideIcon = 'users';

                        if (stat.label.includes('Active')) {
                            iconBg = 'bg-emerald-50';
                            iconColor = 'text-emerald-600';
                            lucideIcon = 'user-check';
                        } else if (stat.label.includes('Blocked')) {
                            iconBg = 'bg-rose-50';
                            iconColor = 'text-rose-600';
                            lucideIcon = 'user-x';
                        }
                    %>
                    <div class="bg-white p-6 rounded-3xl shadow-sm border border-white flex items-center gap-6">
                        <div class="w-16 h-16 <%= iconBg %> rounded-2xl flex items-center justify-center">
                            <i data-lucide="<%= lucideIcon %>" class="<%= iconColor %> w-8 h-8"></i>
                        </div>
                        <div>
                            <p class="text-sm text-gray-400 font-medium mb-1"><%= stat.label %></p>
                            <h3 class="text-3xl font-black text-gray-900"><%= stat.count %></h3>
                        </div>
                    </div>
                    <% }) %>
                </div>

                <!-- Main Data Section -->
                <div class="bg-white rounded-[32px] shadow-sm border border-white overflow-hidden">
                    <!-- Action Bar -->
                    <div class="p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-4">
                        <div class="relative w-full md:w-96">
                            <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                            <input type="text" placeholder="Search by name, email or phone..." class="w-full pl-11 pr-4 py-3 bg-gray-50 border border-gray-100 rounded-2xl text-sm focus:ring-2 focus:ring-brown-main/20 outline-none">
                        </div>
                        <div class="flex items-center gap-3 w-full md:w-auto">
                            <button class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 border border-gray-200 rounded-2xl text-sm font-semibold hover:bg-gray-50 transition-colors">
                                <i data-lucide="filter" class="w-4 h-4"></i> Filter
                            </button>
                            <button class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 bg-brown-main text-white rounded-2xl text-sm font-semibold hover:bg-brown-hover shadow-lg shadow-brown-main/20 transition-all">
                                <i data-lucide="plus" class="w-4 h-4"></i> Add User
                            </button>
                        </div>
                    </div>

                    <!-- Table Wrapper -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50/50">
                                <tr>
                                    <th class="px-8 py-5 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Customer</th>
                                    <th class="px-8 py-5 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Email Address</th>
                                    <th class="px-8 py-5 text-[11px] font-bold text-gray-400 uppercase tracking-widest">Join Date</th>
                                    <th class="px-8 py-5 text-[11px] font-bold text-gray-400 uppercase tracking-widest text-center">Status</th>
                                    <th class="px-8 py-5 text-[11px] font-bold text-gray-400 uppercase tracking-widest text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% users.forEach(user => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="px-8 py-6">
                                        <div class="flex items-center gap-4">
                                            <img src="<%= user.avatar %>" alt="<%= user.name %>" class="w-12 h-12 rounded-full bg-orange-100 object-cover border-2 border-white shadow-sm" onerror="this.src='https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.name) %>&background=FDF2F2&color=8B6E4E'">
                                            <div>
                                                <p class="font-bold text-gray-900 leading-none mb-1"><%= user.name %></p>
                                                <p class="text-xs text-gray-400"><%= user.phone %></p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-8 py-6 text-sm text-gray-500 font-medium">
                                        <%= user.email %>
                                    </td>
                                    <td class="px-8 py-6 text-sm text-gray-500">
                                        <%= user.joinDate %>
                                    </td>
                                    <td class="px-8 py-6 text-center">
                                        <span class="inline-block px-4 py-1.5 rounded-full text-[11px] font-bold uppercase tracking-wider <%= user.status === 'Active' ? 'bg-emerald-100 text-emerald-700' : 'bg-rose-100 text-rose-700' %>">
                                            <%= user.status %>
                                        </span>
                                    </td>
                                    <td class="px-8 py-6 text-right">
                                        <button class="px-5 py-2 text-xs font-bold rounded-xl border-2 transition-all <%= user.status === 'Active' ? 'text-rose-500 border-rose-50 hover:bg-rose-50' : 'text-brown-main border-gray-100 hover:bg-gray-50' %>">
                                            <%= user.status === 'Active' ? 'Block Access' : 'Unblock' %>
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="p-8 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-6">
                        <p class="text-sm text-gray-400">Showing <strong><%= pagination.showingStart %></strong> to <strong><%= pagination.showingEnd %></strong> of <strong><%= pagination.totalResults %></strong> results</p>
                        <div class="flex items-center gap-2">
                            <button class="p-2 text-gray-300 hover:text-gray-600 disabled:opacity-30" <%= pagination.currentPage === 1 ? 'disabled' : '' %>>
                                <i data-lucide="chevron-left" class="w-5 h-5"></i>
                            </button>
                            <div class="flex items-center gap-1">
                                <% for(let i=1; i <= Math.min(pagination.totalPages, 4); i++) { %>
                                    <button class="w-10 h-10 rounded-xl font-bold transition-all <%= i === pagination.currentPage ? 'bg-brown-main text-white shadow-lg shadow-brown-main/20' : 'text-gray-400 hover:bg-gray-100' %>">
                                        <%= i %>
                                    </button>
                                <% } %>
                                <% if(pagination.totalPages > 4) { %>
                                    <span class="px-2 text-gray-300 font-bold">...</span>
                                    <button class="w-10 h-10 rounded-xl font-bold text-gray-400 hover:bg-gray-100"><%= pagination.totalPages %></button>
                                <% } %>
                            </div>
                            <button class="p-2 text-gray-300 hover:text-gray-600">
                                <i data-lucide="chevron-right" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        lucide.createIcons();

        // Hamburger Navigation Logic
        const menuBtn = document.getElementById('menu-toggle');
        const closeBtn = document.getElementById('menu-close');
        const sidebarCont = document.getElementById('mobile-sidebar-container');
        const sidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('sidebar-overlay');

        function openMenu() {
            sidebarCont.classList.remove('hidden');
            setTimeout(() => {
                sidebar.classList.remove('sidebar-hidden');
                overlay.classList.add('opacity-100');
            }, 10);
        }

        function closeMenu() {
            sidebar.classList.add('sidebar-hidden');
            overlay.classList.remove('opacity-100');
            setTimeout(() => sidebarCont.classList.add('hidden'), 300);
        }

        menuBtn.onclick = openMenu;
        closeBtn.onclick = closeMenu;
        overlay.onclick = closeMenu;
    </script>
</body>
</html>