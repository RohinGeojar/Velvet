<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Product</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js">
    </script>
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            background-color: #F9FAFB;
        }

        .accent-bg {
            background-color: #8B5E3C;
        }

        .accent-text {
            color: #8B5E3C;
        }

        .accent-border {
            border-color: #8B5E3C;
        }

        .accent-ring:focus {
            --tw-ring-color: #8B5E3C;
        }

        /* Custom scrollbar for better aesthetics */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-input {
            width: 100%;
            padding: 14px 18px;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            outline: none;
            transition: all 0.2s ease;
            background: #ffffff;
            color: #111827;
            font-size: 14px;
            line-height: 1.5;
        }

        .cropper-container {
            width: 100% !important;
        }

        .cropper-view-box,
        .cropper-face {
            border-radius: 0;
        }

        .form-input:focus {
            border-color: #8B5E3C;
            box-shadow: 0 0 0 4px rgba(139, 94, 60, 0.12);
        }

        .card-shadow {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }

        .custom-toggle {

            width: 56px;
            height: 30px;

            background: #d1d5db;

            border-radius: 9999px;

            position: relative;

            cursor: pointer;

            transition: all 0.3s ease;
        }

        .custom-toggle.active {

            background: #8B5E3C;
        }

        .toggle-circle {

            width: 24px;
            height: 24px;

            background: white;

            border-radius: 50%;

            position: absolute;

            top: 3px;
            left: 3px;

            display: flex;
            align-items: center;
            justify-content: center;

            transition: all 0.3s ease;
        }

        .custom-toggle.active .toggle-circle {

            transform: translateX(26px);
        }
    </style>
</head>

<body class="text-gray-900 ">
    <%- include("../partials/admin/adminSidebar") %>
        <header class="fixed top-0 left-[260px] right-0 z-50 bg-white border-b border-gray-100 px-8 py-4">
            <div class=" flex justify-between items-center">
                <!-- Search Bar -->
                <div class="relative w-96">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                        <i data-lucide="search" class="w-5 h-5"></i>
                    </span>
                    <input type="text" placeholder="Search anything..."
                        class="w-full pl-10 pr-4 py-2 bg-gray-50 border-none rounded-xl text-sm focus:ring-2 focus:ring-gray-200 outline-none transition-all">
                </div>

                <!-- Profile and Notifications -->
                <div class="flex items-center space-x-6">
                    <button class="relative p-2 text-gray-500 hover:bg-gray-50 rounded-full transition-colors">
                        <i data-lucide="bell" class="w-6 h-6"></i>
                        <span
                            class="absolute top-2 right-2.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    <div class="flex items-center space-x-3 border-l pl-6">
                        <div class="text-right">
                            <p class="text-sm font-bold text-gray-900">Rohin Geojar</p>
                            <p class="text-xs text-gray-500">Administrator</p>
                        </div>
                        <div
                            class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold border-2 border-white shadow-sm">
                            RG
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="ml-[260px] pt-28 px-8 pb-10">
            <nav class="flex mb-4 text-sm font-medium text-gray-500">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/adminAuth/dashboard"" class=" hover:text-gray-700 transition-colors">Dashboard</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <i data-lucide="chevron-right" class="w-4 h-4 mx-1"></i>
                            <a href="/products" class="hover:text-gray-700 transition-colors">Products</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <i data-lucide="chevron-right" class="w-4 h-4 mx-1"></i>
                            <span class="text-gray-900">Add Product</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <h1 class="text-3xl font-bold text-gray-900 mb-8">Add Product</h1>

            <!-- Form Start -->
            <form id="productForm" action="/products/add" method="POST" class="max-w-7xl mx-auto"
                enctype="multipart/form-data">

                <section class="bg-white rounded-3xl p-8 mb-8 border border-gray-100 card-shadow">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="p-2 bg-amber-50 rounded-lg accent-text">
                            <i data-lucide="info" class="w-5 h-5"></i>
                        </div>
                        <h2 class="text-xl font-bold">General Information</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Name</label>
                            <input type="text" name="productName" placeholder="e.g. Classic Silk Blazer"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="productName"></p>

                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Slug</label>
                            <input type="text" id="slugPreview" readonly name="productSlug"
                                placeholder="Slug  is created automatically"
                                class="form-input accent-ring focus:border-[#8B5E3C]">

                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Title</label>
                            <input type="text" name="productTitle" placeholder="e.g. Premium Autumn Collection 2024"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="productTitle"></p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                        <textarea rows="4" name="description" placeholder="Write detailed product description here..."
                            class="form-input accent-ring focus:border-[#8B5E3C] resize-none"></textarea>
                        <p class="text-red-500 text-sm mt-1 error-text" data-error="description"></p>
                    </div>
                </section>

                <section class="bg-white rounded-3xl p-8 mb-8 border border-gray-100 card-shadow">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="p-2 bg-orange-50 rounded-lg text-orange-600">
                            <i data-lucide="layout-grid" class="w-5 h-5"></i>
                        </div>
                        <h2 class="text-xl font-bold">Category & Details</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Category</label>

                            <select name="category"
                                class="form-input accent-ring focus:border-[#8B5E3C] bg-white appearance-none">

                                <option value="">
                                    Select Category
                                </option>

                                <% categories.forEach(category=> { %>

                                    <option value="<%= category._id %>">

                                        <%= category.name %>

                                    </option>

                                    <% }) %>

                            </select>
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="category"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Material Details</label>
                            <input type="text" name="materialDetails" placeholder="e.g. 100% Cotton, 180 GSM"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="materialDetails"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Material Care</label>
                            <textarea rows="3" name="materialCare" placeholder="e.g. Machine wash cold, tumble dry low"
                                class="form-input accent-ring focus:border-[#8B5E3C] resize-none"></textarea>
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="materialCare"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Shipping Details</label>
                            <textarea rows="3" name="shippingDetails" placeholder="e.g. Ships in 2-4 business days"
                                class="form-input accent-ring focus:border-[#8B5E3C] resize-none"></textarea>
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="shippingDetails"></p>

                        </div>
                    </div>
                </section>


                <div class="mb-6">
                    <div class="flex items-center space-x-3 mb-2">
                        <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600">
                            <i data-lucide="layers" class="w-5 h-5"></i>
                        </div>
                        <h2 class="text-xl font-bold">Product Variants</h2>
                    </div>
                    <p class="text-sm text-gray-500 mb-6">Manage product variants like color, size, price, stock, and
                        images.</p>

                    <!-- Variants Container -->
                    <div id="variantsContainer" class="space-y-8 mb-6">
                        <!-- Variant Card Template will be injected here via JS -->
                    </div>


                    <!-- Add Variant Button -->
                    <button type="button" onclick="addVariant()"
                        class="w-full py-8 border-2 border-dashed border-gray-200 rounded-2xl flex flex-col items-center justify-center space-y-2 text-gray-500 hover:border-[#8B5E3C] hover:text-[#8B5E3C] hover:bg-amber-50/30 transition-all group">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center group-hover:border-[#8B5E3C]">
                            <i data-lucide="plus" class="w-6 h-6"></i>
                        </div>
                        <span class="font-bold">Add New Product Variant</span>
                    </button>
                </div>
                <div class="bg-[#F9FAFB] p-6 rounded-2xl flex justify-between items-center mt-8 border border-gray-50">
                    <div>
                        <p class="text-sm font-bold text-gray-900">
                            Product Status
                        </p>
                        <p class="text-xs text-gray-500">
                            Toggle to set Product active or inactive
                        </p>
                    </div>
                    <input type="hidden" name="isActive" id="statusInput" value="true">
                    <div id="statusToggle" class="custom-toggle active" onclick="toggleStatus()">
                        <div class="toggle-circle">
                            <i id="statusIcon" data-lucide="check" class="w-3 h-3 text-green-500"></i>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end items-center space-x-4 mt-12 mb-20">
                    <button type="button"
                        class="px-8 py-3 border border-gray-300 rounded-xl font-bold text-gray-600 hover:bg-gray-50 transition-colors">
                        Cancel
                    </button>
                    <button type="submit"
                        class="px-8 py-3 accent-bg text-white rounded-xl font-bold shadow-lg shadow-amber-900/20 hover:opacity-90 transition-all flex items-center space-x-2">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        <span>Save Product</span>
                    </button>
                </div>

            </form>
        </main>
        <div id="toast" class="hidden fixed top-5 right-5 text-white px-6 py-3 rounded-xl shadow-lg z-50"></div>
        <div id="cropperModal" class="hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6">
            <div class="bg-white rounded-2xl p-6 w-full max-w-3xl">

                <div class="w-full h-[500px] bg-gray-100 rounded-xl overflow-hidden">

                    <img id="cropperImage" class="block max-w-full" />

                </div>

                <div class="flex justify-end gap-3">

                    <button type="button" id="cancelCrop" class="px-5 py-2 border rounded-xl">
                        Cancel
                    </button>

                    <button type="button" id="cropImageBtn" class="px-5 py-2 bg-black text-white rounded-xl">
                        Crop Image
                    </button>

                </div>
            </div>
        </div>
        <script>

            function toggleStatus() {

                const toggle =
                    document.getElementById(
                        "statusToggle"
                    );

                const input =
                    document.getElementById(
                        "statusInput"
                    );

                const icon =
                    document.getElementById(
                        "statusIcon"
                    );

                toggle.classList.toggle("active");

                const isActive =
                    toggle.classList.contains(
                        "active"
                    );

                input.value = isActive;

                icon.setAttribute(

                    "data-lucide",

                    isActive
                        ? "check"
                        : "x"
                );

                lucide.createIcons();
            }
            let variantCount = 0;
            const allSizes = ["S", "M", "L", "XL"]

            function addVariant() {
                const currentIndex = variantCount;

                variantCount++;
                const variantId = `variant-${currentIndex}`;
                const container = document.getElementById('variantsContainer');

                const variantHTML = `
                <div id="${variantId}" class="bg-white rounded-3xl p-8 border border-gray-100 card-shadow transition-all animate-in fade-in slide-in-from-bottom-4 duration-300">
                    <div class="flex justify-between items-center mb-8 pb-4 border-b border-gray-50">
                        <div class="flex items-center space-x-4">
                            <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400">
                                <i data-lucide="box" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-lg variant-title">Variant: New Variant</h3>
                                <p class="text-xs font-mono text-gray-400 uppercase">SKU: PROD-VAR-${currentIndex.toString().padStart(3, '0')}</p>
                            </div>
                        </div>
                        <button type="button" onclick="removeVariant('${variantId}')" class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all">
                            <i data-lucide="trash-2" class="w-5 h-5"></i>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div class="grid grid-cols-2 gap-4">

    <!-- Color Name -->
    <div>

        <label class="block text-sm font-semibold text-gray-700 mb-2">
            Color Name
        </label>

        <input
            type="text"
            oninput="updateVariantTitle(this, '${variantId}')"
            placeholder="e.g. Olive Green"
            name="variants[${currentIndex}][color]"
            class="form-input accent-ring"
        >

        <p
            class="text-red-500 text-sm mt-1 error-text"
            data-error="variants.${currentIndex}.color"
        ></p>

    </div>

    <!-- Color Picker -->
    <div>

        <label class="block text-sm font-semibold text-gray-700 mb-2">
            Pick Color
        </label>

        <div class="flex items-center gap-4">

            <input
                type="color"
                name="variants[${currentIndex}][colorCode]"
                value="#556B57"
                class="w-16 h-12 p-1 border border-gray-200 rounded-xl cursor-pointer bg-white"
            >

            <span class="text-xs text-gray-500">
                Exact product shade
            </span>

        </div>

        <p
            class="text-red-500 text-sm mt-1 error-text"
            data-error="variants.${currentIndex}.colorCode"
        ></p>

    </div>

</div>
                           
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Regular Price</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">$</span>
                                <input type="number" name="variants[${currentIndex}][regularPrice]" step="0.01" placeholder="0.00" class="form-input pl-8 accent-ring">
                            </div>
                                <p class="text-red-500 text-sm mt-1 error-text" data-error="variants.${currentIndex}.regularPrice"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Sale Price (Optional)</label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">$</span>
                                <input type="number" name="variants[${currentIndex}][salePrice]" step="0.01" placeholder="0.00" class="form-input pl-8 accent-ring">
                                </div>
                                <p class="text-red-500 text-sm mt-1 error-text" data-error="variants.${currentIndex}.salePrice"></p>
                        </div>
                    </div>

                    <div class="mb-8">

    <label class="block text-sm font-semibold text-gray-700 mb-3">
        Variant Images
    </label>

    <div class="flex flex-wrap gap-4">

        <!-- Upload Box -->
        <label
            class="w-24 h-24 border-2 border-dashed border-gray-200 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-[#8B5E3C] hover:bg-amber-50/20 transition-all text-gray-400 group"
        >

            <i 
                data-lucide="upload"
                class="w-6 h-6 mb-1 group-hover:text-[#8B5E3C]"
            ></i>

            <span class="text-[10px] font-bold">
                Upload
            </span>

            <input
                type="file"
                name="variantImages_${currentIndex}"
                multiple
                accept="image/*"
                class="hidden variant-image-input"
                data-variant="${currentIndex}"
            >

        </label>

        <!-- Preview Container -->
        <div
            id="preview-${currentIndex}"
            class="flex flex-wrap gap-4"
        ></div>

    </div>
</div>

                    <div class="bg-gray-50/50 rounded-2xl p-6">
                        <div class="flex justify-between items-center mb-4">
                            <div class="flex items-center space-x-2 text-gray-700">
                                <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                                <h4 class="text-sm font-bold">Stock Per Size</h4>
                            </div>
                            <button type="button" onclick="addSizeRow('${variantId}', ${currentIndex})" class="px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-xs font-bold text-gray-700 flex items-center space-x-1 hover:border-[#8B5E3C] hover:text-[#8B5E3C] transition-all shadow-sm">
                                <i data-lucide="plus" class="w-3 h-3"></i>
                                <span>Add Size</span>
                            </button>
                        </div>
                        
                        
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead>
                                    <tr class="text-[10px] uppercase tracking-wider text-gray-400 font-bold border-b border-gray-200">
                                        <th class="pb-2 font-bold px-2">Size Name</th>
                                        <th class="pb-2 font-bold px-2">Stock Quantity</th>
                                        <th class="pb-2 font-bold px-2 text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="${variantId}-sizes" class="divide-y divide-gray-100">
                                    <!-- Sizes rows go here -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            `;

                container.insertAdjacentHTML('beforeend', variantHTML);
                lucide.createIcons();

                // Add an initial size row for convenience
                addSizeRow(variantId, currentIndex);
            }

            function removeVariant(id) {
                const el = document.getElementById(id);
                el.classList.add('opacity-0', 'scale-95');
                setTimeout(() => el.remove(), 200);
            }

            function updateVariantTitle(input, id) {
                const title = document.querySelector(`#${id} .variant-title`);
                title.textContent = input.value ? `Variant: ${input.value}` : 'Variant: New Variant';
            }

            function addSizeRow(variantId, variantIndex) {
                const tableBody = document.getElementById(`${variantId}-sizes`);
                const currentRows = tableBody.querySelectorAll(".size-select");

                if (currentRows.length >= allSizes.length) {
                    return;
                }
                const sizeIndex = tableBody.children.length;
                const rowId = `row-${Date.now()}`;

                const rowHTML = `
<tr id="${rowId}" class="group">
    
    <td class="py-3 px-2">
        <select name="variants[${variantIndex}][sizes][${sizeIndex}][size]"
            onchange="updateAvailableSizes('${variantId}')"
            class="w-full size-select bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-[#8B5E3C]/20 focus:border-[#8B5E3C] transition-all">
            
            <option value="">Select Size</option>
            <option value="S">S</option>
            <option value="M">M</option>
            <option value="L">L</option>
            <option value="XL">XL</option>
        </select>
         <p class="text-red-500 text-sm mt-1 error-text" data-error="variants.${variantIndex}.sizes.${sizeIndex}.size"></p>
    </td>

    <td class="py-3 px-2">
        <input
       name="variants[${variantIndex}][sizes][${sizeIndex}][stock]"
            type="number"
            placeholder="Enter quantity"
            class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-[#8B5E3C]/20 focus:border-[#8B5E3C] transition-all"
        >
         <p class="text-red-500 text-sm mt-1 error-text" data-error="variants.${variantIndex}.sizes.${sizeIndex}.stock"></p>
    </td>

    <td class="py-3 px-2 text-right">
        <button
            type="button"
            onclick="removeSizeRow('${rowId}', '${variantId}')"
            class="p-3 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-all">
            
            <i data-lucide="trash-2" class="w-4 h-4"></i>
        </button>
    </td>

</tr>

`

                tableBody.insertAdjacentHTML('beforeend', rowHTML)
                updateAvailableSizes(variantId)
                lucide.createIcons();
            }

            function removeSizeRow(rowId, variantId) {
                document.getElementById(rowId).remove()
                updateAvailableSizes(variantId);
            }
            const nameInput = document.querySelector('input[name="productName"]')
            const slugPreview = document.getElementById("slugPreview")

            nameInput.addEventListener("input", function () {

                const slug = this.value
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, "-")
                    .replace(/-+/g, "-")

                slugPreview.value = slug

            })


            // =========================================================

            function updateAvailableSizes(variantId) {

                const container = document.getElementById(`${variantId}-sizes`);

                const selects = container.querySelectorAll(".size-select");

                // currently selected sizes
                const selectedSizes = [];

                selects.forEach(select => {

                    if (select.value) {
                        selectedSizes.push(select.value);
                    }
                });

                // update each dropdown
                selects.forEach(select => {

                    const currentValue = select.value;

                    select.innerHTML = `<option value="">Select Size</option>`;

                    allSizes.forEach(size => {


                        if (
                            !selectedSizes.includes(size) ||
                            size === currentValue
                        ) {

                            select.innerHTML += `
                    <option 
                        value="${size}"
                        ${size === currentValue ? "selected" : ""}
                    >
                        ${size}
                    </option>
                `;
                        }
                    });
                });
            }
            // ==================================

            function showErrors(errors) {

                // clear old errors
                document.querySelectorAll(".error-text")
                    .forEach(el => el.textContent = "");

                errors.forEach(error => {

                    const path = error.path.join(".");

                    const errorElement = document.querySelector(
                        `[data-error="${path}"]`
                    );

                    if (errorElement) {
                        errorElement.textContent = error.message;
                    }
                });
            }
              // ==================================
    // LIVE ERROR CLEARING
    // ==================================

    document.addEventListener("input", function (e) {

        const name = e.target.name;

        if (!name) return;

        const path = name
            .replace(/\[/g, ".")
            .replace(/\]/g, "")
            .replace(/\.\./g, ".");

        const errorElement =
            document.querySelector(
                `[data-error="${path}"]`
            );

        if (errorElement) {

            errorElement.textContent = "";

        }

    });

    document.addEventListener("change", function (e) {

        const name = e.target.name;

        if (!name) return;

        const path = name
            .replace(/\[/g, ".")
            .replace(/\]/g, "")
            .replace(/\.\./g, ".");

        const errorElement =
            document.querySelector(
                `[data-error="${path}"]`
            );

        if (errorElement) {

            errorElement.textContent = "";

        }

    });

            // ================================= 

            const productForm =
                document.getElementById("productForm");

            productForm.addEventListener(
                "submit",
                async function (e) {

                    e.preventDefault();

                    // clear old errors
                    document
                        .querySelectorAll(".error-text")
                        .forEach(el => el.textContent = "");

                    // image validation
                    const imageInputs =
                        document.querySelectorAll(
                            ".variant-image-input"
                        );

                    

                    try {

                        const formData =
                            new FormData(productForm);

                        const response = await fetch(

                            "/products/add",

                            {
                                method: "POST",

                                body: formData
                            }
                        );

                        const data = await response.json();

                        // ================= SUCCESS =================

                        if (data.success) {

                            showToast(
                                data.message,
                                "success"
                            );

                            productForm.reset();
                            window.location.href =
                                data.redirect;

                            return;
                        }

                        // ================= VALIDATION =================

                        if (data.errors) {

                            showErrors(data.errors);
                        }
                        for (const input of imageInputs) {

                        if (input.files.length < 3) {

                            showToast(
                                "Each variant must contain at least 3 images",
                                "error"
                            );

                            return;
                        }
                    }

                    } catch (error) {

                        console.log(error);

                        showToast(
                            "Something went wrong",
                            "error"
                        );
                    }
                }
            );
            function showToast(message, type = "success") {

                const toast = document.getElementById("toast");

                toast.textContent = message;

                toast.classList.remove("hidden");

                // reset colors
                toast.classList.remove(
                    "bg-green-500",
                    "bg-red-500"
                );

                if (type === "error") {

                    toast.classList.add("bg-red-500");

                } else {

                    toast.classList.add("bg-green-500");
                }

                setTimeout(() => {

                    toast.classList.add("hidden");

                }, 3000);
            }


            // ==========================================
            // IMAGE CROPPER SYSTEM
            // ==========================================

            let cropper;

            const variantImageStore = {};

            let activeVariant = null;

            let activeImageIndex = null;

            let currentInput = null;
            const cropperModal =
                document.getElementById("cropperModal");

            const cropperImage =
                document.getElementById("cropperImage");

            const cropImageBtn =
                document.getElementById("cropImageBtn");

            const cancelCrop =
                document.getElementById("cancelCrop");


            // ==========================================
            // IMAGE SELECT
            // ==========================================

            document.addEventListener("change", function (e) {

                if (
                    e.target.classList.contains("variant-image-input")
                ) {

                    const files = Array.from(e.target.files);

                    const variantIndex =
                        e.target.dataset.variant;

                    // ================= VALIDATION =================

                    const existingCount =
                        variantImageStore[variantIndex]
                            ? variantImageStore[variantIndex].length
                            : 0;

                    if (existingCount + files.length > 5) {

                        showToast(
                            "Maximum 5 images allowed",
                            "error"
                        );

                        e.target.value = "";

                        return;
                    }
                    for (const file of files) {

                        if (!file.type.startsWith("image/")) {

                            showToast(
                                "Only image files are allowed",
                                "error"
                            );

                            e.target.value = "";

                            return;
                        }

                        if (file.size > 5 * 1024 * 1024) {

                            showToast(
                                "Each image must be less than 5MB",
                                "error"
                            );

                            e.target.value = "";

                            return;
                        }
                    }

                    currentInput = e.target;

                    activeVariant = variantIndex;

                    // initialize variant store
                    if (!variantImageStore[variantIndex]) {

                        variantImageStore[variantIndex] = [];
                    }

                    // store files
                    files.forEach(file => {

                        variantImageStore[variantIndex].push({

                            originalFile: file,

                            croppedFile: file,

                            previewUrl: URL.createObjectURL(file)
                        });
                    });

                    renderPreviews(variantIndex);

                    // auto open first image
                    activeImageIndex =
                        variantImageStore[variantIndex].length
                        - files.length;

                    openCropper(
                        variantImageStore[variantIndex][activeImageIndex]
                            .croppedFile
                    );
                }
            });


            // ==========================================
            // RENDER PREVIEWS
            // ==========================================

            function renderPreviews(variantIndex) {

                const container =
                    document.getElementById(
                        `preview-${variantIndex}`
                    );

                container.innerHTML = "";

                variantImageStore[variantIndex]
                    .forEach((image, index) => {

                        const preview = document.createElement("div");

                        preview.className =
                            "relative w-24 h-24";

                        preview.innerHTML = `

                <img
                    src="${image.previewUrl}"
                    class="w-full h-full object-cover rounded-xl border"
                >

                <button
                    type="button"
                    onclick="editImage(${variantIndex}, ${index})"
                    class="absolute top-1 left-1 bg-black/70 text-white text-xs px-2 py-1 rounded-lg"
                >
                    ✎
                </button>

                <button
                    type="button"
                    onclick="removeImage(${variantIndex}, ${index})"
                    class="absolute top-1 right-1 bg-red-500 text-white text-xs px-2 py-1 rounded-lg"
                >
                    ✕
                </button>
            `;

                        container.appendChild(preview);
                    });

                syncInputFiles(variantIndex);
            }


            // ==========================================
            // OPEN CROPPER
            // ==========================================

            function openCropper(file) {

                const imageURL = URL.createObjectURL(file);

                cropperModal.classList.remove("hidden");

                // destroy old cropper
                if (cropper) {

                    cropper.destroy();

                    cropper = null;
                }

                // reset image
                cropperImage.src = "";

                // IMPORTANT
                requestAnimationFrame(() => {

                    cropperImage.src = imageURL;

                    cropperImage.onload = function () {

                        cropper = new Cropper(cropperImage, {

                            aspectRatio: NaN,

                            viewMode: 1,

                            dragMode: "move",
                            autoCrop: true,

                            autoCropArea: 0.8,

                            responsive: true,

                            background: false,

                            movable: true,

                            zoomable: true,

                            scalable: true,

                            cropBoxMovable: true,

                            cropBoxResizable: true,

                            guides: true,

                            center: true,

                            highlight: true,

                            minCropBoxWidth: 50,

                            minCropBoxHeight: 50
                        });
                    };
                });
            }

            // ==========================================
            // EDIT IMAGE
            // ==========================================

            function editImage(variantIndex, imageIndex) {

                activeVariant = variantIndex;

                activeImageIndex = imageIndex;

                const image =
                    variantImageStore[variantIndex][imageIndex];

                openCropper(image.croppedFile);
            }


            // ==========================================
            // REMOVE IMAGE
            // ==========================================

            function removeImage(variantIndex, imageIndex) {

                variantImageStore[variantIndex]
                    .splice(imageIndex, 1);

                renderPreviews(variantIndex);

                showToast(
                    "Image removed",
                    "success"
                );
            }


            // ==========================================
            // CANCEL CROPPER
            // ==========================================

            document
                .getElementById("cancelCrop")
                .addEventListener("click", function () {

                    cropperModal.classList.add("hidden");

                    if (cropper) {
                        cropper.destroy();
                        cropper = null
                    }
                });


            // ==========================================
            // SAVE CROPPED IMAGE
            // ==========================================

            document
                .getElementById("cropImageBtn")
                .addEventListener("click", function () {

                    if (!cropper) return;

                    const canvas = cropper.getCroppedCanvas({

                        width: 800,

                        height: 1000
                    });

                    canvas.toBlob((blob) => {

                        const croppedFile = new File(
                            [blob],
                            `cropped-${Date.now()}.jpg`,
                            {
                                type: "image/jpeg"
                            }
                        );

                        // update image store
                        variantImageStore[activeVariant][activeImageIndex] = {

                            originalFile:
                                variantImageStore[activeVariant][activeImageIndex]
                                    .originalFile,

                            croppedFile,

                            previewUrl: URL.createObjectURL(blob)
                        };

                        renderPreviews(activeVariant);

                        cropperModal.classList.add("hidden");

                        cropper.destroy();

                        showToast(
                            "Image cropped successfully",
                            "success"
                        );

                    }, "image/jpeg", 0.8);
                });


            // ==========================================
            // SYNC INPUT FILES
            // ==========================================

            function syncInputFiles(variantIndex) {

                const dataTransfer = new DataTransfer();

                variantImageStore[variantIndex]
                    .forEach(image => {

                        dataTransfer.items.add(
                            image.croppedFile
                        );
                    });

                const input = document.querySelector(
                    `[data-variant="${variantIndex}"]`
                );

                input.files = dataTransfer.files;
            }

            // Initialize with one variant on load
            window.onload = () => {
                addVariant();
                lucide.createIcons();
            };
        </script>
</body>

</html>