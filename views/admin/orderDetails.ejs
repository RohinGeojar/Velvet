<div id="reasonModal"
    class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center z-[100] p-4">

    <div id="reasonModalBox"
        class="bg-white w-full max-w-md rounded-2xl shadow-2xl overflow-hidden transform scale-95 opacity-0 transition-all duration-200">

        <!-- Header -->
        <div id="reasonModalHeader"
            class="px-6 py-5 border-b border-gray-100 flex items-center justify-between">

            <div class="flex items-center gap-3">

                <div id="reasonModalIcon"
                    class="w-10 h-10 rounded-full flex items-center justify-center">

                    <i id="reasonModalIconElement"
                        class="fa-solid fa-circle-info">
                    </i>

                </div>

                <div>
                    <h3 id="reasonModalTitle"
                        class="text-lg font-bold text-gray-900">
                        Reason
                    </h3>

                    <p class="text-xs text-gray-500 mt-0.5">
                        Customer provided reason
                    </p>
                </div>

            </div>

            <button
                type="button"
                onclick="closeReasonModal()"
                class="w-8 h-8 rounded-full flex items-center justify-center
                       text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <!-- Reason -->
        <div class="p-6">

            <div id="reasonContent"
                class="bg-gray-50 border border-gray-200 rounded-xl p-4 text-sm text-gray-700 leading-6 break-words">
            </div>

        </div>

        <!-- Footer -->
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex justify-end">

            <button
                type="button"
                onclick="closeReasonModal()"
                class="px-5 py-2.5 bg-gray-900 hover:bg-gray-800 text-white
                       rounded-lg text-sm font-semibold transition">

                Close

            </button>

        </div>

    </div>

</div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
   

    let currentStatus = "<%= order.orderStatus %>"

function loadStatusOptions() {

    const statusSelect = document.getElementById("status-selector")

    let options = []

    switch (currentStatus) {

        case "Pending":

            options = ["Pending", "Confirmed", "Cancelled"]

            break

        case "Confirmed":

            options = ["Confirmed", "Shipped", "Cancelled"]

            break

        case "Shipped":

            options = ["Shipped", "Delivered"]

            break

        case "Delivered":

            options = ["Delivered", "Returned"]

            break

        case "Cancelled":

            options = ["Cancelled"]

            break

        case "Returned":

            options = ["Returned"]

            break

    }

    statusSelect.innerHTML = ""

    options.forEach(status => {

        statusSelect.innerHTML += `
            <option value="${status}" ${status === currentStatus ? "selected" : ""}>
                ${status}
            </option>
        `

    })

}

loadStatusOptions()

async function updateOrderStatus() {

    const status = document.getElementById("status-selector").value

    try {

        const response = await fetch("/orderManagement/<%= order._id %>/status", {

            method: "PATCH",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify({
                status
            })

        })

        const data = await response.json()

        if (data.success) {

            Swal.fire({

                icon: "success",

                title: "Success",

                text: data.message,

                timer: 1500,

                showConfirmButton: false

            }).then(() => {

                location.reload()

            })

        } else {

            Swal.fire({

                icon: "error",

                title: "Error",

                text: data.message

            })

        }

    } catch (error) {

        Swal.fire({

            icon: "error",

            title: "Error",

            text: "Something went wrong"

        })

    }

}



// ==========================================

async function approveReturn(orderId, itemId) {

    const response = await fetch(
        `/orderManagement/${orderId}/items/${itemId}/approveReturn`,
        {
            method: "PATCH"
        }
    );

    const data = await response.json();

    if (data.success) {

        Swal.fire({
            icon: "success",
            title: "Return Approved",
            text: data.message
        }).then(() => location.reload());

    } else {

        Swal.fire({
            icon: "error",
            title: "Failed",
            text: data.message
        });

    }
}

async function rejectReturn(orderId, itemId) {

    const { value: reason } = await Swal.fire({

        title: "Reject Return",

        input: "textarea",

        inputPlaceholder: "Reason for rejection",

        showCancelButton: true,

        confirmButtonText: "Reject"

    });

    if (!reason) return;

    const response = await fetch(
        `/orderManagement/${orderId}/items/${itemId}/rejectReturn`,
        {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({ reason })
        }
    );

    const data = await response.json();

    if (data.success) {

        Swal.fire({
            icon: "success",
            title: "Rejected",
            text: data.message
        }).then(() => location.reload());

    } else {

        Swal.fire({
            icon: "error",
            title: "Failed",
            text: data.message
        });

    }
}
function showReasonFromButton(button, title) {

    const reason = button.dataset.reason || "No reason provided."
    const type = button.dataset.reasonType || "return"

    console.log("Reason clicked:", reason)

    showReasonModal(title, reason, type)
}

function showReasonModal(title, reason, type) {

    const modal = document.getElementById("reasonModal")
    const box = document.getElementById("reasonModalBox")
    const modalTitle = document.getElementById("reasonModalTitle")
    const reasonContent = document.getElementById("reasonContent")
    const iconContainer = document.getElementById("reasonModalIcon")
    const icon = document.getElementById("reasonModalIconElement")

    console.log("Reason modal:", {
        title,
        reason,
        type
    })

    modalTitle.textContent = title
    reasonContent.textContent = reason || "No reason provided."

    if (type === "cancelled") {

        iconContainer.className =
            "w-10 h-10 rounded-full bg-red-100 flex items-center justify-center"

        icon.className =
            "fa-solid fa-ban text-red-600"

        reasonContent.className =
            "bg-red-50 border border-red-100 rounded-xl p-4 text-sm text-red-700 leading-6 break-words"

    } else {

        iconContainer.className =
            "w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center"

        icon.className =
            "fa-solid fa-arrow-rotate-left text-orange-600"

        reasonContent.className =
            "bg-orange-50 border border-orange-100 rounded-xl p-4 text-sm text-orange-700 leading-6 break-words"
    }

    modal.classList.remove("hidden")
    modal.classList.add("flex")

    requestAnimationFrame(() => {

        box.classList.remove("scale-95", "opacity-0")
        box.classList.add("scale-100", "opacity-100")

    })
}


function closeReasonModal() {

    const modal = document.getElementById("reasonModal")
    const box = document.getElementById("reasonModalBox")

    box.classList.remove("scale-100", "opacity-100")
    box.classList.add("scale-95", "opacity-0")

    setTimeout(() => {

        modal.classList.remove("flex")
        modal.classList.add("hidden")

    }, 200)
}


document.getElementById("reasonModal").addEventListener("click", function (event) {

    if (event.target === this) {
        closeReasonModal()
    }

})


document.addEventListener("keydown", function (event) {

    if (event.key === "Escape") {
        closeReasonModal()
    }

})





const itemStatuses = {
    Pending: ["Pending", "Confirmed", "Cancelled"],
    Confirmed: ["Confirmed", "Shipped", "Cancelled"],
    Shipped: ["Shipped", "Delivered"],
    Delivered: ["Delivered"],
    Cancelled: ["Cancelled"],
    "Return Requested": ["Return Requested"],
    Returned: ["Returned"]
}

function loadItemStatusOptions() {

    document.querySelectorAll("[id^='item-status-']").forEach(select => {

        const itemId = select.id.replace("item-status-", "")
        const currentStatus = select.dataset.status

        const options = itemStatuses[currentStatus] || [currentStatus]

        select.innerHTML = ""

        options.forEach(status => {

            select.innerHTML += `
                <option value="${status}" ${status === currentStatus ? "selected" : ""}>
                    ${status}
                </option>
            `
        })
    })
}
loadItemStatusOptions()

async function updateItemStatus(orderId, itemId) {

    const select = document.getElementById(`item-status-${itemId}`)
    const status = select.value

    try {

        const response = await fetch(
            `/orderManagement/${orderId}/items/${itemId}/status`,
            {
                method: "PATCH",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    status
                })
            }
        )

        const data = await response.json()

        if (data.success) {

            Swal.fire({
                icon: "success",
                title: "Success",
                text: data.message,
                timer: 1500,
                showConfirmButton: false
            }).then(() => {
                location.reload()
            })

        } else {

            Swal.fire({
                icon: "error",
                title: "Error",
                text: data.message
            })

        }

    } catch (error) {

        console.log("Update item status error:", error)

        Swal.fire({
            icon: "error",
            title: "Error",
            text: "Something went wrong"
        })
    }
}
</script>
   
       

    