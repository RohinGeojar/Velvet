                            <button onclick="updateOrderStatus()" class="w-full py-3 bg-[#8C6239] hover:bg-[#754F2E] active:scale-[0.99] text-white font-bold text-sm rounded-xl shadow-md shadow-brand-500/10 transition-all flex items-center justify-center gap-2">
                                <i data-lucide="save" class="w-4 h-4"></i>
                                Update Status
                            </button>
                            
                            <div class="pt-2">
                                <button onclick="openRefundModal()" class="w-full py-2.5 bg-white border border-red-200 hover:bg-red-50 text-red-600 font-bold text-sm rounded-xl transition-all flex items-center justify-center gap-2">
                                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                                    Refund Order
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
            
        </main>
    </div>

    <!-- MOCK VIEWPORT FOR COLLAB PLACEHOLDER CHATBOX SYNC -->
    <div id="navigation-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 text-center space-y-4">
            <div class="w-12 h-12 bg-brand-50 text-brand-600 rounded-full flex items-center justify-center mx-auto">
                <i data-lucide="info" class="w-6 h-6"></i>
            </div>
            <div>
                <h3 id="nav-modal-title" class="text-lg font-bold text-slate-800">Tab Switched</h3>
                <p id="nav-modal-text" class="text-sm text-slate-500 mt-1">This is a dynamic template mockup view. Navigation to other sidebar pages is simulated!</p>
            </div>
            <button onclick="closeNavModal()" class="px-5 py-2.5 bg-brand-500 text-white rounded-xl text-sm font-semibold hover:bg-brand-600 transition-colors">
                Back to Order Details
            </button>
        </div>
    </div>

    <!-- REFUND CONFIRMATION MODAL -->
    <div id="refund-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 space-y-4">
            <div class="w-12 h-12 bg-red-50 text-red-600 rounded-full flex items-center justify-center">
                <i data-lucide="alert-triangle" class="w-6 h-6"></i>
            </div>
            <div>
                <h3 class="text-lg font-bold text-slate-800">Refund Order #ORD-1024?</h3>
                <p class="text-sm text-slate-500 mt-1">This action will process a full refund of <strong id="refund-amount-text" class="text-brand-700">$0.00</strong> to John Doe's original payment method (Razorpay). This transaction cannot be undone.</p>
            </div>
            <!-- Reason Dropdown -->
            <div>
                <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase">Reason for Refund</label>
                <select class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                    <option>Customer Return / Dislike</option>
                    <option>Wrong Size / Fits Incorrectly</option>
                    <option>Product Defect / Damaged</option>
                    <option>Order Cancelled before shipment</option>
                </select>
            </div>
            <!-- Modal Actions -->
            <div class="flex items-center justify-end gap-2.5 pt-2">
                <button onclick="closeRefundModal()" class="px-4 py-2 border border-slate-200 hover:bg-slate-50 rounded-xl text-xs font-semibold text-slate-600 transition-colors">
                    Cancel
                </button>
                <button onclick="confirmRefund()" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-xl text-xs font-semibold shadow-md shadow-red-500/10 transition-all">
                    Yes, Issue Refund
                </button>
            </div>
        </div>
    </div>

    <!-- MOCK ADD ITEM MODAL -->
    <div id="add-item-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 space-y-4">
            <div class="flex items-center justify-between border-b border-slate-50 pb-3">
                <h3 class="text-lg font-bold text-slate-800">Add Mock Fashion Item</h3>
                <button onclick="closeAddItemModal()" class="text-slate-400 hover:text-slate-600">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            
            <div class="space-y-3.5">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase">Select Velvet Vogue Item</label>
                    <select id="item-selector" class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                        <option value="1">Double Breasted Woolen Trench Coat ($240.00)</option>
                        <option value="2">Gold-Embroidered Velvet Slippers ($85.00)</option>
                        <option value="3">Cashmere Cable Knit Sweater ($150.00)</option>
                        <option value="4">Satin Tailored Blazer - Ivory ($195.00)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1.5 uppercase">Quantity</label>
                    <input id="item-qty-input" type="number" min="1" max="10" value="1" class="w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-brand-500">
                </div>
            </div>

            <!-- Modal Actions -->
            <div class="flex items-center justify-end gap-2.5 pt-2">
                <button onclick="closeAddItemModal()" class="px-4 py-2 border border-slate-200 hover:bg-slate-50 rounded-xl text-xs font-semibold text-slate-600 transition-colors">
                    Cancel
                </button>
                <button onclick="addMockItemSubmit()" class="px-4 py-2 bg-[#8C6239] hover:bg-[#754F2E] text-white rounded-xl text-xs font-semibold shadow-md shadow-brand-500/10 transition-all">
                    Add to Invoice
                </button>
            </div>
        </div>
    </div>

    <!-- GLOBAL NOTIFICATION TOAST -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white rounded-xl py-3 px-5 shadow-2xl flex items-center gap-3 translate-y-24 opacity-0 transition-all duration-300">
        <div id="toast-icon-wrapper" class="p-1 rounded-full bg-brand-500 text-white flex items-center justify-center">
            <i data-lucide="check" class="w-4 h-4"></i>
        </div>
        <div>
            <p id="toast-title" class="text-xs font-bold leading-tight">Notification</p>
            <p id="toast-desc" class="text-[11px] text-slate-300">Success message body.</p>
        </div>
    </div>

    <!-- APPLICATION SCRIPTS -->
    <script>
        // Init state
        let orderItems = [
            {
                id: 'silk-evening-dress',
                name: 'Silk Evening Dress',
                sku: 'VV-SED-001',
                variant: 'Midnight Blue / Medium',
                price: 120.00,
                qty: 1,
                image: 'https://images.unsplash.com/photo-1595777457583-95e059d581b8?auto=format&fit=crop&q=80&w=120' // high fashion dress fallback
            }
        ];

        // Constants
        const SHIPPING = 10.00;
        const DISCOUNT = 5.00;
        const TAX_RATE = 0.08;

        // Mock Preset Products Database
        const MOCK_PRODUCTS = {
            "1": {
                name: "Double Breasted Woolen Trench Coat",
                sku: "VV-WTC-012",
                variant: "Camel / Large",
                price: 240.00,
                image: "https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&q=80&w=120"
            },
            "2": {
                name: "Gold-Embroidered Velvet Slippers",
                sku: "VV-GVS-089",
                variant: "Royal Gold / 42",
                price: 85.00,
                image: "https://images.unsplash.com/photo-1535043934128-cf0b28d52f95?auto=format&fit=crop&q=80&w=120"
            },
            "3": {
                name: "Cashmere Cable Knit Sweater",
                sku: "VV-CKS-045",
                variant: "Oatmeal / Medium",
                price: 150.00,
                image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&q=80&w=120"
            },
            "4": {
                name: "Satin Tailored Blazer - Ivory",
                sku: "VV-STB-015",
                variant: "Ivory White / Small",
                price: 195.00,
                image: "https://images.unsplash.com/photo-1548624149-f7b31668831a?auto=format&fit=crop&q=80&w=120"
            }
        };

        // Window load
        window.addEventListener('load', () => {
            lucide.createIcons();
            renderTable();
        });

        // Sidebar responsive menu toggling
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            
            sidebar.classList.toggle('-translate-x-full');
            backdrop.classList.toggle('hidden');
        }

        // Render standard order items table & update totals
        function renderTable() {
            const tbody = document.getElementById('order-items-tbody');
            tbody.innerHTML = '';

            let subtotalAccumulator = 0;

            orderItems.forEach((item, index) => {
                const itemSubtotal = item.price * item.qty;
                subtotalAccumulator += itemSubtotal;

                const row = document.createElement('tr');
                row.className = 'hover:bg-slate-50/50 transition-colors';
                row.innerHTML = `
                    <td class="py-4.5 px-5">
                        <div class="relative w-14 h-14 bg-brand-50 rounded-xl overflow-hidden border border-brand-100 shadow-xs">
                            <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover object-top" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1434389677669-e08b4cac3105?auto=format&fit=crop&q=80&w=120';">
                        </div>
                    </td>
                    <td class="py-4.5 px-5">
                        <div>
                            <p class="font-bold text-slate-800 leading-snug">${item.name}</p>
                            <div class="flex flex-wrap gap-1.5 mt-1 text-slate-400 text-xs items-center">
                                <span class="font-semibold text-[10px] bg-slate-100 text-slate-500 py-0.5 px-1.5 rounded">SKU: ${item.sku}</span>
                                <span>&bull;</span>
                                <span>${item.variant}</span>
                            </div>
                        </div>
                    </td>
                    <td class="py-4.5 px-5 text-right font-medium text-slate-600">
                        $${item.price.toFixed(2)}
                    </td>
                    <td class="py-4.5 px-5">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="changeQty(${index}, -1)" class="w-7 h-7 flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-sm font-bold transition-colors select-none">-</button>
                            <span class="w-6 text-center font-bold text-slate-800">${item.qty}</span>
                            <button onclick="changeQty(${index}, 1)" class="w-7 h-7 flex items-center justify-center bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-sm font-bold transition-colors select-none">+</button>
                        </div>
                    </td>
                    <td class="py-4.5 px-5 text-right font-bold text-slate-800">
                        $${itemSubtotal.toFixed(2)}
                    </td>
                    <td class="py-4.5 px-5 text-center">
                        <button onclick="removeItem(${index})" class="text-slate-400 hover:text-red-500 p-1 rounded-lg hover:bg-red-50 transition-all" title="Remove Item">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(row);
            });

            // If empty table state
            if (orderItems.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-10 text-center text-slate-400">
                            <div class="flex flex-col items-center justify-center space-y-2">
                                <i data-lucide="shopping-bag" class="w-8 h-8 text-slate-300"></i>
                                <p class="text-sm">No items in this invoice.</p>
                                <button onclick="openAddItemModal()" class="text-xs text-brand-500 underline font-semibold">Add mock fashion item</button>
                            </div>
                        </td>
                    </tr>
                `;
            }

            // Calculations
            const taxAmount = subtotalAccumulator * TAX_RATE;
            const finalTotal = subtotalAccumulator + SHIPPING - DISCOUNT + taxAmount;

            // Update UI elements
            document.getElementById('summary-subtotal').innerText = `$${subtotalAccumulator.toFixed(2)}`;
            document.getElementById('summary-tax').innerText = `$${taxAmount.toFixed(2)}`;
            document.getElementById('summary-total').innerText = `$${Math.max(0, finalTotal).toFixed(2)}`;

            // Render fresh icons
            lucide.createIcons();
        }

        // Add/subtract quantites
        function changeQty(index, offset) {
            const item = orderItems[index];
            if (!item) return;

            item.qty = Math.max(1, item.qty + offset);
            renderTable();
            showToast('Invoice Updated', `Quantity for ${item.name} updated.`, 'check');
        }

        // Remove item from simulated table
        function removeItem(index) {
            const removedItem = orderItems[index];
            orderItems.splice(index, 1);
            renderTable();
            if (removedItem) {
                showToast('Item Removed', `${removedItem.name} was removed from the order.`, 'trash-2');
            }
        }

        // Interactive status changer
        function updateOrderStatus() {
            const selectValue = document.getElementById('status-select').value;
            const badgeTop = document.getElementById('badge-top');
            const badgeInfo = document.getElementById('badge-info');

            // Set content
            badgeTop.innerText = selectValue;
            badgeInfo.innerText = selectValue.toUpperCase();

            // Set matching badge color classes
            let bgClass = 'bg-blue-100 text-blue-800';
            if (selectValue === 'Pending') bgClass = 'bg-yellow-100 text-yellow-800';
            else if (selectValue === 'Processing') bgClass = 'bg-purple-100 text-purple-800';
            else if (selectValue === 'Delivered') bgClass = 'bg-emerald-100 text-emerald-800';
            else if (selectValue === 'Cancelled') bgClass = 'bg-rose-100 text-rose-800';

            // Reset class lists
            badgeTop.className = `px-2.5 py-0.5 text-xs font-semibold rounded-full uppercase tracking-wide ${bgClass}`;
            badgeInfo.className = `px-2.5 py-0.5 text-xs font-bold rounded-full ${bgClass}`;

            showToast('Status Updated', `Order status has been updated to ${selectValue}.`, 'check');
        }

        // Open refund dialog
        function openRefundModal() {
            const totalText = document.getElementById('summary-total').innerText;
            document.getElementById('refund-amount-text').innerText = totalText;
            document.getElementById('refund-modal').classList.remove('hidden');
        }

        function closeRefundModal() {
            document.getElementById('refund-modal').classList.add('hidden');
        }

        function confirmRefund() {
            closeRefundModal();
            showToast('Refund Successful', 'Full refund has been processed.', 'check');
        }

        // Open custom add item dialog
        function openAddItemModal() {
            document.getElementById('add-item-modal').classList.remove('hidden');
        }

        function closeAddItemModal() {
            document.getElementById('add-item-modal').classList.add('hidden');
        }

        function addMockItemSubmit() {
            const selectVal = document.getElementById('item-selector').value;
            const qtyVal = parseInt(document.getElementById('item-qty-input').value) || 1;
            
            const prod = MOCK_PRODUCTS[selectVal];
            if (prod) {
                // Check if SKU exists to consolidate
                const existing = orderItems.find(i => i.sku === prod.sku);
                if (existing) {
                    existing.qty += qtyVal;
                } else {
                    orderItems.push({
                        id: `prod-${selectVal}`,
                        name: prod.name,
                        sku: prod.sku,
                        variant: prod.variant,
                        price: prod.price,
                        qty: qtyVal,
                        image: prod.image
                    });
                }
                renderTable();
                showToast('Item Added', `${prod.name} added to invoice.`, 'shopping-bag');
            }
            closeAddItemModal();
        }

        // Print & Download triggers
        function handlePrintInvoice() {
            window.print();
        }

        function handleDownloadInvoice() {
            showToast('Invoice Exported', 'Your PDF has been successfully prepared and downloaded.', 'file-text');
        }

        function showNotificationAlert() {
            showToast('System Notification', 'No new critical admin updates at this moment.', 'bell');
        }

        function handleSignOut() {
            showToast('Signing Out...', 'Ending Velvet Vogue admin panel session.', 'log-out');
        }

        // Navigation modal mock placeholder
        function switchTab(tabName) {
            if (tabName === 'Orders') {
                return; // already on orders details
            }
            document.getElementById('nav-modal-title').innerText = `${tabName} Section`;
            document.getElementById('nav-modal-text').innerText = `You have clicked on the "${tabName}" sidebar item. This is a fully customizable template mock! Let's stay on Order Details to examine our product card.`;
            document.getElementById('navigation-modal').classList.remove('hidden');
        }

        function closeNavModal() {
            document.getElementById('navigation-modal').classList.add('hidden');
        }

        // Toast handler helper
        let toastTimeout;
        function showToast(title, desc, iconName) {
            const toast = document.getElementById('toast');
            const toastTitle = document.getElementById('toast-title');
            const toastDesc = document.getElementById('toast-desc');
            const iconWrapper = document.getElementById('toast-icon-wrapper');

            // clear current timeout
            clearTimeout(toastTimeout);

            toastTitle.innerText = title;
            toastDesc.innerText = desc;
            
            // update icon
            iconWrapper.innerHTML = `<i data-lucide="${iconName}" class="w-4 h-4"></i>`;
            lucide.createIcons();

            // trigger sliding animation
            toast.classList.remove('translate-y-24', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            // hide after delay
            toastTimeout = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-24', 'opacity-0');
            }, 3500);
        }
    </script>
</body>
</html>