<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Edit Product</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            background-color: #F9FAFB;
        }

        .accent-bg {
            background-color: #8B5E3C;
        }

        .accent-text {
            color: #8B5E3C;
        }

        .accent-border {
            border-color: #8B5E3C;
        }

        .accent-ring:focus {
            --tw-ring-color: #8B5E3C;
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #9ca3af;
        }

        .form-input {
            width: 100%;
            padding: 14px 18px;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            outline: none;
            transition: all 0.2s ease;
            background: #ffffff;
            color: #111827;
            font-size: 14px;
            line-height: 1.5;
        }

        .cropper-container {
            width: 100% !important;
        }

        .cropper-view-box,
        .cropper-face {
            border-radius: 0;
        }

        .form-input:focus {
            border-color: #8B5E3C;
            box-shadow: 0 0 0 4px rgba(139, 94, 60, 0.12);
        }

        .card-shadow {
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        }

        .custom-toggle {

            width: 56px;
            height: 30px;

            background: #d1d5db;

            border-radius: 9999px;

            position: relative;

            cursor: pointer;

            transition: all 0.3s ease;
        }

        .custom-toggle.active {

            background: #8B5E3C;
        }

        .toggle-circle {

            width: 24px;
            height: 24px;

            background: white;

            border-radius: 50%;

            position: absolute;

            top: 3px;
            left: 3px;

            display: flex;
            align-items: center;
            justify-content: center;

            transition: all 0.3s ease;
        }

        .custom-toggle.active .toggle-circle {

            transform: translateX(26px);
        }
    </style>
</head>

<body class="text-gray-900">
    <%- include("../partials/admin/adminSidebar") %>
        <header class="fixed top-0 left-[260px] right-0 z-50 bg-white border-b border-gray-100 px-8 py-4">
            <div class=" flex justify-between items-center">
                <!-- Search Bar -->
                <div class="relative w-96">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                        <i data-lucide="search" class="w-5 h-5"></i>
                    </span>
                    <input type="text" placeholder="Search anything..."
                        class="w-full pl-10 pr-4 py-2 bg-gray-50 border-none rounded-xl text-sm focus:ring-2 focus:ring-gray-200 outline-none transition-all">
                </div>

                <!-- Profile and Notifications -->
                <div class="flex items-center space-x-6">
                    <button class="relative p-2 text-gray-500 hover:bg-gray-50 rounded-full transition-colors">
                        <i data-lucide="bell" class="w-6 h-6"></i>
                        <span
                            class="absolute top-2 right-2.5 w-2 h-2 bg-red-500 rounded-full border-2 border-white"></span>
                    </button>
                    <div class="flex items-center space-x-3 border-l pl-6">
                        <div class="text-right">
                            <p class="text-sm font-bold text-gray-900">Rohin Geojar</p>
                            <p class="text-xs text-gray-500">Administrator</p>
                        </div>
                        <div
                            class="w-10 h-10 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-700 font-bold border-2 border-white shadow-sm">
                            RG
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="ml-[260px] pt-28 px-8 pb-10">
            <nav class="flex mb-4 text-sm font-medium text-gray-500">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/adminAuth/dashboard" class=" hover:text-gray-700 transition-colors">Dashboard</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <i data-lucide="chevron-right" class="w-4 h-4 mx-1"></i>
                            <a href="/products" class="hover:text-gray-700 transition-colors">Products</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <i data-lucide="chevron-right" class="w-4 h-4 mx-1"></i>
                            <span class="text-gray-900">Edit Product</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <h1 class="text-3xl font-bold text-gray-900 mb-8">Edit Product</h1>

            <!-- Form Start with ID targeting update route -->
            <form id="productForm" action="/products/edit/<%= product._id %>" method="POST" class="max-w-7xl mx-auto"
                enctype="multipart/form-data">

                <section class="bg-white rounded-3xl p-8 mb-8 border border-gray-100 card-shadow">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="p-2 bg-amber-50 rounded-lg accent-text">
                            <i data-lucide="info" class="w-5 h-5"></i>
                        </div>
                        <h2 class="text-xl font-bold">General Information</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Name</label>
                            <input type="text" name="productName" value="<%= product.productName %>"
                                placeholder="e.g. Classic Silk Blazer"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="productName"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Slug</label>
                            <input type="text" id="slugPreview" readonly name="productSlug" value="<%= product.slug %>"
                                placeholder="Slug is created automatically"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Title</label>
                            <input type="text" name="productTitle" value="<%= product.productTitle %>"
                                placeholder="e.g. Premium Autumn Collection 2024"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="productTitle"></p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                        <textarea rows="4" name="description" placeholder="Write detailed product description here..."
                            class="form-input accent-ring focus:border-[#8B5E3C] resize-none"><%= product.description %></textarea>
                        <p class="text-red-500 text-sm mt-1 error-text" data-error="description"></p>
                    </div>
                </section>

                <section class="bg-white rounded-3xl p-8 mb-8 border border-gray-100 card-shadow">
                    <div class="flex items-center space-x-3 mb-6">
                        <div class="p-2 bg-orange-50 rounded-lg text-orange-600">
                            <i data-lucide="layout-grid" class="w-5 h-5"></i>
                        </div>
                        <h2 class="text-xl font-bold">Category & Details</h2>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Category</label>
                            <select name="category"
                                class="form-input accent-ring focus:border-[#8B5E3C] bg-white appearance-none">
                                <option value="">Select Category</option>
                                <% categories.forEach(category=> { %>
                                    <option value="<%= category._id %>"
                                        <%=String(product.category)===String(category._id) ? 'selected' : '' %>>
                                        <%= category.name %>
                                    </option>
                                    <% }) %>
                            </select>
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="category"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Material Details</label>
                            <input type="text" name="materialDetails" value="<%= product.materialDetails %>"
                                placeholder="e.g. 100% Cotton, 180 GSM"
                                class="form-input accent-ring focus:border-[#8B5E3C]">
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="materialDetails"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Material Care</label>
                            <textarea rows="3" name="materialCare" placeholder="e.g. Machine wash cold, tumble dry low"
                                class="form-input accent-ring focus:border-[#8B5E3C] resize-none"><%= product.materialCare %></textarea>
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="materialCare"></p>
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Shipping Details</label>
                            <textarea rows="3" name="shippingDetails" placeholder="e.g. Ships in 2-4 business days"
                                class="form-input accent-ring focus:border-[#8B5E3C] resize-none"><%= product.shippingDetails %></textarea>
                            <p class="text-red-500 text-sm mt-1 error-text" data-error="shippingDetails"></p>
                        </div>
                    </div>
                </section>

                <div class="mb-6">
                    <div class="flex items-center space-x-3 mb-2">
                        <div class="p-2 bg-indigo-50 rounded-lg text-indigo-600">
                            <i data-lucide="layers" class="w-5 h-5"></i>
                        </div>
                        <h2 class="text-xl font-bold">Product Variants</h2>
                    </div>
                    <p class="text-sm text-gray-500 mb-6">Manage product variants like color, size, price, stock, and
                        images.</p>

                    <!-- Variants Container -->
                    <div id="variantsContainer" data-count="<%= product.variants ? product.variants.length : 0 %>"
                        class="space-y-8 mb-6">
                        <!-- Server-side loop over existing variants -->
                        <% if (product.variants && product.variants.length> 0) { %>
                            <% product.variants.forEach((variant, currentIndex)=> { %>
                                <% const variantId=`variant-${currentIndex}`; %>
                                    <div id="<%= variantId %>"
                                        class="bg-white rounded-3xl p-8 border border-gray-100 card-shadow transition-all">
                                        <div
                                            class="flex justify-between items-center mb-8 pb-4 border-b border-gray-50">
                                            <div class="flex items-center space-x-4">
                                                <div
                                                    class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400">
                                                    <i data-lucide="box" class="w-5 h-5"></i>
                                                </div>
                                                <div>
                                                    <h3 class="font-bold text-lg variant-title">Variant: <%=
                                                            variant.color || 'New Variant' %>
                                                    </h3>
                                                    <p class="text-xs font-mono text-gray-400 uppercase">SKU: <%=
                                                            variant.sku ||
                                                            `PROD-VAR-${String(currentIndex).padStart(3, '0' )}` %>
                                                    </p>
                                                </div>
                                            </div>
                                            <button type="button" onclick="removeVariant('<%= variantId %>')"
                                                class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all">
                                                <i data-lucide="trash-2" class="w-5 h-5"></i>
                                            </button>
                                        </div>

                                        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                                            <div class="grid grid-cols-2 gap-4">

                                                <div>

                                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                                        Color Name
                                                    </label>

                                                    <input type="text"
                                                         oninput="updateVariantTitle(this, '${variantId}'); validateVariantColors()"
                                                        value="<%= variant.color %>" placeholder="e.g. Olive Green"
                                                        name="variants[<%= currentIndex %>][color]"
                                                        class="form-input accent-ring">

                                                    <p class="text-red-500 text-sm mt-1 error-text"
                                                        data-error="variants.<%= currentIndex %>.color"></p>

                                                </div>

                                                <div>

                                                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                                                        Pick Color
                                                    </label>

                                                    <div class="flex items-center gap-4">

                                                        <input type="color"
                                                            name="variants[<%= currentIndex %>][colorCode]"
                                                            value="<%= variant.colorCode || '#556B57' %>"
                                                            class="w-16 h-12 p-1 border border-gray-200 rounded-xl cursor-pointer bg-white">

                                                        <span class="text-xs text-gray-500">
                                                            Exact product shade
                                                        </span>

                                                    </div>

                                                </div>

                                            </div>
                                            <div>
                                                <label class="block text-sm font-semibold text-gray-700 mb-2">Regular
                                                    Price</label>
                                                <div class="relative">
                                                    <span
                                                        class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">₹</span>
                                                    <input type="number"
                                                        name="variants[<%= currentIndex %>][regularPrice]"
                                                        value="<%= variant.regularPrice %>" step="0.01"
                                                        placeholder="0.00" class="form-input pl-8 accent-ring">
                                                </div>
                                                <p class="text-red-500 text-sm mt-1 error-text"
                                                    data-error="variants.<%= currentIndex %>.regularPrice"></p>
                                            </div>
                                            <div>
                                                <label class="block text-sm font-semibold text-gray-700 mb-2">Sale Price
                                                    (Optional)</label>
                                                <div class="relative">
                                                    <span
                                                        class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">₹</span>
                                                    <input type="number" name="variants[<%= currentIndex %>][salePrice]"
                                                        value="<%= variant.salePrice %>" step="0.01" placeholder="0.00"
                                                        class="form-input pl-8 accent-ring">
                                                </div>
                                                <p class="text-red-500 text-sm mt-1 error-text"
                                                    data-error="variants.<%= currentIndex %>.salePrice"></p>
                                            </div>
                                        </div>

                                        <!-- Variant Images -->
                                        <div class="mb-8">
                                            <label class="block text-sm font-semibold text-gray-700 mb-3">Variant
                                                Images</label>
                                            <div class="flex flex-wrap gap-4">
                                                <label
                                                    class="w-24 h-24 border-2 border-dashed border-gray-200 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-[#8B5E3C] hover:bg-amber-50/20 transition-all text-gray-400 group">
                                                    <i data-lucide="upload"
                                                        class="w-6 h-6 mb-1 group-hover:text-[#8B5E3C]"></i>
                                                    <span class="text-[10px] font-bold">Upload</span>
                                                    <input type="file" name="variantImages_<%= currentIndex %>" multiple
                                                        accept="image/*" class="hidden variant-image-input"
                                                        data-variant="<%= currentIndex %>">
                                                </label>

                                                <!-- Existing images rendered for preview management -->
                                                <div id="preview-<%= currentIndex %>" class="flex flex-wrap gap-4">
                                                    <% if (variant.images && variant.images.length> 0) { %>
                                                        <% variant.images.forEach((img, imgIndex)=> { %>
                                                            <div
                                                                class="relative w-24 h-24 rounded-xl overflow-hidden border border-gray-200 group existing-image">
                                                                <img src="<%= img.url %>"
                                                                    class="w-full h-full object-cover">
                                                                <!-- Hidden path tracker for backend processing updates -->
                                                                <input type="hidden"
                                                                    name="variants[<%= currentIndex %>][existingImages][]"
                                                                    value="<%= img.url %>">
                                                                <button type="button"
                                                                    onclick="removeExistingImage(this)"
                                                                    class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-white">
                                                                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                                                                </button>
                                                            </div>
                                                            <% }) %>
                                                                <% } %>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Size System -->
                                        <div class="bg-gray-50/50 rounded-2xl p-6">
                                            <div class="flex justify-between items-center mb-4">
                                                <div class="flex items-center space-x-2 text-gray-700">
                                                    <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                                                    <h4 class="text-sm font-bold">Stock Per Size</h4>
                                                </div>
                                                <button type="button" data-variant-id="<%= variantId %>"
                                                    data-index="<%= currentIndex %>"
                                                    onclick="addSizeRow(this.dataset.variantId, Number(this.dataset.index))"
                                                    class="px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-xs font-bold text-gray-700 flex items-center space-x-1 hover:border-[#8B5E3C] hover:text-[#8B5E3C] transition-all shadow-sm">
                                                    <i data-lucide="plus" class="w-3 h-3"></i>
                                                    <span>Add Size</span>
                                                </button>
                                            </div>

                                            <div class="overflow-x-auto">
                                                <table class="w-full text-left">
                                                    <thead>
                                                        <tr
                                                            class="text-[10px] uppercase tracking-wider text-gray-400 font-bold border-b border-gray-200">
                                                            <th class="pb-2 font-bold px-2">Size Name</th>
                                                            <th class="pb-2 font-bold px-2">Stock Quantity</th>
                                                            <th class="pb-2 font-bold px-2 text-right">Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="<%= variantId %>-sizes" class="divide-y divide-gray-100">
                                                        <% if (variant.sizes && variant.sizes.length> 0) { %>
                                                            <% variant.sizes.forEach((sizeObj, sizeIndex)=> { %>
                                                                <% const
                                                                    rowId=`row-${currentIndex}-${sizeIndex}-${Date.now()}`;
                                                                    %>
                                                                    <tr id="<%= rowId %>" class="group">
                                                                        <td class="py-3 px-2">
                                                                            <select
                                                                                name="variants[<%= currentIndex %>][sizes][<%= sizeIndex %>][size]"
                                                                                onchange="updateAvailableSizes('<%= variantId %>')"
                                                                                class="w-full size-select bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 shadow-sm focus:outline-none focus:ring-2">
                                                                                <option value="">Select Size</option>
                                                                                <option value="S" <%=sizeObj.size==='S'
                                                                                    ? 'selected' : '' %>>S</option>
                                                                                <option value="M" <%=sizeObj.size==='M'
                                                                                    ? 'selected' : '' %>>M</option>
                                                                                <option value="L" <%=sizeObj.size==='L'
                                                                                    ? 'selected' : '' %>>L</option>
                                                                                <option value="XL"
                                                                                    <%=sizeObj.size==='XL' ? 'selected'
                                                                                    : '' %>>XL</option>
                                                                            </select>
                                                                        </td>
                                                                        <td class="py-3 px-2">
                                                                            <input
                                                                                name="variants[<%= currentIndex %>][sizes][<%= sizeIndex %>][stock]"
                                                                                type="number"
                                                                                value="<%= sizeObj.stock %>"
                                                                                placeholder="Enter quantity"
                                                                                class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 shadow-sm">
                                                                        </td>
                                                                        <td class="py-3 px-2 text-right">
                                                                            <button type="button"
                                                                                onclick="removeSizeRow('<%= rowId %>', '<%= variantId %>')"
                                                                                class="p-3 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-xl transition-all">
                                                                                <i data-lucide="trash-2"
                                                                                    class="w-4 h-4"></i>
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                                        <% } %>
                    </div>

                    <!-- Add Variant Button -->
                    <button type="button" onclick="addVariant()"
                        class="w-full py-8 border-2 border-dashed border-gray-200 rounded-2xl flex flex-col items-center justify-center space-y-2 text-gray-500 hover:border-[#8B5E3C] hover:text-[#8B5E3C] hover:bg-amber-50/30 transition-all group">
                        <div
                            class="w-12 h-12 rounded-full border-2 border-dashed border-gray-300 flex items-center justify-center group-hover:border-[#8B5E3C]">
                            <i data-lucide="plus" class="w-6 h-6"></i>
                        </div>
                        <span class="font-bold">Add New Product Variant</span>
                    </button>
                </div>
                <div class="bg-[#F4EDE6] p-6 rounded-2xl flex justify-between items-center mt-8 border border-gray-50">
                    <div>
                        <p class="text-sm font-bold text-gray-900">
                            Product Status
                        </p>
                        <p class="text-xs text-gray-500">
                            Toggle to set Product active or inactive
                        </p>
                    </div>
                    <input type="hidden" name="isActive" id="statusInput" value="true">
                    <div id="statusToggle" class="custom-toggle active" onclick="toggleStatus()">
                        <div class="toggle-circle">
                            <i id="statusIcon" data-lucide="check" class="w-3 h-3 "></i>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end items-center space-x-4 mt-12 mb-20">
                    <button type="button" onclick="window.location.href='/products'"
                        class="px-8 py-3 border border-gray-300 rounded-xl font-bold text-gray-600 hover:bg-gray-50 transition-colors">
                        Cancel
                    </button>
                    <button type="submit" id="updateBtn"
                        class="px-8 py-3 accent-bg text-white rounded-xl font-bold shadow-lg shadow-amber-900/20 hover:opacity-90 transition-all flex items-center space-x-2">
                        <i data-lucide="save" class="w-5 h-5"></i>
                        <span>Update Product</span>
                    </button>
                </div>

            </form>
        </main>

        <div id="toast" class="hidden fixed top-5 right-5 text-white px-6 py-3 rounded-xl shadow-lg z-50"></div>

        <div id="cropperModal" class="hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-6">
            <div class="bg-white rounded-2xl p-6 w-full max-w-3xl">
                <div class="w-full h-[500px] bg-gray-100 rounded-xl overflow-hidden">
                    <img id="cropperImage" class="block max-w-full" />
                </div>
                <div class="flex justify-end gap-3 mt-4">
                    <button type="button" id="cancelCrop" class="px-5 py-2 border rounded-xl">Cancel</button>
                    <button type="button" id="cropImageBtn" class="px-5 py-2 bg-black text-white rounded-xl">Crop
                        Image</button>
                </div>
            </div>
        </div>

        <script>
            function toggleStatus() {

                const toggle =
                    document.getElementById(
                        "statusToggle"
                    );

                const input =
                    document.getElementById(
                        "statusInput"
                    );

                const icon =
                    document.getElementById(
                        "statusIcon"
                    );

                toggle.classList.toggle("active");

                const isActive =
                    toggle.classList.contains(
                        "active"
                    );

                input.value = isActive;

                icon.setAttribute(

                    "data-lucide",

                    isActive
                        ? "check"
                        : "x"
                );

                lucide.createIcons();
            }
            lucide.createIcons();
            // Set dynamic counter based on variants rendered by the server
            const variantsContainer = document.getElementById('variantsContainer');
            let variantCount = variantsContainer ? Number(variantsContainer.dataset.count) || 0 : 0;
            const allSizes = ["S", "M", "L", "XL"];

            // Ensure available dropdown sizes sync correctly on initial load
            document.querySelectorAll('[id$="-sizes"]').forEach(container => {
                const variantId = container.id.replace('-sizes', '');
                updateAvailableSizes(variantId);
            });

            function addVariant() {
                const currentIndex = variantCount;
                variantCount++;

                const variantId = `variant-${currentIndex}`;
                const container = document.getElementById("variantsContainer");

                const variantHTML = `
    <div id="${variantId}" class="bg-white rounded-3xl p-8 border border-gray-100 card-shadow transition-all animate-in fade-in slide-in-from-bottom-4 duration-300">

        <div class="flex justify-between items-center mb-8 pb-4 border-b border-gray-50">
            <div class="flex items-center space-x-4">
                <div class="w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400">
                    <i data-lucide="box" class="w-5 h-5"></i>
                </div>

                <div>
                    <h3 class="font-bold text-lg variant-title">Variant: New Variant</h3>
                    <p class="text-xs font-mono text-gray-400 uppercase">
                        SKU: PROD-VAR-${currentIndex.toString().padStart(3, "0")}
                    </p>
                </div>
            </div>

            <button
                type="button"
                onclick="removeVariant('${variantId}')"
                class="p-2 text-gray-400 hover:text-red-500 hover:bg-red-50 rounded-lg transition-all">

                <i data-lucide="trash-2" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">

            <div class="grid grid-cols-2 gap-4">

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Color Name
                    </label>

                    <input
                        type="text"
                       oninput="updateVariantTitle(this,'${variantId}'); validateVariantColors()"
                        placeholder="e.g. Olive Green"
                        name="variants[${currentIndex}][color]"
                        class="form-input accent-ring"
                    >

                    <p
                        class="text-red-500 text-sm mt-1 error-text"
                        data-error="variants.${currentIndex}.color">
                    </p>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Pick Color
                    </label>

                    <div class="flex items-center gap-4">

                        <input
                            type="color"
                            name="variants[${currentIndex}][colorCode]"
                            value="#556B57"
                            class="w-16 h-12 p-1 border border-gray-200 rounded-xl cursor-pointer bg-white"
                        >

                        <span class="text-xs text-gray-500">
                            Exact product shade
                        </span>

                    </div>

                    <p
                        class="text-red-500 text-sm mt-1 error-text"
                        data-error="variants.${currentIndex}.colorCode">
                    </p>
                </div>

            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Regular Price
                </label>

                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">₹</span>

                    <input
                        type="number"
                        name="variants[${currentIndex}][regularPrice]"
                        step="0.01"
                        placeholder="0.00"
                        class="form-input pl-8 accent-ring"
                    >
                </div>

                <p
                    class="text-red-500 text-sm mt-1 error-text"
                    data-error="variants.${currentIndex}.regularPrice">
                </p>
            </div>

            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Sale Price (Optional)
                </label>

                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-4 flex items-center text-gray-400">₹</span>

                    <input
                        type="number"
                        name="variants[${currentIndex}][salePrice]"
                        step="0.01"
                        placeholder="0.00"
                        class="form-input pl-8 accent-ring"
                    >
                </div>

                <p
                    class="text-red-500 text-sm mt-1 error-text"
                    data-error="variants.${currentIndex}.salePrice">
                </p>
            </div>

        </div>

        <div class="mb-8">

            <label class="block text-sm font-semibold text-gray-700 mb-3">
                Variant Images
            </label>

            <div class="flex flex-wrap gap-4">

                <label class="w-24 h-24 border-2 border-dashed border-gray-200 rounded-xl flex flex-col items-center justify-center cursor-pointer hover:border-[#8B5E3C] hover:bg-amber-50/20 transition-all text-gray-400 group">

                    <i
                        data-lucide="upload"
                        class="w-6 h-6 mb-1 group-hover:text-[#8B5E3C]">
                    </i>

                    <span class="text-[10px] font-bold">
                        Upload
                    </span>

                    <input
                        type="file"
                        name="variantImages_${currentIndex}"
                        multiple
                        accept="image/*"
                        class="hidden variant-image-input"
                        data-variant="${currentIndex}"
                    >

                </label>

                <div
                    id="preview-${currentIndex}"
                    class="flex flex-wrap gap-4">
                </div>

            </div>

        </div>

        <div class="bg-gray-50/50 rounded-2xl p-6">

            <div class="flex justify-between items-center mb-4">

                <div class="flex items-center space-x-2 text-gray-700">
                    <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                    <h4 class="text-sm font-bold">Stock Per Size</h4>
                </div>

                <button
                    type="button"
                    onclick="addSizeRow('${variantId}', ${currentIndex})"
                    class="px-3 py-1.5 bg-white border border-gray-200 rounded-lg text-xs font-bold text-gray-700 flex items-center space-x-1 hover:border-[#8B5E3C] hover:text-[#8B5E3C] transition-all shadow-sm">

                    <i data-lucide="plus" class="w-3 h-3"></i>
                    <span>Add Size</span>

                </button>

            </div>

            <div class="overflow-x-auto">

                <table class="w-full text-left">

                    <thead>

                        <tr class="text-[10px] uppercase tracking-wider text-gray-400 font-bold border-b border-gray-200">

                            <th class="pb-2 font-bold px-2">Size Name</th>
                            <th class="pb-2 font-bold px-2">Stock Quantity</th>
                            <th class="pb-2 font-bold px-2 text-right">Action</th>

                        </tr>

                    </thead>

                    <tbody
                        id="${variantId}-sizes"
                        class="divide-y divide-gray-100">
                    </tbody>

                </table>

            </div>

        </div>

    </div>
    `;

                container.insertAdjacentHTML("beforeend", variantHTML);

                lucide.createIcons();

                addSizeRow(variantId, currentIndex);
            }

            function removeVariant(id) {
                const el = document.getElementById(id);
                el.classList.add('opacity-0', 'scale-95');
                setTimeout(() => el.remove(), 200);
            }

            function updateVariantTitle(input, id) {
                const title = document.querySelector(`#${id} .variant-title`);
                title.textContent = input.value ? `Variant: ${input.value}` : 'Variant: New Variant';
            }

            function addSizeRow(variantId, variantIndex) {
                const tableBody = document.getElementById(`${variantId}-sizes`);
                const currentRows = tableBody.querySelectorAll(".size-select");

                if (currentRows.length >= allSizes.length) return;

                const sizeIndex = tableBody.children.length;
                const rowId = `row-${Date.now()}`;

                const rowHTML = `
                <tr id="${rowId}" class="group">
                    <td class="py-3 px-2">
                        <select name="variants[${variantIndex}][sizes][${sizeIndex}][size]" onchange="updateAvailableSizes('${variantId}')" class="w-full size-select bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 shadow-sm focus:outline-none">
                            <option value="">Select Size</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                        </select>
                        <p
                            class="text-red-500 text-sm mt-1 error-text"
                            data-error="variants.${variantIndex}.sizes.${sizeIndex}.size"></p>
                    </td>
                    <td class="py-3 px-2">
                        <input
                            name="variants[${variantIndex}][sizes][${sizeIndex}][stock]"
                            type="number"
                            placeholder="Enter quantity"
                            class="w-full bg-white border border-gray-200 rounded-xl px-4 py-3 text-sm font-medium text-gray-700 shadow-sm"
                        >

                        <p
                            class="text-red-500 text-sm mt-1 error-text"
                            data-error="variants.${variantIndex}.sizes.${sizeIndex}.stock">
                        </p>
                    </td>
                    <td class="py-3 px-2 text-right">
                        <button type="button" onclick="removeSizeRow('${rowId}', '${variantId}')" class="p-3 text-gray-400 hover:text-red-500 rounded-xl">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                </tr>`;

                tableBody.insertAdjacentHTML('beforeend', rowHTML);
                updateAvailableSizes(variantId);
                lucide.createIcons();
            }

            function removeSizeRow(rowId, variantId) {

                const table = document.getElementById(`${variantId}-sizes`);

                const rows = Array.from(table.children).filter(row => row.tagName === "TR");

                if (rows.length === 1) {

                    showToast(
                        "At least one size is required",
                        "error"
                    );

                    return;
                }
                const row = document.getElementById(rowId)
                if (row) {
                    row.remove()
                }


                updateAvailableSizes(variantId);
            }

            const nameInput = document.querySelector('input[name="productName"]');
            const slugPreview = document.getElementById("slugPreview");

            nameInput.addEventListener("input", function () {
                const slug = this.value
                    .toLowerCase()
                    .trim()
                    .replace(/[^a-z0-9\s-]/g, '')
                    .replace(/\s+/g, "-")
                    .replace(/-+/g, "-");
                slugPreview.value = slug;
            });

            function updateAvailableSizes(variantId) {
                const container = document.getElementById(`${variantId}-sizes`);
                const selects = container.querySelectorAll(".size-select");
                const selectedSizes = [];

                selects.forEach(select => {
                    if (select.value) selectedSizes.push(select.value);
                });

                selects.forEach(select => {
                    const currentValue = select.value;
                    select.innerHTML = `<option value="">Select Size</option>`;
                    allSizes.forEach(size => {
                        if (!selectedSizes.includes(size) || size === currentValue) {
                            select.innerHTML += `<option value="${size}" ${size === currentValue ? "selected" : ""}>${size}</option>`;
                        }
                    });
                });
            }

            function showErrors(errors) {

                // CLEAR OLD ERRORS
                document
                    .querySelectorAll(".error-text")
                    .forEach(el => {

                        el.textContent = "";
                    });

                // REMOVE OLD RED BORDERS
                document
                    .querySelectorAll("input, textarea, select")
                    .forEach(input => {

                        input.classList.remove(
                            "border-red-500",
                            "focus:ring-red-200"
                        );
                    });

                let firstInvalidInput = null;

                // SHOW NEW ERRORS
                errors.forEach(error => {

                    const path =
                        error.path.join(".");

                    const errorElement =
                        document.querySelector(
                            `[data-error="${path}"]`
                        );

                    if (errorElement) {

                        // SHOW ERROR MESSAGE
                        errorElement.textContent =
                            error.message.replace(/"/g, "");

                        // TARGET INPUT
                        const input =
                            errorElement
                                .previousElementSibling;

                        if (input) {

                            // RED BORDER
                            input.classList.add(
                                "border-red-500",
                                "focus:ring-red-200"
                            );

                            // FIRST INVALID INPUT
                            if (!firstInvalidInput) {

                                firstInvalidInput =
                                    input;
                            }

                            // REMOVE ERROR LIVE
                            input.addEventListener(
                                "input",
                                function () {

                                    errorElement.textContent =
                                        "";

                                    input.classList.remove(
                                        "border-red-500",
                                        "focus:ring-red-200"
                                    );
                                },
                                { once: true }
                            );

                            input.addEventListener(
                                "change",
                                function () {

                                    errorElement.textContent =
                                        "";

                                    input.classList.remove(
                                        "border-red-500",
                                        "focus:ring-red-200"
                                    );
                                },
                                { once: true }
                            );
                        }
                    }
                });


                if (firstInvalidInput) {

                    firstInvalidInput.focus();

                    firstInvalidInput.scrollIntoView({

                        behavior: "smooth",

                        block: "center"
                    });
                }
            }

            const productForm = document.getElementById("productForm");
            const initialState = JSON.stringify(Array.from(new FormData(productForm)
                .entries()
            ));
            productForm.addEventListener("submit", async function (e) {
                e.preventDefault();
                if (!validateVariantColors()) {
                    showToast(
                        "Each variant must have a unique color",
                        "error"
                    );

                    return;
                }

                const updateBtn = document.getElementById("updateBtn");

                const originalButtonHTML = updateBtn.innerHTML;
                updateBtn.disabled = true;

                updateBtn.innerHTML = `
    <svg
        class="animate-spin w-5 h-5"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24">

        <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4">
        </circle>

        <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
        </path>

    </svg>

    <span>Updating...</span>
`;

                const currentFormData =
                    new FormData(productForm);

                const currentState =
                    JSON.stringify(
                        Array.from(
                            currentFormData.entries()
                        )
                    );


                if (initialState === currentState) {
                    updateBtn.disabled = false;
                    updateBtn.innerHTML = originalButtonHTML;
                    lucide.createIcons();


                    showToast(
                        "No changes detected",
                        "error"
                    );

                    return;
                }
                document.querySelectorAll(".error-text").forEach(el => el.textContent = "");



                try {
                    const formData = new FormData(productForm);
                    updateBtn.disabled = true;

                    updateBtn.innerHTML = `
    <svg
        class="animate-spin w-5 h-5"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24">

        <circle
            class="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            stroke-width="4">
        </circle>

        <path
            class="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z">
        </path>

    </svg>

    <span>Updating...</span>
`;

                    const response = await fetch(productForm.action, {
                        method: "POST",
                        body: formData
                    });

                    const data = await response.json();

                    if (data.success) {

                        updateBtn.innerHTML = `
        <i data-lucide="check-circle" class="w-5 h-5"></i>
        <span>Updated!</span>
    `;

                        lucide.createIcons();

                        showToast(data.message, "success");

                        setTimeout(() => {
                            window.location.href = "/products";
                        }, 1200);

                        return;
                    }

                    updateBtn.disabled = false;
                    updateBtn.innerHTML = originalButtonHTML;
                    lucide.createIcons();

                    if (data.errors) {
                        return showErrors(data.errors);
                    }

                    showToast(
                        data.message || "Something went wrong",
                        "error"
                    )

                    for (const input of imageInputs) {
                        const variantIndex = input.dataset.variant;
                        const previewDiv = document.getElementById(`preview-${variantIndex}`);
                        const existingCount = previewDiv ? previewDiv.querySelectorAll("img").length : 0;

                        if ((existingCount + input.files.length) < 3) {
                            showToast("Each variant must contain at least 3 images", "error");
                            return;
                        }
                    }
                } catch (error) {
                    console.log("error : ", error);
                    updateBtn.disabled = false;
                    updateBtn.innerHTML = originalButtonHTML;
                    lucide.createIcons();
                    showToast("Something went wrong from submission", "error");
                }
            });

            function showToast(message, type = "success") {
                const toast = document.getElementById("toast");
                toast.textContent = message;
                toast.classList.remove("hidden", "bg-green-500", "bg-red-500");
                toast.classList.add(type === "error" ? "bg-red-500" : "bg-green-500");
                setTimeout(() => toast.classList.add("hidden"), 3000);
            }
            function removeExistingImage(button) {

                const wrapper =
                    button.closest(".relative");

                const hiddenInput =
                    wrapper.querySelector(
                        'input[type="hidden"]'
                    );

                if (hiddenInput) {

                    hiddenInput.remove();
                }

                wrapper.remove();
            }
            // ============================================================
            //    ===============================================================

            let cropper;
            let currentInput = null;
            let currentPreviewContainer = null;

            let currentFiles = [];
            let currentFileIndex = 0;
            let croppedFiles = [];

            const cropperModal =
                document.getElementById(
                    "cropperModal"
                );

            const cropperImage =
                document.getElementById(
                    "cropperImage"
                );

            document
                .querySelectorAll(".variant-image-input")
                .forEach(input => {

                    input.addEventListener(
                        "change",
                        function (e) {

                            const files =
                                Array.from(e.target.files);

                            if (!files.length) return;

                            if (files.length > 5) {

                                showToast(
                                    "Maximum 5 images allowed",
                                    "error"
                                );

                                input.value = "";

                                return;
                            }

                            currentInput = input;

                            currentPreviewContainer =
                                document.getElementById(
                                    `preview-${input.dataset.variant}`
                                );

                            currentFiles = files;

                            currentFileIndex = 0;

                            croppedFiles = [];

                            openCropper(
                                currentFiles[currentFileIndex]
                            );
                        }
                    );
                });

            document.addEventListener("change", function (e) {

                if (!e.target.classList.contains("variant-image-input")) return;

                const input = e.target;

                const previewContainer = document.getElementById(
                    `preview-${input.dataset.variant}`
                );

                const existingImages =
                    previewContainer.querySelectorAll(
                        ".existing-image, .new-image-preview"
                    ).length;

                const totalImages =
                    existingImages + input.files.length;

                if (totalImages > 5) {

                    showToast(
                        "Maximum 5 images allowed",
                        "error"
                    );

                    input.value = "";

                    return;
                }

                const files = Array.from(input.files);

                if (!files.length) return;

                currentInput = input;
                currentPreviewContainer = previewContainer;

                currentFiles = files;
                currentFileIndex = 0;
                croppedFiles = [];

                openCropper(currentFiles[currentFileIndex]);

            });

            function openCropper(file) {

                const imageURL =
                    URL.createObjectURL(file);

                cropperImage.src = imageURL;

                cropperModal
                    .classList
                    .remove("hidden");

                setTimeout(() => {

                    if (cropper) {
                        cropper.destroy();
                    }

                    cropper =
                        new Cropper(
                            cropperImage,
                            {

                                aspectRatio: 4 / 5,

                                viewMode: 1,

                                dragMode: "move",

                                autoCropArea: 1,

                                responsive: true,

                                restore: false,

                                background: false,

                                movable: true,

                                zoomable: true,

                                scalable: true,

                                cropBoxMovable: true,

                                cropBoxResizable: true
                            }
                        );

                }, 100);
            }

            document
                .getElementById("cancelCrop")
                .addEventListener(
                    "click",
                    function () {

                        cropperModal
                            .classList
                            .add("hidden");

                        if (cropper) {
                            cropper.destroy();
                        }

                        currentInput.value = "";
                    }
                );

            document
                .getElementById("cropImageBtn")
                .addEventListener(
                    "click",
                    function () {

                        if (!cropper) return;

                        const canvas =
                            cropper.getCroppedCanvas({

                                width: 800,

                                height: 1000
                            });

                        canvas.toBlob((blob) => {

                            const croppedFile =
                                new File(
                                    [blob],
                                    `cropped-${Date.now()}.png`,
                                    {
                                        type: "image/png"
                                    }
                                );

                            croppedFiles.push(
                                croppedFile
                            );

                            const imageURL =
                                URL.createObjectURL(blob);

                            const wrapper =
                                document.createElement("div");

                            wrapper.className =
                                "relative w-24 h-24 rounded-xl overflow-hidden border border-gray-200 group new-image-preview";

                            wrapper.innerHTML = `
                <img
                    src="${imageURL}"
                    class="w-full h-full object-cover"
                >

                <button
                    type="button"
                    class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-white"
                    onclick="this.parentElement.remove()"
                >
                    <i data-lucide="trash-2" class="w-5 h-5"></i>
                </button>
            `;

                            currentPreviewContainer
                                .appendChild(wrapper);

                            lucide.createIcons();

                            currentFileIndex++;

                            if (
                                currentFileIndex <
                                currentFiles.length
                            ) {

                                openCropper(
                                    currentFiles[currentFileIndex]
                                );

                            } else {

                                finishCropping();
                            }

                        }, "image/png");
                    }
                );

            function finishCropping() {

                const dataTransfer =
                    new DataTransfer();

                croppedFiles.forEach(file => {

                    dataTransfer.items.add(file);
                });

                currentInput.files =
                    dataTransfer.files;

                cropperModal
                    .classList
                    .add("hidden");

                if (cropper) {
                    cropper.destroy();
                }
            }

            function validateVariantColors() {
    const variantCards = document.querySelectorAll(
        "#variantsContainer > div"
    );

    const colorMap = new Map();
    let isValid = true;

    document.querySelectorAll(".duplicate-color-error")
        .forEach(el => el.remove());

    variantCards.forEach(card => {
        const input = card.querySelector(
            'input[name*="[color]"]'
        );

        if (!input) return;

        const color = input.value.trim().toLowerCase()
            .replace(/\s+/g, " ");

        if (!color) return;

        if (colorMap.has(color)) {
            isValid = false;

            input.classList.add("border-red-500");

            const error = document.createElement("p");
            error.className =
                "text-red-500 text-sm mt-1 duplicate-color-error";
            error.textContent =
                "This color variant already exists.";

            input.parentElement.appendChild(error);

            const firstInput = colorMap.get(color);
            firstInput.classList.add("border-red-500");
        } else {
            colorMap.set(color, input);
            input.classList.remove("border-red-500");
        }
    });

    return isValid;
}
        </script>
</body>

</html>